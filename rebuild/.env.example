# Private local development. Copy to .env, chmod 600, and supply unique values.
QUILLMD_SECRET_KEY=replace-with-a-new-random-secret
QUILLMD_DB_NAME=quillmd_fresh
QUILLMD_DB_USER=quillmd_fresh
QUILLMD_DB_PASSWORD=replace-with-a-new-database-password
QUILLMD_DB_HOST=127.0.0.1
QUILLMD_DB_PORT=55438
QUILLMD_AI_MODE=fixture
QUILLMD_AI_PROVIDER=anthropic
QUILLMD_AI_MODEL=claude-sonnet-5-5
# Sonnet 5.5 configured list rates; not provider invoice reconciliation.
# Live mode requires explicit reviewed provider rates, in USD per million tokens.
# https://platform.claude.com/docs/en/about-claude/pricing
QUILLMD_AI_INPUT_RATE=2
QUILLMD_AI_OUTPUT_RATE=10
QUILLMD_AI_CACHED_RATE=0.20
# Sonnet 5.5 ordinary requests use between_tools thinking, medium effort and the separate 20,000-token profile.
# These settings are read by the application and snapshotted by its worker; fixture mode sends no provider request.
# Inference geography: leave empty (inference_geo is not sent) or `us` (US-only inference, billed 1.1x by Anthropic).
QUILLMD_AI_THINKING=between_tools
QUILLMD_AI_EFFORT=medium
QUILLMD_AI_INFERENCE_GEO=
# Explicit ordinary-field-relations-v4 contract. Source-bound v3 forms use
# claude-sonnet-5-5-ordinary-v1; other forms and historical request snapshots keep their own contracts.
# Configuration is not qualification. Live synthetic use requires the authorized accounts and retained provider
# evidence; private installation also requires the reviewed exact-source CI, migration and preservation gates.
QUILLMD_V3_FIELD_RELATIONS=1
# A protected installed environment is changed only by the reviewed preserving installer. The pure
# ops/ordinary_generation_activation.py builder prepares the bounded model/profile delta without reading any file.
# Check both doctor/admin configuration_status and the worker's persisted job snapshot/provider response afterwards.
# Rollback restores only the prior QUILLMD_AI_PROVIDER, QUILLMD_AI_MODEL, QUILLMD_AI_INPUT_RATE,
# QUILLMD_AI_OUTPUT_RATE, QUILLMD_AI_CACHED_RATE, QUILLMD_AI_THINKING, QUILLMD_AI_EFFORT,
# QUILLMD_AI_INFERENCE_GEO and QUILLMD_V3_FIELD_RELATIONS from the verified private baseline. Keep the current
# compatible release/schema; a model rollback does not authorize an earlier source checkout. Current redaction,
# holds and source-bound mappings must remain supported. Follow the release-specific rollback checks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# https://deepgram.com/pricing — configured prerecorded medical rate, not an account tariff attestation.
QUILLMD_DEEPGRAM_RATE_PER_MINUTE=0.0043
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CPT_LICENSE_ID=
CPT_LICENSE_EXPIRY=
QUILLMD_HTTPS=0
# Account email stays in the private file outbox unless explicitly enabled.
QUILLMD_EMAIL_MODE=file
QUILLMD_APP_BASE_URL=http://127.0.0.1:9130
QUILLMD_EMAIL_FROM=
QUILLMD_EMAIL_VERIFIED_DOMAIN=
QUILLMD_RESEND_ENV_FILE=
RESEND_API_KEY=
# Behind the approved loopback proxy only. The administrator surface honours the proxy header only
# when QUILLMD_HTTPS=1 as well (see docs/rebuild/v1/application-settings.md).
QUILLMD_TRUST_PROXY=0
QUILLMD_PREVIEW_AUTH_ENABLED=0

# V1 application profile — docs/rebuild/v1/application-settings.md. Every default below is the
# private synthetic system exactly as it was; an unrecognised value refuses to start.
# synthetic | real. 'real' refuses to start unless every production-required setting is present and safe.
QUILLMD_DATA_MODE=synthetic
# open | invite. 'invite' closes /register/; staff invite clinic owners from the console.
QUILLMD_REGISTRATION=open
# One-time promotional credit per newly verified account, US dollars in whole cents (0 to 500).
QUILLMD_WELCOME_CREDIT=10
# 0 | 1. 1 requires a confirmed authenticator at every sign-in, for every account.
QUILLMD_MFA_REQUIRED_ALL=0
# test | live. 'live' accepts only sk_live_/rk_live_ keys and livemode=true events.
QUILLMD_STRIPE_MODE=test
# unset | true | false. Deepgram Model Improvement Program opt-out. Unset follows the data mode: synthetic
# sends no mip_opt_out parameter (the request as before V1); real sends true and refuses false.
# Whether Deepgram prices opted-out requests differently is unverified: see the settings document.
QUILLMD_DEEPGRAM_MIP_OPT_OUT=
# false | true. Deepgram smart formatting (digits, punctuation, paragraphs). 'true' for V1.
QUILLMD_DEEPGRAM_SMART_FORMAT=false

# Prepared only: source-bound whole-form generation in at most8 requests of100 fields.
# Requires qualified global-rule coverage and exact native Sonnet5. Keep off until
# endpoint/account, clinical, financial and interruption qualification is complete.
QUILLMD_V3_GENERATION_BATCHES=0

# Disposition requires independently installed signed prospective authority and
# journal/checkpoint keys. No policy or signing material is supplied here.
QUILLMD_DISPOSITION_ENABLED=0
QUILLMD_DISPOSITION_NAMESPACE=
QUILLMD_DISPOSITION_AUTHORITY_KEYS={}
QUILLMD_DISPOSITION_CHECKPOINT_KEYS={}
QUILLMD_DISPOSITION_JOURNAL_KEYS={}
QUILLMD_DISPOSITION_JOURNAL_KEY_ID=
QUILLMD_DISPOSITION_JOURNAL_PRIVATE_KEY=
QUILLMD_DISPOSITION_JOURNAL_PATH=
