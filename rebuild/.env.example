# Private local development. Copy to .env, chmod 600, and supply unique values.
QUILLMD_SECRET_KEY=replace-with-a-new-random-secret
QUILLMD_DB_NAME=quillmd_fresh
QUILLMD_DB_USER=quillmd_fresh
QUILLMD_DB_PASSWORD=replace-with-a-new-database-password
QUILLMD_DB_HOST=127.0.0.1
QUILLMD_DB_PORT=55438
QUILLMD_AI_MODE=fixture
QUILLMD_AI_PROVIDER=anthropic
QUILLMD_AI_MODEL=claude-sonnet-4-6
# Configured public-reference rates, reviewed 2026-09-17; not provider invoice reconciliation.
# Live mode requires explicit reviewed provider rates, in USD per million tokens.
# https://platform.claude.com/docs/en/about-claude/pricing
QUILLMD_AI_INPUT_RATE=3
QUILLMD_AI_OUTPUT_RATE=15
QUILLMD_AI_CACHED_RATE=0.30
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# https://deepgram.com/pricing — configured prerecorded medical rate, not an account tariff attestation.
QUILLMD_DEEPGRAM_RATE_PER_MINUTE=0.0043
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CPT_LICENSE_ID=
CPT_LICENSE_EXPIRY=
QUILLMD_HTTPS=0
# Account email stays in the private file outbox unless explicitly enabled.
QUILLMD_EMAIL_MODE=file
QUILLMD_APP_BASE_URL=http://127.0.0.1:9130
QUILLMD_EMAIL_FROM=
QUILLMD_EMAIL_VERIFIED_DOMAIN=
QUILLMD_RESEND_ENV_FILE=
RESEND_API_KEY=
# Behind the approved loopback proxy only. The administrator surface honours the proxy header only
# when QUILLMD_HTTPS=1 as well (see docs/rebuild/v1/application-settings.md).
QUILLMD_TRUST_PROXY=0
QUILLMD_PREVIEW_AUTH_ENABLED=0

# V1 application profile — docs/rebuild/v1/application-settings.md. Every default below is the
# private synthetic system exactly as it was; an unrecognised value refuses to start.
# synthetic | real. 'real' refuses to start unless every production-required setting is present and safe.
QUILLMD_DATA_MODE=synthetic
# open | invite. 'invite' closes /register/; staff invite clinic owners from the console.
QUILLMD_REGISTRATION=open
# One-time promotional credit per newly verified account, US dollars in whole cents (0 to 500).
QUILLMD_WELCOME_CREDIT=10
# 0 | 1. 1 requires a confirmed authenticator at every sign-in, for every account.
QUILLMD_MFA_REQUIRED_ALL=0
# test | live. 'live' accepts only sk_live_/rk_live_ keys and livemode=true events.
QUILLMD_STRIPE_MODE=test
# true | false. Deepgram Model Improvement Program opt-out, sent on every transcription request.
QUILLMD_DEEPGRAM_MIP_OPT_OUT=true
# false | true. Deepgram smart formatting (digits, punctuation, paragraphs). 'true' for V1.
QUILLMD_DEEPGRAM_SMART_FORMAT=false
