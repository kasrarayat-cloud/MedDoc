[Unit]
Description=QuillMD fresh PostgreSQL container on the encrypted volume
After=docker.service quillmd-fresh-volume.service
Requires=docker.service
BindsTo=quillmd-fresh-volume.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/bin/quillmd-fresh-volume status
ExecStart=/usr/bin/docker start quillmd-fresh-postgres
ExecStartPost=/usr/local/bin/quillmd-fresh-volume wait-database
ExecStop=/usr/bin/docker stop -t 60 quillmd-fresh-postgres

[Install]
WantedBy=multi-user.target
