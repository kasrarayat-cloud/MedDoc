[Unit]
Description=QuillMD fresh private worker
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude
Group=claude
WorkingDirectory=/opt/meddoc-pro/rebuild
Environment=QUILLMD_ADMIN_SITE=0
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/meddoc-pro/rebuild/.venv/bin/python manage.py worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/run/docker.sock /opt/meddoc-pro/.env /opt/meddoc-pro/.retained-service-credentials /opt/meddoc-pro/.worktrees
InaccessiblePaths=/opt/meddoc-pro/rebuild/.runtime/postgres.env /opt/meddoc-pro/rebuild/.runtime/private-access.json
InaccessiblePaths=/opt/meddoc-pro/rebuild/.runtime/db-role-secrets /opt/meddoc-pro/rebuild/.runtime/backup-secrets /opt/meddoc-pro/rebuild/.runtime/new-system-backups /opt/meddoc-pro/rebuild/.runtime/restore-checks
ReadWritePaths=/opt/meddoc-pro/rebuild/.runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1024M
TasksMax=64

[Install]
WantedBy=multi-user.target
