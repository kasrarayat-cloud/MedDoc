[Unit]
Description=QuillMD fresh private worker
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quillmd-app
Group=quillmd-app
SupplementaryGroups=
CapabilityBoundingSet=
AmbientCapabilities=
WorkingDirectory=/opt/meddoc-pro/rebuild
Environment=QUILLMD_ADMIN_SITE=0
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/opt/meddoc-pro/rebuild/.env
ExecStart=/opt/meddoc-pro/rebuild/.venv/bin/python /opt/meddoc-pro/rebuild/ops/service_launcher.py --surface worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1024M
TasksMax=64

InaccessiblePaths=/run/docker.sock /opt/meddoc-pro/.env /opt/meddoc-pro/.retained-service-credentials /opt/meddoc-pro/.worktrees /opt/meddoc-pro/rebuild/.env /opt/meddoc-pro/rebuild/.runtime
ReadWritePaths=/var/lib/quillmd/files /var/lib/quillmd/mail /var/lib/quillmd/proofs

[Install]
WantedBy=multi-user.target
