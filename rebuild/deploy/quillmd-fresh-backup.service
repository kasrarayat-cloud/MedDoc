[Unit]
Description=QuillMD fresh local encrypted backup
Requires=quillmd-fresh-database.service
After=quillmd-fresh-database.service

[Service]
Type=oneshot
User=claude
Group=claude
WorkingDirectory=/opt/meddoc-pro/rebuild
UMask=0077
ExecStart=/opt/meddoc-pro/rebuild/.venv/bin/python -B /opt/meddoc-pro/rebuild/ops/scheduled_backup.py capture
TimeoutStartSec=600
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/meddoc-pro/rebuild/.runtime/new-system-backups /opt/meddoc-pro/rebuild/.runtime/backup-monitor
MemoryMax=2G
MemorySwapMax=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
