[Unit]
# Deliberately NOT ordered before docker.service: only quillmd-fresh-database.service
# starts the QuillMD database container, after this unit, so a slow or failed unlock
# never delays docker or any co-tenant at boot. A missing key file leaves the volume
# closed (fail-closed) until an operator unlocks it with the recovery passphrase.
Description=Open + bind QuillMD fresh encrypted volume (database, state, temp)
After=local-fs.target
RequiresMountsFor=/var/lib/quillmd-encrypted /var/lib/docker /var/lib

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
TimeoutStopSec=120
ExecStart=/usr/local/bin/quillmd-fresh-volume open
ExecStop=/usr/local/bin/quillmd-fresh-volume close

[Install]
WantedBy=multi-user.target
