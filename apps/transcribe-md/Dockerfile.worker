# ============================================================================
# TranscribeMD worker image (T-M4) — BullMQ consumer running src/worker.ts
# ----------------------------------------------------------------------------
# Same multi-stage shape as apps/scribe/Dockerfile.worker: full-deps for
# prisma generate, prod-deps for the runtime, a prisma-generate stage for
# the .prisma client, and a lean runner. No ffmpeg — we don't chunk
# audio in T-M4 (Deepgram batch handles 10h files natively).
#
# Build context: monorepo root (context: . in docker-compose.yml).
# ============================================================================

# PR-K supply-chain hardening: every external base image pinned to a
# specific manifest digest so an upstream `node:22-alpine` rebuild
# can't change the bytes we ship without us reviewing it first.
# Bumps land via Dependabot's docker ecosystem.
#   node:22-alpine — pinned 2026-05-06 (linux/amd64)
ARG NODE_BASE=node@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f

# ── Stage 1: full-deps (needed for prisma generate) ──
FROM ${NODE_BASE} AS full-deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/meddoc-pro/package.json ./apps/meddoc-pro/package.json
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY apps/transcribe-md/package.json ./apps/transcribe-md/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/shared/package.json ./packages/shared/package.json
# ⚠️ npm's DEFAULTS ARE 2 RETRIES AND A 60s CEILING, WHICH A REGISTRY BLIP
# OUTLASTS. On 2026-08-10, after 18 of 18 consecutive green e2e runs, THREE
# independent image builds on three different branches all died inside twelve
# minutes on `npm error code ECONNRESET` / `network aborted` during `npm ci`.
# Zero test failures in any of them — the image simply never built, so the gate
# could not report on the code at all.
#
# Set as NPM_CONFIG_* ON THE STAGE, not as flags on the one command below, so
# any npm invocation added to this stage later inherits it rather than having to
# remember. A per-command flag list is a hand-kept list, and hand-kept lists are
# wrong eventually.
ENV NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000
RUN npm ci

# ── Stage 2: prod-deps (prune dev deps for the runtime layer) ──
FROM ${NODE_BASE} AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/meddoc-pro/package.json ./apps/meddoc-pro/package.json
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY apps/transcribe-md/package.json ./apps/transcribe-md/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/shared/package.json ./packages/shared/package.json
# Registry-blip retry budget — see the note on the first install stage above.
ENV NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000
RUN npm ci --omit=dev

# ── Stage 3: prisma-generate ──
FROM full-deps AS prisma-generate
WORKDIR /app
COPY packages/db/prisma ./packages/db/prisma
COPY packages/db/src ./packages/db/src
COPY packages/db/prisma.config.ts ./packages/db/prisma.config.ts
RUN npm run generate -w @meddoc/db

# ── Stage 4: runtime ──
FROM ${NODE_BASE} AS runner
WORKDIR /app

ENV NODE_ENV=production

# Prod-only node_modules.
COPY --from=prod-deps /app/node_modules ./node_modules
# Generated Prisma client (produced in the full-deps stage).
COPY --from=prisma-generate /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=prisma-generate /app/node_modules/@prisma ./node_modules/@prisma

# Root manifests — tsx + npm workspace resolution need these.
COPY package.json package-lock.json tsconfig.base.json ./

# Worker source. Deliberately omits the .next/ build output and public/
# assets — those belong to the web container.
COPY apps/transcribe-md/package.json ./apps/transcribe-md/package.json
COPY apps/transcribe-md/tsconfig.json ./apps/transcribe-md/tsconfig.json
COPY apps/transcribe-md/src ./apps/transcribe-md/src
# T-M12: ship the scripts/ dir so ops can run `npm run minio:cleanup`
# inside the container (or npx tsx scripts/minio-cleanup.ts). No
# runtime bloat — it's two files totaling a few KB.
COPY apps/transcribe-md/scripts ./apps/transcribe-md/scripts

# Workspace packages the worker imports from.
COPY packages/db/package.json ./packages/db/package.json
COPY packages/db/src ./packages/db/src
COPY packages/db/prisma ./packages/db/prisma
COPY packages/db/prisma.config.ts ./packages/db/prisma.config.ts
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/auth/src ./packages/auth/src
COPY packages/types/package.json ./packages/types/package.json
COPY packages/types/src ./packages/types/src
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/ai/src ./packages/ai/src
# @meddoc/shared/specialties — the worker resolves the specialty catalog
# (isImagingReportSpecialty / ultrasoundSpecialtyEnabled) at runtime via tsx.
# Unlike the Next app it is NOT bundled, so the package.json (for the npm-ci
# workspace symlink) + src must ship in the image.
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/shared/src ./packages/shared/src

# Non-root for defense in depth.
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker
USER worker

WORKDIR /app/apps/transcribe-md
CMD ["npx", "tsx", "src/worker.ts"]
