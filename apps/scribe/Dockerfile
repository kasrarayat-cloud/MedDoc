# ============================================================================
# MedDoc Scribe — Multi-stage Production Dockerfile (monorepo)
# ----------------------------------------------------------------------------
# Build context is the monorepo root — `context: .` in docker-compose.yml.
# Mirrors apps/meddoc-pro/Dockerfile.
# ============================================================================

# ── Stage 1: Dependencies (production only) ──
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/meddoc-pro/package.json ./apps/meddoc-pro/package.json
COPY apps/scribe/package.json ./apps/scribe/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/ai/package.json ./packages/ai/package.json
RUN npm ci --omit=dev

# ── Stage 2: Build ──
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/meddoc-pro/package.json ./apps/meddoc-pro/package.json
COPY apps/scribe/package.json ./apps/scribe/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/ai/package.json ./packages/ai/package.json
RUN npm ci

COPY . .

RUN npm run db:generate

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w scribe

# ── Stage 3: Production Runner ──
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/scribe/public ./public
COPY --from=builder /app/apps/scribe/.next/standalone ./
COPY --from=builder /app/apps/scribe/.next/static ./apps/scribe/.next/static

COPY --from=builder /app/packages/db/prisma ./packages/db/prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/scribe/server.js"]
