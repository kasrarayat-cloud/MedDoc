# ============================================================================
# Scribe worker image — BullMQ consumer running src/worker.ts via tsx
# ----------------------------------------------------------------------------
# M7 slim rewrite: was 2.1 GB (full monorepo COPY + all deps). Now uses
# multi-stage with prod-only deps + selective COPY of only the source
# paths the worker actually imports at runtime.
#
# Excluded vs the old image:
#   - apps/meddoc-pro/** (worker never imports it)
#   - apps/scribe/tests, apps/scribe/.next, apps/scribe/node_modules
#   - playwright-report/, test-results/, venv/
#   - root node_modules dev deps (next, next-auth UI, playwright, vitest…)
#
# Build context: monorepo root (context: . in docker-compose.yml).
# Target: <400 MB. Report `docker images | grep scribe-worker` after build.
# ============================================================================

# ── Stage 1: full-deps (needed for prisma generate) ──
FROM node:22-alpine AS full-deps
WORKDIR /app
RUN apk add --no-cache ffmpeg
COPY package.json package-lock.json ./
COPY apps/meddoc-pro/package.json ./apps/meddoc-pro/package.json
COPY apps/scribe/package.json ./apps/scribe/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/ai/package.json ./packages/ai/package.json
RUN npm ci

# ── Stage 2: prod-deps (prune dev deps for the runtime layer) ──
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/meddoc-pro/package.json ./apps/meddoc-pro/package.json
COPY apps/scribe/package.json ./apps/scribe/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/ai/package.json ./packages/ai/package.json
RUN npm ci --omit=dev

# ── Stage 3: prisma-generate ──
FROM full-deps AS prisma-generate
WORKDIR /app
COPY packages/db/prisma ./packages/db/prisma
COPY packages/db/src ./packages/db/src
COPY packages/db/prisma.config.ts ./packages/db/prisma.config.ts
RUN npm run generate -w @meddoc/db

# ── Stage 4: runtime ──
FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache ffmpeg

ENV NODE_ENV=production

# Prod-only node_modules (M7 — cut dev deps = huge shrink).
COPY --from=prod-deps /app/node_modules ./node_modules
# Generated Prisma client (produced in the full-deps stage).
COPY --from=prisma-generate /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=prisma-generate /app/node_modules/@prisma ./node_modules/@prisma

# Root manifests — tsx resolves workspace paths via these.
COPY package.json package-lock.json tsconfig.base.json ./

# Worker source + prompts + specialties + scripts.
# tests/evals is intentionally NOT copied (user-confirmed M7 D6).
COPY apps/scribe/package.json ./apps/scribe/package.json
COPY apps/scribe/tsconfig.json ./apps/scribe/tsconfig.json
COPY apps/scribe/src ./apps/scribe/src
COPY apps/scribe/scripts ./apps/scribe/scripts
COPY apps/scribe/specialties ./apps/scribe/specialties
COPY apps/scribe/sentry.server.config.ts ./apps/scribe/sentry.server.config.ts

# Workspace packages — source + package.json (worker imports via @meddoc/*).
COPY packages/db/package.json ./packages/db/package.json
COPY packages/db/src ./packages/db/src
COPY packages/db/prisma ./packages/db/prisma
COPY packages/db/prisma.config.ts ./packages/db/prisma.config.ts
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/auth/src ./packages/auth/src
COPY packages/types/package.json ./packages/types/package.json
COPY packages/types/src ./packages/types/src
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/ai/src ./packages/ai/src

# Non-root user for defense in depth.
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker
USER worker

CMD ["npx", "tsx", "apps/scribe/src/worker.ts"]
