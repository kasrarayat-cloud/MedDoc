# ============================================================================
# Scribe worker image — BullMQ consumer running src/worker.ts via tsx
# ----------------------------------------------------------------------------
# Separate from the web Dockerfile because the worker needs ffmpeg (for
# audio chunking at 25 min) and tsx at runtime (no Next standalone output
# for the worker entrypoint). Build context is the monorepo root, same
# as the other Dockerfiles.
# ============================================================================

FROM node:22-alpine AS deps
WORKDIR /app
# ffmpeg handles chunking / re-encoding of uploaded audio. alpine package
# is ~80 MB — acceptable cost per M2 plan decision D3.
RUN apk add --no-cache ffmpeg
COPY package.json package-lock.json ./
COPY apps/meddoc-pro/package.json ./apps/meddoc-pro/package.json
COPY apps/scribe/package.json ./apps/scribe/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/ai/package.json ./packages/ai/package.json
# Worker runs from source via tsx → needs full deps (no --omit=dev).
RUN npm ci

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache ffmpeg

ENV NODE_ENV=production

# Bring the whole workspace — tsx resolves imports from source paths,
# and the worker touches apps/scribe/src/**, packages/**/src/**.
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Prisma client (generated into node_modules/@prisma/client by db package).
RUN npm run db:generate

# Non-root for defense in depth.
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker
USER worker

CMD ["npx", "tsx", "apps/scribe/src/worker.ts"]
