{
  "schema": "cpt-studio-customer-denylist@1",
  "about": "What a customer surface must never carry (owner directive 2026-11-03, section 2; CORE-UX-DESIGN.md section 0.6): provider and model identities, usage/token/credit fields, request/response ids and sha256-like hex, trace links, retrieval logs, rule ids and orchestration machinery. One list, read by ops/verify_browser.cjs (the walk), ops/verify_downloads.py (every customer download) and ops/scan_customer.py (every customer endpoint); the vectors below are run by the tests of all three, so the readers cannot drift apart. Patterns are matched case-insensitively and ASCII-only (JavaScript 'gi' without 'u'; Python re.ASCII | re.IGNORECASE), after every 'allowed' string is removed. A string that is a substring of the encounter's own document text is a quotation of the document and is not scanned (a synthetic patient may be named anything); downloads and bundles are scanned whole. Severity 'soft' records a warning (clinical wording can use the word); 'hard' fails the check.",
  "surfaces": {
    "dom": "the customer page: every visible or hidden text node, the attributes aria-*, data-*, title, alt, placeholder, value, label, href, src, action and download, the document title, toasts and error text",
    "json": "every customer API JSON body: its string values and its keys",
    "header": "every customer API response header value",
    "file": "every customer download (report TXT and CSV), whole",
    "bundle": "the served customer page HTML and every same-origin script and stylesheet it loads, whole (code identifiers such as a CSRF token or a request id variable are not wording, so the wording-only patterns skip it)"
  },
  "allowed": ["cpt-studio-customer-report@1", "cpt.quillmd.com"],
  "patterns": [
    {"id": "provider_name", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\b(?:corti|astra|fable|openai|anthropic|claude|gemini|google)\\b"},
    {"id": "model_id", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\b(?:gpt|claude|gemini)-[a-z0-9]"},
    {"id": "interpreter_model", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\bgemini-4-argon\\b"},
    {"id": "adapter_version", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "@cptstudio-\\d|\\bcpt-studio:[a-z]"},
    {"id": "versioned_id", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\b[a-z][a-z0-9]*[._-][a-z_][a-z0-9_]*@\\d+\\b"},
    {"id": "long_hex", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "(?<![0-9a-f])[0-9a-f]{32,}(?![0-9a-f])"},
    {"id": "vendor_id", "severity": "hard", "surfaces": ["dom", "json", "header", "file"],
     "source": "\\b(?:req|resp|msg|call|chatcmpl|toolu)[_-][a-z0-9]{6,}"},
    {"id": "rule_id", "severity": "hard", "surfaces": ["dom", "json", "header", "file"],
     "source": "\\b(?:provider|participants?|services?|evidence|pfs|mue|cpt|ncci|scope|routing|facts|context|extraction|reference|peer|harness)\\.[a-z_]{2,}\\b"},
    {"id": "rule_id_word", "severity": "hard", "surfaces": ["dom", "json", "header", "file"],
     "source": "\\brule[ _-]?ids?\\b"},
    {"id": "peer_review", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\bpeer[ _-]?reviews?\\b"},
    {"id": "participant", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\bparticipants?\\b"},
    {"id": "vendor", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\bvendors?\\b"},
    {"id": "token", "severity": "hard", "surfaces": ["dom", "json", "header", "file"],
     "source": "\\btokens?\\b"},
    {"id": "credit", "severity": "hard", "surfaces": ["dom", "json", "header", "file"],
     "source": "\\bcredits?\\b"},
    {"id": "trace", "severity": "hard", "surfaces": ["dom", "json", "header", "file"],
     "source": "\\b(?:traces?|traceback)\\b"},
    {"id": "trace_link", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "#trace\\b|/trace\\b"},
    {"id": "operator_url", "severity": "hard", "surfaces": ["dom", "json", "file", "bundle"],
     "source": "/ops/"},
    {"id": "sha256", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\bsha-?256\\b"},
    {"id": "tool_call", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\btool[ _-]?(?:calls?|loops?|use)\\b"},
    {"id": "request_id", "severity": "hard", "surfaces": ["dom", "json", "header", "file"],
     "source": "\\b(?:request|response)[ _-]?ids?\\b"},
    {"id": "estimated_cost", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\bestimated[ _-]?costs?\\b|\\bcost[ _-]?usd\\b"},
    {"id": "latency", "severity": "hard", "surfaces": ["dom", "json", "header", "file"],
     "source": "\\blatency(?:[ _-]?ms)?\\b"},
    {"id": "http_status", "severity": "hard", "surfaces": ["dom", "json", "file", "bundle"],
     "source": "\\bHTTP\\s?\\d{3}\\b"},
    {"id": "endpoint", "severity": "hard", "surfaces": ["dom", "json", "file"],
     "source": "\\bendpoints?\\b"},
    {"id": "replay", "severity": "hard", "surfaces": ["dom", "json", "file"],
     "source": "\\breplay(?:ed|s)?\\b"},
    {"id": "provider_machinery", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\bprovider[ _-](?:runs?|modes?|responses?|requests?|usage|calls?|errors?|names?|outcomes?|results?|locks?)\\b"},
    {"id": "model_words", "severity": "hard", "surfaces": ["dom", "json", "header", "file", "bundle"],
     "source": "\\bmodels?[ _-](?:requested|answered|ids?|names?)\\b|\\b(?:requested|returned)[ _-]models?\\b"},
    {"id": "orchestration", "severity": "hard", "surfaces": ["dom", "json", "file", "bundle"],
     "source": "\\b(?:orchestrat[a-z]*|harness|adapters?)\\b"},
    {"id": "provider_word", "severity": "soft", "surfaces": ["dom", "json", "file"],
     "source": "\\bproviders?\\b"},
    {"id": "exchange_word", "severity": "soft", "surfaces": ["dom", "json", "file"],
     "source": "\\bexchanges?\\b"}
  ],
  "forbidden_keys": [
    "vendor", "model", "models", "requested_model", "returned_model", "usage", "usage_basis", "estimated_cost_usd",
    "cost", "request_sha256", "response_sha256", "sha256", "text_sha256", "snapshot_sha256", "provider", "providers",
    "provider_runs", "provider_mode", "release", "harness", "participants", "participant", "peer", "peers",
    "peer_review", "peer_references", "references", "run", "runs", "run_id", "state_run", "second_run", "trace",
    "trace_url", "endpoint", "request_id", "response_id", "provider_request_id", "authorization_ref", "run_identity",
    "adapter_version", "tool_calls", "exchanges", "retrieval", "reference_sources", "reference_validation",
    "reference_check", "engine_version", "profiles_version", "profile_version", "routing", "cues", "fingerprint",
    "credits", "tokens", "proposed_by", "listed_by", "corti_relation", "participant_positions", "phases", "rationale",
    "exclusion_reason", "support", "encounter_checks", "latency_ms", "http_status", "scope_items", "purpose",
    "reused_from", "reconciled", "source_file", "username", "interpretation", "interpreter", "event_inventory",
    "inventory", "inventory_sha256", "gemini_run", "sentinel", "legacy_calls", "derived_from"
  ],
  "deny_value_min_length": 8,
  "deny_value_shape": "[0-9._:@/-]",
  "deny_value_paths": {
    "encounter": [
      "provider_runs[].id", "provider_runs[].request_sha256", "provider_runs[].response_sha256",
      "provider_runs[].requested_model", "provider_runs[].returned_model", "state_run",
      "harness.participants[].model", "harness.participants[].returned_model", "harness.participants[].run_id",
      "harness.participants[].peer.run_id",
      "revision.id", "revision.text_sha256", "revision.source_file.sha256", "revision.extraction.engine",
      "assessment.id", "assessment.engine_version", "assessment.profiles_version", "assessment.second_run",
      "assessment.proposals[].profile_version", "assessment.proposals[].checks[].id",
      "assessment.proposals[].checks[].source", "assessment.encounter_checks[].id",
      "assessment.encounter_checks[].source", "assessment.reference_sources[].key",
      "assessment.reference_sources[].sha256", "assessment.reference_sources[].url", "reports[].sha256",
      "routing.version",
      "assessment.interpretation.engine_version", "assessment.interpretation.record.interpretation_version",
      "assessment.interpretation.record.inventory_version", "assessment.interpretation.record.inventory.id",
      "assessment.interpretation.record.inventory.sha256", "assessment.interpretation.record.gemini_run",
      "assessment.interpretation.record.context", "assessment.interpretation.inventory.id",
      "assessment.interpretation.inventory.sha256", "assessment.interpretation.inventory.text_sha256",
      "assessment.interpretation.inventory.request_sha256", "assessment.interpretation.inventory.response_sha256",
      "assessment.interpretation.run.id", "assessment.interpretation.run.request_sha256",
      "assessment.interpretation.run.response_sha256", "assessment.interpretation.run.requested_model",
      "assessment.interpretation.run.returned_model", "assessment.interpretation.run.adapter_version",
      "routing.inventory", "routing.inventory_sha256"
    ],
    "trace": [
      "participants[].runs[].id", "participants[].runs[].run_identity", "participants[].runs[].authorization_ref",
      "participants[].runs[].endpoint", "participants[].runs[].adapter_version", "participants[].runs[].request_id",
      "participants[].runs[].response_id", "participants[].runs[].requested_model",
      "participants[].runs[].returned_model", "participants[].runs[].request_sha256",
      "participants[].runs[].response_sha256", "participants[].runs[].exchanges[].provider_request_id",
      "participants[].runs[].exchanges[].response_id", "participants[].runs[].exchanges[].request_sha256",
      "participants[].runs[].exchanges[].response_sha256",
      "participants[].runs[].exchanges[].tool_calls[].call_id",
      "participants[].runs[].exchanges[].tool_calls[].result_sha256", "assessments[].id", "assessments[].frozen[].1",
      "revision.id", "revision.text_sha256",
      "interpretation.engine_version", "interpretation.record.gemini_run", "interpretation.inventory.id",
      "interpretation.inventory.sha256", "interpretation.inventory.request_sha256",
      "interpretation.inventory.response_sha256", "interpretation.run.id", "interpretation.run.request_sha256",
      "interpretation.run.response_sha256", "interpretation.run.requested_model", "interpretation.run.returned_model",
      "interpretation.run.adapter_version"
    ]
  },
  "vectors_note": "hits: the sorted, de-duplicated pattern ids a scan of text on that surface must find (deny values and forbidden keys aside); [] for none.",
