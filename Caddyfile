# ============================================================================
# MedDoc Pro — Caddy Reverse Proxy
# ----------------------------------------------------------------------------
# T-M19 (2026-04-21): cut over from MODE A (plaintext, IP-based) to MODE B
# (HTTPS, domain-based). Live hostnames:
#
#   quillmd.com + www.quillmd.com  →  marketing  (port 3010 internal)
#   app.quillmd.com                →  TranscribeMD (port 3011 internal)
#   pro.quillmd.com                →  MedDoc Pro CRM (port 3000 internal)
#
# Caddy auto-provisions + auto-renews Let's Encrypt certs for each hostname
# (persisted in the `caddy_data` volume). HTTP→HTTPS redirect is automatic
# once a hostname is configured.
#
# The MODE A blocks are kept below as commented rollback reference. DO NOT
# uncomment them while MODE B is active: the MODE B HSTS header
# (max-age=31536000; includeSubDomains) tells every client that has hit us
# to refuse plaintext for up to a year. Safe-rollback procedure is:
#   1. Serve `Strict-Transport-Security: max-age=0` over HTTPS first
#   2. Wait for clients to re-fetch and clear their cache
#   3. Then flip back to MODE A
# ============================================================================

# ─── Runtime request-error log policy ──────────────────────────────────────────
# Access-log encoders are configured per site below. The default runtime
# logger can also emit a request URI when an upstream fails, so it repeats the
# same query filter instead of becoming a credential-bearing error-log bypass.
{
    # Public TLS terminates at the host nginx and reaches this container only
    # through its loopback-bound :8443 listener. The published-port hop enters
    # through the deterministic quillmd_ingress gateway; no application peer
    # is trusted as a proxy. Resolve the client chain from right to left so a
    # caller-supplied X-Forwarded-For value cannot become auth authority.
    servers {
        trusted_proxies static 172.31.252.1/32
        client_ip_headers X-Forwarded-For X-Real-IP
        trusted_proxies_strict
    }

    log default {
        format filter {
            request>headers>Referer delete
            request>uri query {
                replace token REDACTED
                replace code REDACTED
                replace state REDACTED
                replace id_token REDACTED
                replace access_token REDACTED
                replace refresh_token REDACTED
                replace secret REDACTED
                replace password REDACTED
                replace otp REDACTED
                replace api_key REDACTED
                replace apiKey REDACTED
                replace auth REDACTED
                replace authorization REDACTED
                replace credential REDACTED
                replace csrf REDACTED
                replace session REDACTED
                replace session_token REDACTED
                replace verification_token REDACTED
                replace reset_token REDACTED
                replace mfa_code REDACTED
                replace totp REDACTED
                replace recovery_code REDACTED
            }
            wrap json
        }
    }
}

# ─── Shared access-log policy ───────────────────────────────────────────────────
# Preserve path and parameter names for operations while replacing credential-
# like query values before encoding. Caddy already redacts sensitive headers;
# this filter closes the equivalent URL-query gap for every site logger.
(redacted_access_log) {
    log {
        output stdout
        format filter {
            request>headers>Referer delete
            request>uri query {
                replace token REDACTED
                replace code REDACTED
                replace state REDACTED
                replace id_token REDACTED
                replace access_token REDACTED
                replace refresh_token REDACTED
                replace secret REDACTED
                replace password REDACTED
                replace otp REDACTED
                replace api_key REDACTED
                replace apiKey REDACTED
                replace auth REDACTED
                replace authorization REDACTED
                replace credential REDACTED
                replace csrf REDACTED
                replace session REDACTED
                replace session_token REDACTED
                replace verification_token REDACTED
                replace reset_token REDACTED
                replace mfa_code REDACTED
                replace totp REDACTED
                replace recovery_code REDACTED
            }
            wrap console
        }
    }
}

# ─── Shared header snippet — MODE A (plaintext-safe) ──────────────────────
# Kept so the rollback commented block below still parses. No active block
# currently imports it.
(security_headers_mode_a) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
        -Server
    }
}

# ─── Shared header snippet — MODE B (HTTPS-only) ──────────────────────────
# Imported from every active domain block below. Adds HSTS + enforced CSP
# on top of the MODE A subset. Phase 19 (h16-csp-report-only): switched
# from Content-Security-Policy-Report-Only to enforced after the burn-in
# window from Phases 13-17 produced zero CSP violation reports.
# 'unsafe-inline' + 'unsafe-eval' are both required by Next 16 + Tailwind
# inline emission.
(security_headers_mode_b) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none';"
        -Content-Security-Policy-Report-Only
        -Server
    }
}

# Bearer-link pages use their query credential only to build a same-origin
# POST body. They never need to emit the credential-bearing GET URL as a
# Referer. Import this on every host that exposes account recovery.
(auth_bearer_link_headers) {
    @authBearerLink path /reset-password /api/auth/verify-email /api/auth/confirm-email
    header @authBearerLink Referrer-Policy "no-referrer"
}

# ==========================================================================
# MODE B — active
# ==========================================================================

# ─── quillmd.com + www.quillmd.com — Marketing site ───────────────────────
# Apex + www both served from the same block so visitors land on the same
# content regardless of whether they type the `www.` prefix. Caddy auto-
# issues separate certs for each hostname.
quillmd.com, www.quillmd.com {
    import redacted_access_log

    import security_headers_mode_b

    reverse_proxy marketing:3010 {
        header_up Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ─── app.quillmd.com — TranscribeMD (pilot doctors log in here) ───────────
app.quillmd.com {
    import redacted_access_log

    import security_headers_mode_b
    import auth_bearer_link_headers

    # The physician host and platform-admin host share one Next.js process,
    # but not one authorization surface. Refuse admin pages and APIs before a
    # request can reach the application. The app repeats this check using the
    # accepted Host value for direct-container defense.
    @appAdminSurface path /admin /admin/* /api/admin /api/admin/*
    handle @appAdminSurface {
        respond "Not Found" 404
    }

    handle {
        reverse_proxy transcribe-md:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# ─── admin.quillmd.com — Platform admin dashboard (SUPER_ADMIN only) ──────
# Authentication and the exact practice-scoped static-asset workflow use the
# route-denied `template-twin-admin-app` process. Exact release-control paths
# use `template-twin-admin-control`. Broad legacy platform-admin pages and APIs
# are retired at the edge; no admin-host request is routed to the physician
# process. Caddy and each process repeat the boundary so a direct-container or
# future proxy misroute fails closed.
#
# Cookie posture: host-only. A user logged in to app.quillmd.com (a
# clinician) does NOT auto-inherit a session here — admin requires its
# own sign-in. AUTH_COOKIE_DOMAIN stays unset to keep the cookie
# isolated per host. Security > UX for the admin surface.
#
# DNS: an A-record for admin.quillmd.com → this VPS must exist before
# Caddy can issue the Let's Encrypt cert (HTTP-01 validation). Until
# then this block still parses + Caddy serves on port 80 → 308 redirect
# to HTTPS, but the HTTPS handshake will use a fallback cert (curl -k
# tests work; browsers refuse).
admin.quillmd.com {
    import redacted_access_log

    import security_headers_mode_b
    import auth_bearer_link_headers

    # ── Allowlist: platform admin plus exact practice-admin workflow ─
    # The first version of this block proxied EVERY path to the
    # transcribe-md upstream and only rewrote `/`. That meant a logged-
    # in clinician on admin.quillmd.com could navigate to /dashboard,
    # /patients, /visits, /settings, etc. and see the regular Transcribe-MD
    # UI on the admin host — wrong, and a privacy footgun. We now match
    # explicit allowlisted paths and 404 everything else.

    # NextAuth (csrf, session, callback) — pass through verbatim. This
    # MUST come before /api/admin/* because Caddy evaluates handle
    # matchers in declaration order; if /api/auth/* fell into the
    # /api/admin/* bucket it would 404.
    @auth path /api/auth/*
    handle @auth {
        reverse_proxy template-twin-admin-app:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # MFA recovery/enrollment is the sole physician-settings capability on the
    # admin host. A valid SUPER_ADMIN without MFA is routed here before any
    # administrative page can render.
    @mfaApi path /api/mfa/enroll /api/mfa/verify-enrollment /api/mfa/recovery-codes/rotate
    handle @mfaApi {
        reverse_proxy template-twin-admin-app:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Template Twin release mutations run in the isolated control-plane
    # process. The ordinary physician/admin application does not receive the
    # release-control database credential. Keep these exact routes ahead of
    # the explicit legacy-admin deny rules below.
    @templateTwinControlApi path /api/admin/template-twin/releases /api/admin/template-twin/releases/* /api/admin/template-twin/release-metrics /api/admin/template-twin/release-metrics/*
    handle @templateTwinControlApi {
        reverse_proxy template-twin-admin-control:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Practice-scoped reusable-image management uses a distinct admin cookie
    # process with the ordinary runtime principal and provider credential. It
    # never receives release-control authority. Keep this exact matcher after
    # the control-plane matcher and before the legacy-admin API deny rule.
    @templateTwinStaticAssetApi path /api/note-templates/template-twin/static-assets
    handle @templateTwinStaticAssetApi {
        reverse_proxy template-twin-admin-app:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # The audited rollback fence remains an exact emergency operation on the
    # isolated admin-app process. Its transaction re-verifies the current
    # SUPER_ADMIN session, complete MFA, active practice, and entitlement under
    # lock. No other legacy /api/admin route reaches this runtime principal.
    @templateTwinRollbackApi path /api/admin/template-twin/rollback
    handle @templateTwinRollbackApi {
        reverse_proxy template-twin-admin-app:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # The historical platform-admin API surface has not passed the isolated
    # process and exact-head authority review. Retire it explicitly rather than
    # falling through to the physician application. Reviewed Template Twin
    # control endpoints above remain reachable because handles are exclusive
    # and ordered.
    @retiredLegacyAdminApi path /api/admin /api/admin/*
    handle @retiredLegacyAdminApi {
        respond "Not Found" 404
    }

    # Next.js asset bundles + static files (icons, fonts). Keep these on the
    # same immutable admin-app image as the pages so rolling replacement cannot
    # mix physician-build assets with admin-build HTML.
    @nextStatic path /_next/static/* /favicon.ico /favicon.svg /robots.txt /manifest.webmanifest
    handle @nextStatic {
        reverse_proxy template-twin-admin-app:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Auth-flow pages a SUPER_ADMIN might genuinely use (sign-in,
    # password recovery). /signup is intentionally not allowed —
    # super-admins are provisioned out-of-band, never via self-service.
    @authPages path /login /forgot-password /reset-password /check-email
    handle @authPages {
        reverse_proxy template-twin-admin-app:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    @mfaPage path /settings/security/mfa
    handle @mfaPage {
        reverse_proxy template-twin-admin-app:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    @templateTwinControlPage path /admin/template-twin-release /admin/template-twin-release/*
    handle @templateTwinControlPage {
        reverse_proxy template-twin-admin-control:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    @templateTwinStaticAssetPage path /settings/note-format/static-assets
    handle @templateTwinStaticAssetPage {
        reverse_proxy template-twin-admin-app:3011 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # The corresponding legacy pages, including bare `/admin`, are retired.
    # The reviewed workbench matcher above remains the only public `/admin/*`
    # page. The bare host root now reaches the catch-all 404 instead of being
    # rewritten into the retired dashboard.
    @retiredLegacyAdminPage path /admin /admin/*
    handle @retiredLegacyAdminPage {
        respond "Not Found" 404
    }

    # Anything else (e.g. /dashboard, /patients, /visits, /settings,
    # /signup) — 404 at the edge. Belt-and-braces alongside the strict
    # allowlist above; the catch-all guarantees that adding a new
    # transcribe-md route doesn't accidentally surface it on the
    # admin host.
    handle {
        respond "Not Found" 404
    }
}

# ─── pro.quillmd.com — MedDoc Pro CRM (internal admin) ────────────────────
pro.quillmd.com {
    import redacted_access_log

    import security_headers_mode_b

    # Defense-in-depth carried over from the MODE A :80 block. The
    # /api/internal/* endpoints are service-to-service (scribe →
    # meddoc-pro) authenticated by shared token + IP allowlist at the
    # app layer; Caddy 404s the path at the edge so external probes
    # can't even reach the handler.
    @internal path /api/internal/*
    respond @internal 404

    reverse_proxy meddoc-pro:3000 {
        header_up Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
}

