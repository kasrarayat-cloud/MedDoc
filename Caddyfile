# ============================================================================
# MedDoc Pro — Caddy Reverse Proxy
# ----------------------------------------------------------------------------
# Terminates inbound traffic and forwards to the Next.js `app` service on the
# internal Docker network. Sets X-Forwarded-For / X-Real-IP / X-Forwarded-Proto
# so the Node runtime reads the real client IP and scheme via
# getRequestContext() in src/lib/auth.ts.
#
# TWO MODES BELOW — the IP block is active by default. When you have DNS:
#   1. Point an A record for your domain (e.g. meddoc.example.com) at this VPS
#   2. Uncomment the domain block below
#   3. Comment out or delete the :80 block
#   4. Update AUTH_URL in docker-compose.yml to https://your-domain
#   5. `docker compose up -d --force-recreate caddy app`
#
# Caddy auto-provisions a Let's Encrypt cert on first request to the domain
# (persisted in the `caddy_data` volume). HTTP→HTTPS redirect is automatic
# when a hostname is configured.
# ============================================================================

# ─── MODE A: IP-based, no TLS (current) ───────────────────────────────────
# Active until you set up DNS. Plaintext — do NOT ship real patient data
# to this until the domain block is turned on.
#
# In M1 we added a `scribe.<host>` sibling block for MedDoc Scribe so the
# two apps live on the same node. Host-based match runs first; the raw
# `:80` block is the catch-all that still points at meddoc-pro.

# Scribe subdomain — dev via scribe.localhost, prod uncomment the domain
# block below alongside meddoc's domain block.
http://scribe.localhost {
    log {
        output stdout
        format console
    }

    # M3: WS upgrade path → scribe-ws sidecar. Caddy's reverse_proxy
    # forwards the Upgrade/Connection headers automatically; the path
    # matcher runs before the catch-all to scribe:3000 below.
    @ws path /api/ws/*
    reverse_proxy @ws scribe-ws:3003 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy scribe:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ─── :9010 — TranscribeMD Marketing (T-M1) ────────────────────────────────
# Standalone marketing site for the new product. Plaintext on the VPS
# public IP until DNS + HTTPS are in place. No patient data of any kind
# flows here — it's a static landing site. Exposed specifically so the
# author can preview the live build without an SSH tunnel.
# Port 9001 was already taken by MinIO's web console — 9010 is the
# next unused slot in the public-port range.
:9010 {
    log {
        output stdout
        format console
    }

    reverse_proxy marketing:3010 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ─── :9020 — TranscribeMD Solo app (T-M2) ────────────────────────────────
# The actual product — where doctors sign up and use the service.
# Plaintext on the VPS public IP until DNS + HTTPS are in place.
# Cookies ride through Caddy with Forwarded-* so NextAuth's host-matching
# lands on the same origin the browser sees.
:9020 {
    log {
        output stdout
        format console
    }

    reverse_proxy transcribe-md:3011 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ─── :8080 — Scribe on the public IP (author-only preview) ─────────────────
# Same shape as the scribe.localhost block: WS upgrade path → scribe-ws,
# catch-all → scribe. Exposed on the VPS public IP so Scribe can be
# reviewed in a browser without an SSH tunnel. Plaintext — do NOT route
# real patient data through this until the domain + HTTPS + BAAs + full
# clinical review are in place (see docs/BAA_CHECKLIST.md).
:8080 {
    log {
        output stdout
        format console
    }

    @ws path /api/ws/*
    reverse_proxy @ws scribe-ws:3003 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy scribe:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Everything else on :80 → meddoc-pro.
:80 {
    log {
        output stdout
        format console
    }

    # Never proxy /api/internal/* externally — it's service-to-service
    # only (scribe → meddoc-pro), authenticated by the shared token +
    # IP allowlist. Caddy returning 404 here is defense in depth on top
    # of the app-layer rejection in apps/meddoc-pro/src/lib/internal-auth.ts.
    @internal path /api/internal/*
    respond @internal 404

    reverse_proxy meddoc-pro:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ─── MODE B: Domain-based, auto-TLS (uncomment when DNS is ready) ─────────
# Replace `meddoc.example.com` with your actual domain. Caddy will obtain
# and auto-renew a Let's Encrypt cert, and serve HTTPS with HSTS.
#
# meddoc.example.com {
#     log {
#         output stdout
#         format console
#     }
#
#     # HSTS: require HTTPS for all subsequent requests for 1 year.
#     # Only turn on after you've confirmed the cert works — an HSTS
#     # mistake with a bad cert will lock clients out of the site.
#     header Strict-Transport-Security "max-age=31536000; includeSubDomains"
#
#     # Sensible security headers for a clinical SaaS. Adjust CSP once you
#     # know the exact list of external resources your UI loads.
#     header X-Content-Type-Options "nosniff"
#     header X-Frame-Options "DENY"
#     header Referrer-Policy "strict-origin-when-cross-origin"
#     header Permissions-Policy "microphone=(self), camera=(), geolocation=()"
#
#     reverse_proxy meddoc-pro:3000 {
#         header_up Host {host}
#         header_up X-Real-IP {remote_host}
#         header_up X-Forwarded-For {remote_host}
#         header_up X-Forwarded-Proto {scheme}
#     }
# }
