    "ws": "^8.21.0",
    "vite": "^8.0.16",
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    },
    "undici": "^7.29.0",
    "js-yaml": "^4.3.1",
    "deepmerge-ts": "^8.0.1",
    "fast-uri": "^3.1.6"
