{
  "name": "meddoc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath scripts/hooks 2>/dev/null || true",
    "dev": "npm run dev -w meddoc-pro",
    "build": "npm run build -w meddoc-pro",
    "start": "npm run start -w meddoc-pro",
    "lint": "npm run lint -w meddoc-pro",
    "test:unit": "npm run test:unit -w meddoc-pro",
    "test:unit:watch": "npm run test:unit:watch -w meddoc-pro",
    "test:e2e": "npm run test:e2e -w meddoc-pro",
    "test:e2e:ui": "npm run test:e2e:ui -w meddoc-pro",
    "test:e2e:transcribe-md": "npm run test:e2e -w transcribe-md",
    "test:e2e:transcribe-md:install": "npm run test:e2e:install -w transcribe-md",
    "test:all": "npm run test:all -w meddoc-pro",
    "seed:e2e": "npm run seed:e2e -w meddoc-pro",
    "seed:e2e-admin": "npm run seed:e2e-admin -w meddoc-pro",
    "eval:doc-editor": "npm run eval:doc-editor -w meddoc-pro",
    "eval:clinical-notes": "npm run eval:clinical-notes -w meddoc-pro",
    "db:generate": "npm run generate -w @meddoc/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @meddoc/db",
    "db:migrate:status": "npm run migrate:status -w @meddoc/db",
    "db:migrate:dev": "npm run migrate:dev -w @meddoc/db"
  },
  "devDependencies": {
    "dotenv": "^17.4.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "vite": "^8.0.16",
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    },
    "@prisma/dev": {
      "find-my-way": "^9.7.0"
    }
  }
}
