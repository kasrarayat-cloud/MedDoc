// ============================================================================
// MedDoc Pro — HIPAA-Compliant Healthcare CRM Schema
// ----------------------------------------------------------------------------
// Design principles:
//  1. Minimize PHI stored in our DB — treat DrChrono as source of truth
//  2. Every sensitive read/write MUST create an AuditLog row
//  3. All IDs use cuid() for unguessable, URL-safe, sortable identifiers
//  4. Timestamps are UTC (@db.Timestamptz) for proper timezone handling
//  5. Documents point to Dropbox — we never store raw PHI files in PostgreSQL
//  6. Soft delete (deletedAt) for auditability — records are never hard-deleted
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  // T-M14.1: pgvector extension for doctor_edit_patterns.embedding.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // T-M14.1: declares `CREATE EXTENSION vector` so prisma migrate
  // resolves the extension reference used by doctor_edit_patterns.
  extensions = [vector]
}

// ============================================================================
// ENUMS
// ============================================================================

/// Role-based access control (RBAC)
/// - DOCTOR: full clinical access (view/edit patient notes, generate docs)
/// - ADMIN:  user management, audit log access, billing, no direct clinical edits
/// - STAFF:  scheduling, intake, limited PHI access
/// The member's role WITHIN a practice — TEAMS T6, ruled 2026-08-06.
///
/// ⚠️ A SEPARATE ENUM FROM `UserRole`, DELIBERATELY. `UserRole` mixes a clinical
/// distinction with a platform-privilege one and has no way to say "owns this
/// practice"; adding values to it would deepen that conflation rather than fix
/// it. Two axes, two enums, and the legacy one is marked do-not-extend.
enum PracticeRole {
  /// Signs, and administers the practice. The backfill's only output.
  OWNER
  /// Signs. May act on any UNSIGNED visit in the practice (SPEC §4.1a).
  CLINICIAN
  /// Prepares work; REFUSED BY NAME at the sign route, server-side, fail-closed.
  /// Reads the practice's clinical data like anyone else (SPEC §4.1b) — the role
  /// boundary is on ACTIONS, not on visibility.
  TECH
}

enum UserRole {
  DOCTOR
  STAFF
  /// Practice-scoped admin: manages users, sees audits/metrics for their own practice only.
  ADMIN
  /// Cross-practice admin: bypasses tenant scoping. Use sparingly — only for
  /// platform operations (support, billing, compliance review).
  SUPER_ADMIN
}

/// Which of our products a user has access to (T-M2).
/// - MEDDOC_PRO: the existing clinical CRM (all pre-TranscribeMD users get this by default)
/// - TRANSCRIBE_MD: the standalone solo-doctor transcription/SOAP app
/// A user can have both — one login, two product surfaces.
enum Product {
  MEDDOC_PRO
  TRANSCRIBE_MD
  /// Platform-admin role. Gates /admin/* surfaces on both apps.
  /// Grant manually via DB (no self-service). Never auto-granted on
  /// login — F9-1 removed that path on MEDDOC_PRO/TRANSCRIBE_MD too.
  SUPER_ADMIN
}

/// Actions we audit. Extend as new workflows are added.
/// ALL_CAPS_SNAKE to match industry convention and make grep/queries easy.
enum AuditAction {
  // Auth
  /// Invite-only pilot (2026-07-28): a signup was refused for want of a valid
  /// invite code. The REASON is in metadata for the operator; the email address
  /// is deliberately NOT recorded — a rejected signup is not an account, and
  /// logging the address would build the very list the gate exists to prevent.
  SIGNUP_REJECTED_NO_INVITE
  /// Someone asked to be told when there is room. Creates no account.
  WAITLIST_JOINED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_PASSED
  MFA_CHALLENGE_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET_BY_ADMIN
  SESSION_EXPIRED

  // Patient records
  VIEWED_PATIENT_LIST
  VIEWED_PATIENT_FILE
  CREATED_PATIENT
  UPDATED_PATIENT
  ARCHIVED_PATIENT

  // Clinical documents / notes
  VIEWED_DOCUMENT
  CREATED_DOCUMENT
  CREATED_CLINICAL_NOTE
  GENERATED_DRAFT_DOCUMENT
  EDITED_NOTE
  DOWNLOADED_DOCUMENT
  DELETED_DOCUMENT
  UPLOADED_TO_DROPBOX

  // External systems
  SYNCED_FROM_DRCHRONO
  PUSHED_TO_DRCHRONO

  // Scheduling
  SCHEDULED_VISIT
  UPDATED_APPOINTMENT_STATUS
  DELETED_APPOINTMENT

  // Clinical safety data
  CREATED_ALLERGY
  UPDATED_ALLERGY
  DELETED_ALLERGY
  CREATED_MEDICATION
  UPDATED_MEDICATION
  DELETED_MEDICATION

  // M6 — CRM loop-closing (internal API from Scribe Sign)
  CREATED_TASK
  CREATED_BILLING_EVENT

  // ADMIN-1 — practice administration. A DIFFERENT AXIS from the system role
  // below: `USER_ROLE_CHANGED` is the meddoc-pro system-admin app's label for
  // SUPER_ADMIN grants. Conflating the two would make a practice demotion and a
  // super-admin grant indistinguishable in an append-only trail.
  PRACTICE_SEAT_INVITED
  PRACTICE_ROLE_CHANGED
  /// The administration guard refused a caller. A gate nothing records is one
  /// path away from not existing — the sign route's own reasoning.
  PRACTICE_ADMIN_REFUSED

  // Admin
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_DELETED
  EXPORTED_AUDIT_LOG
  ADMIN_DASHBOARD_ACCESS
  ADMIN_API_ACCESS

  // transcribe-md — visit lifecycle (Phase 1A, closes H2)
  VISIT_SIGNED
  VISIT_DELETED
  VISIT_ARCHIVED
  VISIT_UNARCHIVED
  VISIT_RESTORED
  VISIT_RETRY
  VISIT_RETRY_BUDGET_EXHAUSTED

  // transcribe-md — exports
  EXPORT_EMAIL_SENT
  EXPORT_EMAIL_BLOCKED_DESTINATION
  EXPORT_PDF_DOWNLOADED
  EXPORT_DOCX_DOWNLOADED
  EXPORT_CLIPBOARD_COPIED
  /// S4b — bulk PHI egress. Deliberately distinct from the per-visit
  /// EXPORT_* actions above: one row here can mean every visit the user
  /// owns (full account archive) or every visit for one patient. Both
  /// keep the EXPORT_ prefix so the admin export-volume detector, which
  /// filters `action::text LIKE 'EXPORT_%'`, picks them up unchanged.
  EXPORT_ACCOUNT_ARCHIVE_DOWNLOADED
  EXPORT_PATIENT_ARCHIVE_DOWNLOADED

  // transcribe-md — patient CRUD (TranscribeMdPatient; CRM patient
  // events use CREATED_PATIENT / UPDATED_PATIENT / ARCHIVED_PATIENT
  // already)
  TM_PATIENT_CREATED
  TM_PATIENT_UPDATED
  TM_PATIENT_DELETED

  // transcribe-md — settings + account
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGE_CONFIRMED
  ACCOUNT_DELETED

  // transcribe-md — Rx safety audit
  RX_OVERRIDE_RECORDED
  RX_SIGN_BLOCKED_NO_OVERRIDE

  // Phase 6 — admin user-management actions (all audit-logged from
  // /api/admin/users/[id]/* endpoints). Distinct from the older
  // USER_DEACTIVATED/USER_DELETED actions because suspension/soft-
  // delete are reversible-or-recoverable concepts that the admin
  // dashboard cares about as separate workflows.
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_SOFT_DELETED
  USER_FORCE_LOGOUT
  USER_PASSWORD_RESET_TRIGGERED
  USER_GRANTED_SUPER_ADMIN
  USER_REVOKED_SUPER_ADMIN

  // Phase 6H — threat-management actions on the /admin/threats page.
  // Every administrative action on a security event is itself a
  // security event; logged so an auditor can walk back through who
  // looked at what and what disposition they chose.
  THREAT_INVESTIGATED
  THREAT_RESOLVED
  THREAT_DISMISSED_FALSE_POSITIVE

  // Phase 7B — HIPAA-finding workflow on the /admin/hipaa page. The
  // HipaaFinding rows are the canonical "what's open against our
  // compliance posture" — Resolve closes a finding once the underlying
  // gap is fixed; Reopen reverses that if the fix doesn't hold.
  HIPAA_FINDING_RESOLVED
  HIPAA_FINDING_REOPENED

  // Phase 17 — close the §164.312(b) audit-completeness gaps surfaced
  // by the Phase 16 deep audit. Each PHI-touching mutation now writes
  // an audit row with field NAMES + sizes (never raw values).
  AUDIO_UPLOADED
  DOC_EDITOR_SAVED
  DOC_EDITOR_AI_SUGGESTED
  PHI_EXTRACTED_FROM_VOICE

  // Phase 19 — close h16-audit-gap-realtime. WebRTC voice session
  // lifecycle on /api/realtime/* now writes audit rows. Audio bytes
  // never touch our server (browser ↔ OpenAI direct), so the rows
  // mark session boundaries + duration only — no transcript content.
  REALTIME_SESSION_STARTED
  REALTIME_SESSION_ENDED

  // Round 3 PR-C — close §164.312(b) PHI-READ audit gap (audit
  // finding A05-P0-004). Every doctor-side PHI read now emits a
  // row; mutations were already covered by Phase 17.
  VIEWED_VISIT
  VIEWED_VISIT_LIST
  VIEWED_VISIT_AUDIO

  // Round 3 PR-D — AI safety deterministic backstops (audit findings
  // A06-P0-001 empty-transcript guard, A06-P0-002 ICD/CPT allowlist,
  // A06-P0-004 dose-range fail-closed validator). Every rejection or
  // fall-through warning emits an audit row so the admin dashboard
  // and forensics can reconstruct exactly why a visit landed in
  // needsReview.
  PIPELINE_REJECTED_TOO_SHORT
  PIPELINE_REJECTED_INSUFFICIENT_TRANSCRIPT
  PIPELINE_FABRICATION_FLAGGED
  CODING_COACH_REJECTED_INVALID_ICD
  CODING_COACH_REJECTED_INVALID_CPT
  RX_DOSE_EXCEEDS_VERIFIED_RANGE
  RX_CONTRAINDICATION_MATCH
  RX_DRUG_NOT_IN_VERIFIED_DATABASE

  // Round 3 PR-J — input validation audit (audit findings A07-P0/P1):
  //   - INJECTION_DELIMITER: a user-supplied transcript or text-mode
  //     input contained the literal `<transcript_*>` prefix, signalling
  //     a possible prompt-injection attempt. The random suffix on the
  //     real delimiter prevents an actual escape, but we still log
  //     the attempt for forensics.
  //   - AUDIO_REJECTED_INVALID_MAGIC_BYTES: the upload's claimed
  //     Content-Type doesn't match the binary header (e.g., a .txt
  //     renamed to .mp3). We refuse the upload and audit-log the
  //     attempt before bytes ever reach MinIO.
  //   - AUDIO_REJECTED_FILE_TOO_LARGE: server-side enforcement of
  //     the 100 MB upload ceiling, even when the client lies about
  //     content-length.
  //   - TEXT_INPUT_REJECTED_TOO_LARGE: text-mode visit input
  //     exceeded the 5000-char Zod cap.
  PIPELINE_REJECTED_INJECTION_DELIMITER
  AUDIO_REJECTED_INVALID_MAGIC_BYTES
  AUDIO_REJECTED_FILE_TOO_LARGE
  TEXT_INPUT_REJECTED_TOO_LARGE

  // Coding-coach bump persistence (Phase 5.2 stub completion). Emitted
  // when the doctor accepts a "Bump 99213 → 99214"-style suggestion and
  // the server merges the additions into the SOAP draft + re-runs the
  // L7b CPT scorer.
  EM_BUMP_APPLIED

  // Coding-coach override persistence (Phase 5.2 orphan-completion
  // follow-up to PR #132). Emitted when the doctor uses the override
  // dropdown to set a CPT code different from the AI suggestion.
  // Metadata carries { fromCode, toCode, reason? }; the human-readable
  // override is also persisted at `cptCodes.em.override` for the next
  // page load.
  EM_OVERRIDE_APPLIED

  // F8-S1 — the physician's ICD-10 accept/reject. Constraint (d) of F8: every
  // accept/reject writes an audit row. Metadata carries { code, fromState,
  // toState } — the CODE only, never the AI-emitted description, which
  // `07a-icd-coding.ts:471-473` already records can include patient context.
  //
  // THREE labels rather than two: CLEARED (Undo) is its own event, because
  // "the doctor un-accepted a code" is a different clinical fact from "the
  // doctor never accepted it", and a coding audit that cannot tell those apart
  // cannot reconstruct what was decided. A no-op — re-asserting the state
  // already stored — writes NOTHING, per the PROMO_GRANT_CREDITED precedent.
  ICD_CODE_ACCEPTED
  ICD_CODE_REJECTED
  ICD_CODE_DECISION_CLEARED
  ICD_CODE_DECISION_REFUSED

  // §164.312(b) audit-row coverage extension surfaced by QA agent v3.2
  // deep walks (docs/qa-reports/v3.2-discovery-20260506T024044Z.md):
  //   - VIEWED_DASHBOARD: PHI read on the authenticated landing page
  //   - VISIT_CREATED:    write-side audit when createVisitAction
  //     inserts a new transcribe_visits row
  //   - VIEWED_SETTINGS:  PHI-adjacent read of users + user_sessions
  VIEWED_DASHBOARD
  VISIT_CREATED
  VIEWED_SETTINGS

  // PR-L follow-up — Whisper-fallback canary. Emitted by Layer-1 (and
  // Layer-1b dictation) when the transcribe() orchestrator's primary
  // Deepgram call failed and Whisper saved the visit. Metadata
  // carries: { primaryProvider, fallbackProvider, primaryError?,
  // durationSec }. Operators see the rate over time in /admin/queues
  // + audit_logs.
  TRANSCRIPTION_PROVIDER_FALLBACK

  // Q1 #09.1 (2026-06-10) — Anthropic content-policy refusal
  // (stop_reason=refusal). Emitted by the worker's outer catch; the visit
  // is categorized PERMANENT and fails fast into the DLQ. Metadata:
  // { layer, model, purpose? } — never model output.
  AI_REFUSAL

  // Deep-audit G9 (2026-05-12) — partial automation failure traceability.
  // Emitted when at least one load-bearing L7 layer (L7a icd-coding /
  // L7b cpt-coding / L7c rx-drafting) failed during the fan-out but the
  // SOAP itself succeeded. The visit transitions to status=READY +
  // needsReview=true so the doctor sees a banner; this audit row gives
  // forensics the per-layer error metadata for triage. Pre-fix, a credit-
  // exhaustion or transient API error in L7 left visits silently marked
  // READY with empty codes/Rx columns.
  VISIT_AUTOMATION_INCOMPLETE

  // 2026-05-12 stuck-visit watchdog. Emitted by the per-minute sweep when
  // a visit's status has been in an in-flight state (TRANSCRIBING /
  // EXTRACTING / DRAFTING / CRITIQUING / POLISHING / AUTOMATING) for more
  // than the global processing budget (15 min default). The sweep
  // transitions the row to FAILED + failureCategory='transient' so the
  // doctor sees the standard retry UI; this audit row captures the
  // previous status + elapsed seconds for forensics. Triggered by the
  // Kasra stuck-visit incident — 4th-retry-within-the-same-minute was
  // silently deduped against the prior failed BullMQ job, leaving the
  // visit pinned at QUEUED indefinitely.
  VISIT_PROCESSING_TIMEOUT

  // FIND-P1-003 (2026-05-14) — close §164.312(b) gap on Layer-2
  // manual speaker-role overrides. When a doctor reassigns a speaker
  // from the Transcript tab (e.g., "this segment was the patient, not
  // me"), the `speakerMap` mutation affects the SOAP note's
  // history-vs-plan segmentation downstream. Pre-fix, the edit landed
  // without an audit row; "who reassigned what, when" required reading
  // the DB row state at a point in time. This action fills the gap.
  // Metadata carries { source, speakerId, previousRole, newRole } —
  // no PHI (the speakerId is an internal numeric label, the role enum
  // is one of doctor/patient/family/other/unknown).
  SPEAKER_ROLE_REASSIGNED

  // FIND-P1-015 + FIND-P1-016 (2026-05-14) — close the L4/L6 markdown
  // validation gap. L4 (SOAP generation) and L6 (polish) emit markdown
  // output (not JSON), so the Zod / useToolUse pattern from L7a / L2
  // doesn't apply. The lenient validator at
  // `apps/transcribe-md/src/worker/layers/soap-structure-validator.ts`
  // checks (1) non-empty, (2) not JSON-shaped, (3) all 4 SOAP section
  // headers present. On fail the layer still persists the raw output
  // (doctor can fix it manually) and emits this audit action so
  // operators can grep audit_logs for model-contract regressions.
  // Metadata: { layer, reason, outputLength, missingSections } — no PHI
  // (no raw output content, just structured fail-class signal).
  MODEL_OUTPUT_VALIDATION_FAIL

  // L6 fabrication gate (2026-06-11 — hallucination-reconciliation RED
  // finding, docs/qa-reports/hallucination-reconciliation-*.md). Emitted
  // when the post-polish fidelity gate rejects L6's output (new clinical
  // claims relative to its input, a negation/meaning flip, or ANY
  // gate/verifier failure — fail-closed) and the visit falls back to the
  // pre-L6 (L4) draft. Metadata: { layer:'L6', violationCount, kinds,
  // novelTermCount, gateError?, fellBackToDraft:true } — counts + enum
  // class strings only, never note content. Rejection frequency =
  // SELECT count(*) FROM audit_logs WHERE action='L6_FABRICATION_REJECTED'.
  L6_FABRICATION_REJECTED

  // Hybrid anchored generation (2026-06-11) — the explicit doctor adoption
  // flow for verifier-demoted claims ("Suggested by AI" lane). Adopted
  // claims enter the note as DOCTOR-attested. Metadata: { section, reason,
  // remaining } — never claim text (PHI).
  SUGGESTION_ADOPTED
  /// One row per chat-editor turn. Every EFFECT the chat has is already
  /// audited by the action it dispatches into — but a SUGGESTION_ADOPTED row
  /// written by the chat is byte-identical to one written by a button, and
  /// "did the model do this, or did the doctor?" is the first question anyone
  /// will ask of this feature. Metadata is counts and intent KINDS only.
  CHAT_EDIT_TURN
  /// Sign refused: the note changed since the E/M level was last scored.
  EM_SIGN_BLOCKED_STALE
  /// The E/M level was re-scored against a changed note.
  EM_RESCORED
  SUGGESTION_DISMISSED

  // E/M recompute on adoption — visible-confirm, never silent (2026-06-12,
  // prod smoke #311). EM_LEVEL_CHANGED is emitted by the adopt/dismiss
  // suggestion actions when the action changed the computed E/M level.
  // Metadata: EXACTLY { from, to, cause } where cause ∈
  // {'suggestion_adopted','suggestion_dismissed'} — CPT codes + cause class
  // only, never note text. EM_SIGN_BLOCKED_UNACKNOWLEDGED_CHANGE is emitted
  // by the sign route when a sign request was rejected because a recorded
  // E/M change had not been explicitly acknowledged by the doctor.
  EM_LEVEL_CHANGED
  EM_SIGN_BLOCKED_UNACKNOWLEDGED_CHANGE
  // SIGN_BLOCKED_NO_ATTESTATION — a sign request arrived with no attestation.
  // ⚠️ THIS VALUE HAS TO EXIST HERE, NOT ONLY IN THE TS UNION. `audit_logs.action`
  // is a Postgres ENUM: adding the label to `lib/audit.ts` alone makes the insert
  // fail, and because `logAudit` is `void`-ed the rejection is swallowed. The
  // refusal still worked in production and the row silently did not write —
  // measured 2026-08-02, before this migration.
  SIGN_BLOCKED_NO_ATTESTATION

  /// T6 — a sign request from a member whose PRACTICE ROLE may not sign (TECH).
  /// Refused BY NAME, server-side, per SPEC §4.1a: "you may not sign" and "this
  /// does not exist" are different facts and a clinician deserves the true one.
  /// Metadata carries the role, never note text.
  ///
  /// ⚠️ ADDED TO THE PRISMA ENUM IN THE SAME COMMIT AS THE TS UNION. On
  /// 2026-08-03 a refusal shipped whose audit row silently did not, because the
  /// union was updated and the database enum was not. The union is not the
  /// database — and this edit's first attempt missed this file while landing in
  /// audit.ts, which is the same failure arriving a second time. An occurrence
  /// assertion caught it.
  SIGN_BLOCKED_ROLE_NOT_PERMITTED

  // F-8 audit leg (2026-07-02) — deterministic drug-PAIR interaction floor
  // (worker L7c, checkDrugInteractions). RX_DRUG_PAIR_* metadata: { ruleId,
  // primaryDrug, otherDrug, severity, doseMgPerDay? }; the complex-dosing
  // nudge (PR-D deferred follow-up) carries the single-drug validator shape
  // { drug }. Never note/transcript content.
  RX_DRUG_PAIR_INTERACTION
  RX_DRUG_PAIR_DOSE_CAP
  RX_COMPLEX_DOSING_VERIFY_INDIVIDUALLY
  // Template Twin native-DOCX (2026-07-22) — structure-preserving custom
  // templates. Metadata carries structured provenance (sha256, counts, versions,
  // field/rule classes) only — never note or transcript content.
  TEMPLATE_TWIN_SOURCE_UPLOADED
  TEMPLATE_TWIN_COMPILED
  TEMPLATE_TWIN_QUARANTINED
  TEMPLATE_TWIN_MAPPING_UPDATED
  TEMPLATE_TWIN_CERTIFIED
  TEMPLATE_TWIN_ACTIVATED
  TEMPLATE_TWIN_SYNTHETIC_TESTED
  TEMPLATE_TWIN_FIELD_REVIEWED
  TEMPLATE_TWIN_SIGN_BLOCKED
  TEMPLATE_TWIN_RENDER_VERIFIED
  TEMPLATE_TWIN_CERTIFY_FAILED

  /// The anchored verifier ran and recorded what it found. AUDIT-ONLY: the
  /// verifier no longer demotes anything into a pending-suggestion lane — all
  /// generated content flows into the draft the physician reviews and signs,
  /// and this row is the durable record of what the verifier thought.
  /// Metadata is CATEGORY COUNTS ONLY (visitId + {reason: n}) — never a line
  /// of note text, so the audit stream stays PHI-free.
  ANCHOR_FLAGS_RECORDED

  /// 2026-08-04 — the repair record for the `?? 'clinic_main'` fail-open in
  /// `lib/audit.ts`. This table is APPEND-ONLY: a wrongly-attributed row is
  /// never UPDATEd, because an audit trail that can be rewritten is not one.
  /// A correction is a NEW row whose `targetId` is the id of the row being
  /// corrected and whose metadata is exactly
  ///   { wrongPracticeId, correctPracticeId | null, determinable, basis }
  /// — ids and a basis string only, never PHI. `determinable: false` is a
  /// real, recordable outcome: the six pre-S4c EM_LEVEL_CHANGED rows carry
  /// NULL in both practiceId and practiceIdSnapshot and have no userId, so
  /// their tenant is genuinely unrecoverable and is stated, not guessed.
  AUDIT_ATTRIBUTION_CORRECTED

  /// B7 (2026-08-11) — Stripe Hosted Checkout top-ups. Emitted by
  /// `api/stripe/webhook/route.ts`, which has NO SESSION and therefore passes
  /// `userId` and `practiceId` explicitly (DISCOVERY §E.6).
  ///
  ///   CHECKOUT_TOPUP_CREDITED — a `topup` row was appended to
  ///     `ledger_entries`. Metadata: { stripeEventId, amountMicroUsd,
  ///     amountTotalCents, bucket, balanceAfter, seq } — the balance is read
  ///     BACK from the row the trigger derived, never the caller's opinion.
  ///   CHECKOUT_TOPUP_REFUSED — a validly-signed event was declined. Metadata
  ///     carries the named reason (mode mismatch, non-USD, unpaid, a metadata
  ///     key outside the allowlist, an unknown practice) so B9 can reconcile
  ///     "we received an event and wrote nothing" against Stripe's own record.
  ///   CHECKOUT_TOPUP_DUPLICATE — a redelivery hit the global unique on
  ///     `idempotencyKey`. The idempotency working, not an error.
  ///
  /// ⚠️ NO ROW IS WRITTEN BEFORE THE SIGNATURE VERIFIES. The route is
  /// unauthenticated by design (the signature IS the auth, §E.4), so an audit
  /// row per unverified request would be a write amplification an anonymous
  /// caller controls. Every label here is emitted only AFTER a valid signature,
  /// so its rate is bounded by Stripe's retry policy.
  ///
  /// ⚠️ AND ALL THREE NEED THIS MIGRATION, NOT ONLY THE TS UNION —
  /// `20260811160000_b7_checkout_audit_actions`. `logAudit` is fire-and-forget,
  /// so a label present only in TypeScript fails silently at runtime; that has
  /// shipped three times (`535d30d9`, and twice on 2026-08-06).
  CHECKOUT_TOPUP_CREDITED
  CHECKOUT_TOPUP_REFUSED
  CHECKOUT_TOPUP_DUPLICATE

  /// B7 step 2 (2026-08-11) — the OUTBOUND half. Emitted by
  /// `api/stripe/checkout/route.ts`, which IS authenticated and therefore
  /// carries a real `userId` on every row.
  ///
  ///   CHECKOUT_SESSION_CREATED — Stripe returned a hosted Checkout URL.
  ///     Metadata: { stripeSessionId, amountCents, bucket }. The session id is
  ///     the join key to the eventual `topup` ledger row, whose
  ///     `idempotencyKey` is derived from that same id.
  ///   CHECKOUT_SESSION_REFUSED — nothing was created. Metadata carries the
  ///     named reason and the secret key's MODE — a classification, never the
  ///     credential.
  ///
  /// ⚠️ Refusals ARE audited here, unlike the webhook's. That is not an
  /// inconsistency: ruling 91(b) suspends the convention only because the
  /// webhook is unauthenticated, and this route is not.
  ///
  /// ⚠️ AND BOTH NEED THEIR MIGRATION —
  /// `20260811190000_b7_checkout_session_audit_actions`.
  CHECKOUT_SESSION_CREATED
  CHECKOUT_SESSION_REFUSED

  /// B7 step 3c (2026-08-12) — a `grant` row was appended to `ledger_entries`.
  /// Ruling #99 requires one audit row per grant. Emitted by ALL THREE doors —
  /// the signup transaction (`actions/auth.ts`), the one-shot backfill, and the
  /// reactivation path (`meddoc-pro/system-admin/actions.ts`) — with the door
  /// named in metadata, so "which door funded this practice" is a query rather
  /// than an inference.
  ///
  /// Metadata: { practiceId, amountMicroUsd, bucket, balanceAfter, seq, door }.
  /// `balanceAfter` and `seq` are read BACK off the row the derive trigger
  /// wrote — never the caller's opinion of what the balance became.
  ///
  /// ⚠️ THERE IS NO `_DUPLICATE` SIBLING, DELIBERATELY. `already_granted` is the
  /// ABSENCE of an event: no money moved and nothing changed, so a row would be
  /// write amplification on every backfill re-run and every reactivation of an
  /// already-funded practice. `CHECKOUT_TOPUP_DUPLICATE` exists because there
  /// the duplicate is a message Stripe SENT US; nobody sends us a grant.
  ///
  /// ⚠️ AND IT NEEDS ITS MIGRATION —
  /// `20260812200000_b7s3c_promo_grant_audit_action`.
  PROMO_GRANT_CREDITED

  // ── BATCHED LABEL MIGRATION, 2026-08-28 ────────────────────────────────────
  // ⚠️ FOUR LABELS IN ONE MIGRATION, DELIBERATELY. Postgres has no
  // `ALTER TYPE … DROP VALUE`, so every enum addition is IRREVERSIBLE. Three
  // separate needs had each accumulated their own pending migration; batching
  // them means ONE irreversible act to declare and judge instead of three.

  /// Ruling #155(b) — VISIBILITY WITHOUT MUTATION. F12-e (#152) established that
  /// a visit whose `cptCodes.em` is null still displayed and attested an E/M, so
  /// the signed artifact printed none. Ruled (a): those records STAY AS SIGNED —
  /// the freeze is this product's deepest promise, and retroactively inserting an
  /// E/M the artifact never carried would make the SERVED document differ from
  /// what was ATTESTED. So the gap is made visible by an append-only row ABOUT
  /// the event: one per affected SIGNED visit, touching no visit row, no fill
  /// manifest and no document bytes. Measured 2026-08-28, unchanged from #155:
  /// 12 carry the shape, 10 SIGNED, 0 imaging.
  EM_OMITTED_IN_SIGNED_ARTIFACT

  /// R1's delete fence writes an audit row on BOTH paths — the refusal AND the
  /// successful delete. ⚠️ THE SUCCESSFUL PATH IS THE POINT: before R1 a hard
  /// delete wrote NOTHING, which is why 29 servable visits lost their template
  /// provenance invisibly and why audit adjacency could not classify them
  /// afterwards. A fence that stops the deletion still leaves a permitted
  /// deletion traceless.
  TEMPLATE_DELETED
  /// The non-destructive alternative R1 offers instead of deleting a referenced
  /// template. Recorded so "archived" and "deleted" are distinguishable in the
  /// audit trail rather than inferred from what is missing.
  TEMPLATE_ARCHIVED

  /// F8-S3 auto-decide. Reserved in this batch because the label is irreversible
  /// and the alternative is a second irreversible migration later; the threshold
  /// itself is proposed from data and is NOT settled by this label existing.
  ICD_CODE_AUTO_ACCEPTED

  /// ⚠️ A PROVENANCE LOSS IS NOT A DELETION EVENT, AND THE TRAIL MUST NOT SAY IT
  /// IS. The 29 servable visits whose `noteTemplateId` was nulled by the old
  /// `ON DELETE SET NULL` need a retrospective annotation, and `TEMPLATE_DELETED`
  /// would have asserted that a deletion happened NOW — permanently, because
  /// `audit_logs` is append-only and a query filtering on `action` would count 29
  /// deletions that never occurred. So the vocabulary gets its own word.
  ///
  /// ⚠️ NO RUNTIME WRITER, BY DESIGN. Nothing in the application emits this; it is
  /// written ONLY by ruled mutation acts, the #155(b)/R1 annotation backfill being
  /// the first. That satisfies the label-nothing-writes rule rather than excusing
  /// it — the ruled act IS the writer, and the deploy declaration says so.
  TEMPLATE_PROVENANCE_LOST

  // REVIEW-DEFAULTS item 1 (ruling #194's doctor-facing half).
  /// The doctor asserted their OWN compiled scaffold default into a blank
  /// field at review. ⚠️ This is the opposite of the deleted `default_kept`:
  /// the machine never prints an undictated default, so the CLICK is the
  /// assertion and this row is the evidence that a human made it.
  DEFAULT_INSERTED_BY_DOCTOR

  /// The doctor REMOVED a default they had inserted. ⚠️ ITS OWN LABEL, because
  /// an undo emitted under the insert's label makes every action-level rollup
  /// count a reverted assertion as an assertion — which defeats the only thing
  /// the irreversible enum add was bought for.
  DEFAULT_INSERT_UNDONE
}

/// Document lifecycle status
enum DocumentStatus {
  DRAFT
  FINALIZED
  SIGNED
  ARCHIVED
}

/// Patient record status (we don't hard delete — soft archive for HIPAA retention)
enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Biological sex for clinical context (dosing, procedures). Non-PHI under
/// HIPAA Safe Harbor. Kept intentionally minimal — UNKNOWN covers "not
/// asked yet" and OTHER is a catch-all so we don't rev the enum for edge
/// cases. Gender identity is a separate concern and not captured here.
enum PatientSex {
  UNKNOWN
  MALE
  FEMALE
  OTHER
}

/// Visit type for appointments
enum VisitType {
  CONSULTATION
  FOLLOW_UP
  PROCEDURE
}

/// Appointment lifecycle
enum AppointmentStatus {
  SCHEDULED
  WAITING
  IN_ROOM
  COMPLETED
  CANCELLED
}

/// Allergy severity. UNKNOWN is the safe default when the clinician has
/// recorded the allergen but hasn't confirmed reaction severity yet.
/// SEVERE drives the high-visibility red banner in the UI.
enum AllergySeverity {
  UNKNOWN
  MILD
  MODERATE
  SEVERE
}

/// T-M16.2: why a one-time AuthToken was minted. Each purpose maps to
/// exactly one email flow and has its own TTL + consumer handler.
/// - PASSWORD_RESET: 1-hour link emailed to a user who clicked
///   "Forgot password?". Consumer resets passwordHash + revokes all
///   their UserSession rows.
/// - EMAIL_VERIFICATION: link emailed at signup (when RESEND is
///   enabled). Consumer sets User.emailVerified = now().
/// - EMAIL_CHANGE: link emailed to the NEW address the user is
///   moving to; `metadata.newEmail` holds that address. Consumer
///   updates User.email after verifying the current password.
enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  EMAIL_CHANGE
}

// ============================================================================
// PRACTICE — tenant boundary
// ----------------------------------------------------------------------------
// Every row with PHI belongs to exactly one Practice. Queries filter by
// practiceId so practices never see each other's data. The default
// practice (id = 'clinic_main') is seeded during the multi-tenancy
// migration and owns all pre-existing data.
// ============================================================================

model Practice {
  id   String @id @default(cuid())
  name String
  /// URL-safe handle. Used for subdomain routing, deep-linked invites,
  /// and "which practice am I on?" displays. Lowercase alphanumerics + hyphens.
  slug String @unique

  address String?
  phone   String?

  isActive Boolean @default(true)

  // M7 — clinic-configurable retention (spec §13).
  /// Days to retain uploaded audio (MinIO objects) past ScribeVisit.endedAt.
  /// Default 90 matches the spec. Admin UI to edit per-practice lands in
  /// a later milestone; adjust directly via SQL for now.
  audioRetentionDays      Int @default(90)
  /// Days to retain transcripts + outputs past ScribeVisit.endedAt. Default
  /// 2555 = 7 years (HIPAA's 6-year minimum + a year of buffer).
  transcriptRetentionDays Int @default(2555)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Reverse relations — every tenant-scoped table points back here.
  users                User[]
  patients             Patient[]
  auditLogs            AuditLog[]
  apiUsage             ApiUsage[]
  sessionLogs          SessionLog[]
  allergies            Allergy[]
  medications          Medication[]
  // M6 — CRM loop-closing
  tasks                Task[]
  billingEvents        BillingEvent[]
  aiCalls              AiCall[]
  // T-M17.2 — TranscribeMD-scoped patients. Kept separate from the
  // CRM `Patient` model so the two products can diverge on schema +
  // privacy posture (TranscribeMdPatient stores full DOB; CRM Patient
  // stores birthYear only per Safe Harbor).
  transcribeMdPatients TranscribeMdPatient[]
  transcribeVisits     TranscribeVisit[]
  // Phase 6 — per-call external API spend; rolled up in the admin
  // usage endpoints.
  apiUsageEvents       ApiUsageEvent[]

  // Template Twin native-DOCX (additive back-relations; no column change).
  templateTwinSources          TemplateTwinSourceArtifact[]
  templateTwinFills            TemplateTwinFillManifest[]
  templateTwinFieldOverrides   TemplateTwinFieldOverride[]
  /// T8 — invites that admit into this practice.
  inviteCodes                  InviteCode[]
  visitDeliveries              VisitDelivery[]
  doctorEditPatterns           DoctorEditPattern[]
  rxWarningOverrides           RxWarningOverride[]
  templateTwinCompiledVersions TemplateTwinCompiledVersion[]
  templateTwinFieldDefinitions TemplateTwinFieldDefinition[]
  templateTwinSemanticMappings TemplateTwinSemanticMapping[]
  templateTwinCertifications   TemplateTwinCertification[]
  /// B5 — the practice wallet. Append-only; detaches (SetNull) rather than
  /// cascading when this practice is deleted, because a financial record must
  /// outlive the account it describes.
  ledgerEntries                LedgerEntry[]

  @@index([slug])
  @@map("practices")
}

// ============================================================================
// USER — staff accounts (doctors, admins, front-desk)
// ============================================================================

model User {
  id                  String         @id @default(cuid())
  platformRateChanges PlatformRate[] @relation("PlatformRateChangedBy")

  // === NextAuth standard fields ===
  /// User's email — unique, lowercased at application layer
  email         String    @unique
  /// Display name (NextAuth standard — was `fullName` before)
  name          String?
  /// Set when email is verified (used by email magic links)
  emailVerified DateTime? @db.Timestamptz(6)
  /// Optional avatar URL (used by OAuth providers)
  image         String?

  // === Credentials provider ===
  /// bcrypt hash. NEVER store plaintext. Must meet org password policy.
  passwordHash String

  // === RBAC ===
  /// ⚠️ LEGACY PLATFORM AXIS — DO NOT EXTEND. Ruled 2026-08-06 (RULINGS.md).
  /// This enum conflates a CLINICAL distinction (DOCTOR/STAFF) with a
  /// PLATFORM-PRIVILEGE one (ADMIN/SUPER_ADMIN), and cannot express ownership of
  /// a practice at all. The practice axis is `practiceRole` below.
  ///
  /// Never add a value here. ADMIN/SUPER_ADMIN's disposition is an ADMIN-phase
  /// item — the platform ADMIN flag replaces them. DOCTOR/STAFF become
  /// non-load-bearing once the practiceRole backfill lands.
  role UserRole @default(STAFF)

  // === The PRACTICE axis (TEAMS T6) ===
  /// The member's role WITHIN their practice. Separate from `role` above by
  /// ruling: two axes, never one enum.
  ///
  /// ⚠️ NULLABLE ON PURPOSE, AND THE DATABASE CONSTRAINT SAYS WHEN.
  /// `users_active_member_has_practice_role` requires a value for any ACTIVE
  /// user who has a practice. Deactivated rows and practice-less rows carry
  /// NULL — a deactivated account has no role in a practice, and a sentinel
  /// there would be a claim nobody made.
  ///
  /// Real CLINICIAN/TECH assignments arrive only via T8 invites carrying a role.
  /// The backfill mints OWNER and nothing else — see the migration header.
  practiceRole PracticeRole?

  // === Clinician profile (app-redesign-v1) ===
  // Doctor-facing profile fields the Settings UI writes to. `clinicName`
  // is a display override distinct from Practice.name (a solo doctor
  // with a synthetic Practice still wants a branded clinic name on
  // exports); leaving it null falls back to Practice.name at render
  // time. timeZone default matches the majority user base; the Settings
  // tz picker overrides per user.
  specialty  String?
  npi        String?
  clinicName String?
  timeZone   String? @default("America/Los_Angeles")

  // === MFA / security tracking (HIPAA §164.312(a)(2)(i)) ===
  mfaEnabled     Boolean   @default(false)
  /// Encrypted TOTP secret (app-layer encryption, e.g., AES-256-GCM with KMS key).
  /// Never return this to the client.
  mfaSecret      String?
  /// Hashed (never plaintext) one-time recovery codes. One per element;
  /// consumed codes are removed from the array at verify time.
  mfaBackupCodes String[]  @default([])
  mfaVerifiedAt  DateTime? @db.Timestamptz(6)

  // === Session / login tracking ===
  lastLogin        DateTime? @db.Timestamptz(6)
  lastLoginIp      String?   @db.Inet
  failedLoginCount Int       @default(0)
  /// If set, account is locked until this timestamp (brute-force protection)
  lockedUntil      DateTime? @db.Timestamptz(6)

  // === Lifecycle ===
  isActive      Boolean   @default(true)
  deactivatedAt DateTime? @db.Timestamptz(6)
  /// User who deactivated this account (for audit trail)
  deactivatedBy String?

  // === Phase 6 — admin-driven account state ===
  /// Suspension is a SOFT pause: the user can't log in but the row
  /// stays intact and is reversible by `unsuspend`. Distinct from
  /// `isActive=false` (deactivated) which is a one-way deboarding.
  suspendedAt     DateTime? @db.Timestamptz(6)
  /// Admin who suspended (User.id). Kept separate from `deactivatedBy`
  /// so suspension/deactivation provenance don't overwrite each other.
  suspendedBy     String?
  /// Free-text reason captured at suspension time. Surfaced in the
  /// User detail drawer.
  suspendedReason String?

  /// Soft delete: the user vanishes from admin lists + the audit feed
  /// renders the email as "[deleted]", but the row + every related
  /// audit_logs row stays intact for the HIPAA 7-year retention
  /// window. A real DELETE only happens after that window via a
  /// separate sweep job (not in this phase).
  softDeletedAt DateTime? @db.Timestamptz(6)
  softDeletedBy String?

  /// Sessions issued before this timestamp are invalid. Set by the
  /// `force-logout` admin action AND implicitly by suspend / soft-
  /// delete / revoke-admin (they all imply revocation of in-flight
  /// sessions). Honoured in the shared `jwt()` callback.
  forceLogoutAt DateTime? @db.Timestamptz(6)

  // === Tenant ===
  // Every user belongs to exactly one Practice. Queries filter by this.
  // A future SUPER_ADMIN role may bypass the filter; for now, everyone
  // is practice-scoped.
  //
  // T-M2: for TranscribeMD solo doctors (no real clinic) we create a
  // synthetic Practice at signup — name="Solo — {user.name}",
  // slug=cuid() — so existing tenant-scoped queries keep working
  // unchanged. 1:1 with user. When a solo doctor later wants to work
  // with colleagues, migrate them to a real Practice.
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  // === Product access (T-M2) ===
  // Which apps this user can use. Existing users default to [MEDDOC_PRO]
  // so the roll-forward is a no-op for them. New TranscribeMD signups
  // get [TRANSCRIBE_MD]; MedDoc Pro users who later log into the
  // TranscribeMD app have TRANSCRIBE_MD appended silently on first
  // successful login.
  products Product[] @default([MEDDOC_PRO])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // === Relations ===
  // NextAuth adapter relations
  accounts                   Account[]
  sessions                   Session[]
  // App relations
  documentsCreated           Document[]                  @relation("DocumentCreator")
  documentsUpdated           Document[]                  @relation("DocumentUpdater")
  auditLogs                  AuditLog[]
  patientsCreated            Patient[]                   @relation("PatientCreator")
  patientsAssigned           Patient[]                   @relation("AssignedDoctor")
  appointments               Appointment[]
  sessionLogs                SessionLog[]
  apiUsageLogs               ApiUsageLog[]
  allergiesCreated           Allergy[]                   @relation("AllergyCreator")
  allergiesUpdated           Allergy[]                   @relation("AllergyUpdater")
  medicationsCreated         Medication[]                @relation("MedicationCreator")
  medicationsUpdated         Medication[]                @relation("MedicationUpdater")
  apiUsage                   ApiUsage[]
  // M6 — CRM loop-closing
  tasksAssigned              Task[]                      @relation("TaskAssignee")
  tasksCreated               Task[]                      @relation("TaskCreator")
  billingEventsOwned         BillingEvent[]              @relation("BillingClinician")
  billingEventsSubmitted     BillingEvent[]              @relation("BillingSubmitter")
  // TranscribeMD (T-M2)
  transcribeVisits           TranscribeVisit[]
  /// T4 back-relations. Named because TranscribeVisit now points at User three
  /// ways — owner, creator, signer — and Prisma cannot disambiguate unnamed ones.
  visitsCreated              TranscribeVisit[]           @relation("VisitCreatedBy")
  visitsSigned               TranscribeVisit[]           @relation("VisitSignedBy")
  /// F24-S5 — form-control corrections this clinician made. A clinical write is
  /// attributable or it is not made.
  templateTwinFieldOverrides TemplateTwinFieldOverride[]
  userSessions               UserSession[]
  // T-M14.1: per-doctor edit tracking (one row per signed visit).
  doctorEditPatterns         DoctorEditPattern[]
  // Note-format customization (Phase 0) — a doctor's custom note-format
  // templates. Empty for every doctor in Phase 0 (they only get a row
  // when they customize in Phase 2+); the resolve-logic falls back to the
  // system-default NoteTemplate (doctorId = null) until then.
  noteTemplates              NoteTemplate[]
  // T-M16.2: one-time tokens for password reset, email verification,
  // email change. All cascade-deleted with the user.
  authTokens                 AuthToken[]
  // Rx warning overrides authored by this user. Every time the
  // doctor overrides a critical Rx warning, one row is inserted in
  // `rx_warning_overrides` with the reason. Audit trail for sign-
  // anyway decisions.
  rxWarningOverrides         RxWarningOverride[]
  // Phase 6 — per-user external-API spend events (one row per
  // call to Deepgram / Anthropic / Whisper / OpenAI / Resend).
  apiUsageEvents             ApiUsageEvent[]
  // Phase 6H — threats this user resolved/dismissed via the admin
  // dashboard. Reverse side of ThreatResolution.resolvedBy.
  threatResolutions          ThreatResolution[]
  // Phase 7B — HIPAA findings this user closed via /admin/hipaa.
  // Reverse side of HipaaFinding.resolvedBy.
  hipaaFindings              HipaaFinding[]

  // Template Twin native-DOCX (additive back-relations; no column change).
  templateTwinSourcesCreated   TemplateTwinSourceArtifact[]  @relation("TemplateTwinSourceCreator")
  templateTwinMappingsApproved TemplateTwinSemanticMapping[] @relation("TemplateTwinMappingApprover")
  templateTwinCertifications   TemplateTwinCertification[]   @relation("TemplateTwinCertifier")

  @@index([practiceId])
  @@index([role])
  @@index([isActive])
  /// T6 — the sign gate reads one of these per request.
  @@index([practiceId, practiceRole])
  @@map("users")
}

// ============================================================================
// NEXTAUTH ADAPTER MODELS
// ----------------------------------------------------------------------------
// Standard tables required by `@auth/prisma-adapter`. Used for OAuth providers
// (Google, Microsoft, etc.) and database-stored sessions. With our current
// Credentials + JWT setup these tables stay empty, but they let us add OAuth
// providers later without a schema migration.
// ============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// AUTH TOKEN — T-M16.2 one-time link tokens (password reset, email
// verification, email change)
// ----------------------------------------------------------------------------
// Stored HASHED, never plaintext. The caller handing out a reset link
// sees the plaintext exactly once (to embed in the email URL); the DB
// only ever sees SHA-256(token). Consumer flow:
//   1. incoming URL carries ?token=<raw>
//   2. server hashes it the same way
//   3. looks up the matching row that matches purpose + hash + not
//      yet used + not expired
//   4. atomically sets usedAt = now() and returns userId/metadata
//
// Why one table with a purpose enum instead of three separate tables:
// the consumer pattern is identical for every flow (validate hash,
// check freshness, mark used); a single table means one code path to
// audit + one index set to maintain.
// ============================================================================

model AuthToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose AuthTokenPurpose

  /// SHA-256 hex of the raw token. The raw token is 32 bytes
  /// base64url-encoded (~43 chars) — it's only in memory briefly
  /// during the issue + email send path.
  tokenHash String @unique

  /// Issued TTL varies by purpose:
  ///   PASSWORD_RESET      — 1 hour
  ///   EMAIL_VERIFICATION  — 24 hours
  ///   EMAIL_CHANGE        — 24 hours
  expiresAt DateTime

  /// Null until consumed. Marking usedAt and failing on a second read
  /// is how we make tokens single-use.
  usedAt DateTime?

  /// Purpose-specific extras. EMAIL_CHANGE carries `{newEmail: "..."}`.
  /// PASSWORD_RESET + EMAIL_VERIFICATION leave it null.
  metadata Json?

  createdAt DateTime @default(now())

  // (userId, purpose) makes "invalidate all pending resets for this
  // user" cheap (WHERE userId=? AND purpose='PASSWORD_RESET'). The
  // expiresAt index is for the future cleanup sweep.
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ============================================================================
// ACCOUNT DELETION — T-M16.2 HIPAA audit trail
// ----------------------------------------------------------------------------
// Written inside the delete-account transaction BEFORE the User row is
// cascade-dropped. We keep the minimum metadata required to prove we
// honored a deletion request (HIPAA 45 CFR § 164.530 documentation
// requirement) without retaining any PHI.
//
// The `purgeAt` column marks when this audit row itself should be
// scrubbed (deletedAt + 90 days). A scheduled sweep that deletes rows
// where purgeAt < now() is NOT implemented here — this table just
// captures the signal. The sweeper lands in a future milestone.
//
// TODO(T-M16.3+): implement scheduled purge of rows where
// purgeAt < now(). Until then, old rows accumulate indefinitely;
// manual SQL cleanup is OK if volume becomes a concern.
// ============================================================================

model AccountDeletion {
  id String @id @default(cuid())

  /// The ex-user's id. No FK relation — by the time this row exists,
  /// the User row has already cascade-dropped.
  userId String

  /// Frozen copy of the email at deletion time, for compliance
  /// recordkeeping. Treated as PHI-adjacent — this table itself is
  /// the thing that eventually gets purged via purgeAt.
  email String

  /// Most-recent-visit specialty (if any). Null for never-completed
  /// accounts.
  specialty String?

  /// Count of TranscribeVisit rows the user had at deletion time.
  /// Useful for engagement-by-deletion analysis later.
  visitCount Int

  deletedAt DateTime @default(now())

  /// deletedAt + 90 days. When the sweeper lands it deletes rows
  /// where this is in the past.
  purgeAt DateTime

  /// T7 — NULLABLE like audit_logs (S4c): a deletion record outlives the
  /// account, so this is the practice AT DELETION TIME, not a live FK.
  practiceId String?

  @@index([purgeAt])
  @@index([practiceId])
  @@map("account_deletions")
}

// ============================================================================
// PATIENT — minimal PHI; DrChrono is the source of truth
// ============================================================================

model Patient {
  id String @id @default(cuid())

  // === LINK TO SOURCE OF TRUTH (optional) ===
  // When the patient has a DrChrono record, we cache the ID here and defer
  // to DrChrono for sensitive reads (DOB, SSN, address). Optional so the
  // CRM can also hold patients that aren't in DrChrono yet or at all.
  // Unique when present; Postgres treats multiple NULLs as distinct.
  drChronoId String?   @unique
  /// Timestamp of the last successful sync from DrChrono
  lastSyncAt DateTime? @db.Timestamptz(6)

  // === MINIMAL WORKFLOW FIELDS (safe to cache locally) ===
  /// Display name used in lists/UI. Store first + last only; full chart lives in DrChrono.
  firstName String
  lastName  String
  /// MRN for cross-reference (NOT SSN)
  mrn       String?
  /// Practice-internal chart number. Separate from MRN — clinics often
  /// maintain both: MRN for insurance filings, chartId for in-practice use.
  chartId   String?

  // Optional non-sensitive contact handles for workflow only.
  // For HIPAA minimization, these are NULL unless required for the feature.
  email      String?
  /// Kept for back-compat + minimal-PHI workflows. Prefer `cellPhone` for
  /// full-number storage when the practice needs to reach the patient.
  phoneLast4 String? @db.VarChar(4)
  /// Full cell phone number — E.164 or loose practice format, not normalized.
  cellPhone  String?
  /// Full home phone number.
  homePhone  String?

  /// Insurance verification state. `true` means verified on file, `false`
  /// means explicitly not verified (e.g., self-pay), `null` means unknown /
  /// not yet checked. Three-state so the UI can show "pending verification"
  /// without an extra enum column.
  insuranceVerified Boolean?

  /// "No Known Allergies" — explicitly confirmed with the patient. This is
  /// distinct from "we just haven't asked yet" (any non-NKA patient with
  /// zero Allergy rows). The UI surfaces NKA as a green badge so the
  /// doctor knows the screen is intentionally clear, not just empty.
  noKnownAllergies Boolean @default(false)

  // Demographics — year only (de-identified per HIPAA Safe Harbor §164.514)
  // Full DOB is fetched on-demand from DrChrono, never cached here.
  birthYear Int?
  /// Biological sex — clinically relevant for medication dosing and certain
  /// procedures. Nullable so legacy rows don't force a value.
  sex       PatientSex @default(UNKNOWN)

  // === Address (mailing / insurance filings) ===
  // Captured locally because practices routinely use it for mailing labels,
  // insurance verification, and appointment reminders. Full street address
  // is NOT de-identified under Safe Harbor — this field is PHI and lives
  // under the same tenant isolation and audit trail as names/phones.
  addressLine1 String?
  addressLine2 String?
  city         String?
  /// US 2-char state code (e.g., "CA"). Loose storage so the data layer
  /// doesn't have to enforce a closed list — forms normalize, DB trusts.
  state        String?
  postalCode   String?

  // === Preferred pharmacy ===
  // Relevant in pain management for controlled-substance e-prescribing.
  // Free-text name + phone; a full address is overkill for our workflow.
  pharmacyName  String?
  pharmacyPhone String?

  // CRM workflow
  status           PatientStatus @default(ACTIVE)
  /// Free-text label for internal tagging (e.g., "post-op", "referral")
  tags             String[]      @default([])
  /// One-line summary entries the doctor maintains as the patient's
  /// running clinical context (e.g., "Started LESI series 03/2025",
  /// "Failed PT 2024"). Editable via Edit Patient or via the AI
  /// assistant's update_patient tool. Replace-semantics — the full list
  /// is sent on every update so callers must include existing entries
  /// they want to keep.
  briefHistory     String[]      @default([])
  /// Assigned provider (relation to User). Nullable for unassigned intakes.
  assignedDoctorId String?
  assignedDoctor   User?         @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: SetNull)

  // Creator (who imported/created this record in our CRM)
  createdById String?
  createdBy   User?   @relation("PatientCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // === Tenant ===
  // Patients never cross practice boundaries. createdById / assignedDoctorId
  // must belong to the same practice; Phase 2 enforces this.
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  // Audit trail — soft delete only
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relations
  documents     Document[]
  appointments  Appointment[]
  allergies     Allergy[]
  medications   Medication[]
  // M6 — CRM loop-closing
  tasks         Task[]
  billingEvents BillingEvent[]

  // Chart IDs are practice-scoped: Practice A's C-1001 is unrelated to
  // Practice B's C-1001. Postgres treats multiple NULLs as distinct, so
  // this composite unique doesn't break patients with no chartId set.
  // The data layer relies on this constraint as the final race-condition
  // gate — auto-generated IDs retry on collision.
  @@unique([practiceId, chartId], name: "patient_practice_chartid_unique")
  @@index([practiceId])
  @@index([drChronoId])
  @@index([status])
  @@index([assignedDoctorId])
  @@index([lastName, firstName])
  @@map("patients")
}

// ============================================================================
// DOCUMENT — metadata only; raw file lives in Dropbox
// ============================================================================

model Document {
  id String @id @default(cuid())

  // Link to patient (nullable so we can have templates/drafts w/o a patient yet)
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  // Document metadata
  title         String
  /// Short descriptor: "LESI", "CESI", "CE PRP", "LFB", "Consult Note", etc.
  procedureType String?
  status        DocumentStatus @default(DRAFT)

  // === INLINE CONTENT (for AI-dictated clinical notes) ===
  // Text-only notes (SOAP format, dictated via Whisper + GPT) are stored here.
  // Large binary files (scans, DOCX uploads) still live in Dropbox via the
  // fields below. A document has EITHER `content` OR `dropbox*`, not both.
  content String? @db.Text

  // === DROPBOX INTEGRATION ===
  // We do NOT store the file in PostgreSQL. Dropbox holds the actual bytes,
  // encrypted at rest with our BAA-covered Dropbox Business account.
  /// Dropbox file ID (preferred — stable across moves/renames)
  dropboxFileId String?
  /// Dropbox shared/temporary URL. Regenerate on-demand; do not cache forever.
  dropboxUrl    String?
  /// Path in Dropbox for administrative reference
  dropboxPath   String?

  // Integrity
  /// SHA-256 hash of the file (set after upload) to detect tampering
  fileHash      String?
  fileSizeBytes Int?
  mimeType      String?

  // Audit trail
  createdById String?
  createdBy   User?   @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("DocumentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete — do not hard-delete for HIPAA retention (6 years minimum)
  deletedAt DateTime? @db.Timestamptz(6)

  // --- M6 provenance + idempotency ---
  /// The Scribe ScribeOutput.id that produced this Document (null for
  /// non-Scribe documents). Populated when the Scribe Sign flow creates
  /// Referral-letter Documents in MedDoc Pro. See M6 D2 + D6.
  sourceScribeOutputId String?
  /// Index WITHIN the source output when that output fans out to multiple
  /// Documents (one ScribeOutput REFERRAL → N referral letters → N
  /// Documents). Null for non-Scribe / non-fan-out documents.
  sourceItemIndex      Int?

  // Composite unique so an M6 push retry doesn't create a duplicate letter.
  // Both nullable → Postgres treats NULL,NULL as distinct, so non-Scribe
  // Documents are unconstrained. The endpoint returns the existing row's
  // id on unique-violation.
  @@unique([sourceScribeOutputId, sourceItemIndex], name: "document_scribe_source_unique")
  @@index([patientId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("documents")
}

// ============================================================================
// AUDIT LOG — immutable append-only trail (HIPAA §164.312(b))
// ============================================================================
//
// Rules:
//  - ONLY insert; never update or delete (enforce via DB role grants in prod)
//  - One row per sensitive action
//  - Captures who / what / when / where (IP + user agent)
//  - `targetId` + `targetType` form a polymorphic pointer so we can log any entity
//  - Keep 6+ years (HIPAA retention) — archive cold rows to S3 Glacier quarterly
// ============================================================================

model AuditLog {
  id String @id @default(cuid())

  // WHO — nullable because auth-failure events have no authenticated user yet
  userId            String?
  user              User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Denormalized email snapshot in case the user record is later deactivated
  userEmailSnapshot String?

  // WHAT — action taken + polymorphic target
  action     AuditAction
  /// ID of the record acted upon (patient id, document id, user id, etc.)
  targetId   String?
  /// Type of the target record, e.g. "Patient", "Document", "User"
  targetType String?

  // WHERE — network context
  ipAddress String? @db.Inet
  userAgent String?

  // WHY / CONTEXT — free-form JSON for request details
  // NEVER put raw PHI here. Use field names, not values. e.g. { "changedFields": ["firstName"] }
  metadata Json?

  // Outcome — did the action succeed?
  success   Boolean @default(true)
  /// If success=false, short error code (e.g., "MFA_REQUIRED", "FORBIDDEN")
  errorCode String?

  // WHEN — immutable timestamp
  timestamp DateTime @default(now()) @db.Timestamptz(6)

  // === Tenant ===
  // Auth-failure events with unknown emails still need a practice; Phase 2
  // will route those to a designated "platform" practice. For now,
  // practiceId is mandatory and Phase-1 backfill assigns everything to
  // clinic_main.
  /// S4c — NULLABLE + SetNull. An audit row must outlive the practice it
  /// describes: deleting an account must never delete its audit trail, and a
  /// RESTRICT here made account deletion impossible instead. The tenant is
  /// preserved in practiceIdSnapshot below, which carries no FK.
  practiceId         String?
  practice           Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  /// Tombstone: the practice id as it was at write time. Survives the practice
  /// row itself, so "which tenant did this happen in" stays answerable after a
  /// deletion. Same role userEmailSnapshot plays for the user.
  practiceIdSnapshot String?

  @@index([practiceId])
  @@index([userId])
  @@index([action])
  @@index([targetId])
  @@index([timestamp])
  // Composite for "show me everything user X did to patient Y" queries
  @@index([userId, targetId, timestamp])
  @@map("audit_logs")
}

// ============================================================================
// APPOINTMENT — patient visit scheduling
// ============================================================================

model Appointment {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Doctor / provider who owns this appointment
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Scheduled date + time (stored as a single timestamp in UTC)
  scheduledAt DateTime @db.Timestamptz(6)

  status AppointmentStatus @default(SCHEDULED)
  type   VisitType         @default(CONSULTATION)

  /// Optional free-text notes about the visit (non-PHI — just "3rd LESI follow-up")
  notes String?

  /// AI-generated prep briefing for the doctor (2-bullet summary of past notes)
  aiPrepNote String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([patientId])
  @@index([userId])
  @@index([scheduledAt])
  @@map("appointments")
}

// ============================================================================
// ALLERGY — patient drug/food/environmental allergies
// ----------------------------------------------------------------------------
// Safety-critical for pain practices: lidocaine, contrast media, latex,
// steroids, NSAIDs are all on the procedure-day path. SEVERE rows surface
// in the patient header banner so the doctor can't miss them.
//
// practiceId is denormalized (also derivable from patientId.practiceId) so
// adversarial cross-tenant queries can be checked at the row level without
// trusting a JOIN — defense in depth on clinical safety data.
// ============================================================================

model Allergy {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// What the patient is allergic to (drug, food, environmental). Free-text
  /// so we can capture brand names, classes ("NSAIDs"), and combinations
  /// without forcing an upstream coded vocabulary.
  allergen String

  /// Observed reaction — e.g. "hives", "anaphylaxis", "GI upset". Optional
  /// because some allergies are reported by the patient without detail.
  reaction String?

  severity AllergySeverity @default(UNKNOWN)

  /// Free-text clinician notes (verification source, last review date, etc.).
  notes String? @db.Text

  // === Tenant ===
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  // Audit trail
  createdById String?
  createdBy   User?   @relation("AllergyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("AllergyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete — never hard-delete clinical safety data (HIPAA retention).
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([patientId])
  @@index([practiceId])
  @@index([severity])
  @@map("allergies")
}

// ============================================================================
// MEDICATION — current and historical patient medications
// ----------------------------------------------------------------------------
// Active meds matter for procedure planning (anticoagulants must be held
// before injections; opioids signal pain trajectory). Historical rows stay
// (isActive=false) so the doctor can see what was tried and stopped.
//
// practiceId denormalized for the same defense-in-depth reason as Allergy.
// ============================================================================

model Medication {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Drug name as the doctor wrote it. Free-text — no NDC / RxNorm
  /// integration in MVP. Brand or generic, doctor's choice.
  name String

  /// Dose strength + form, e.g. "5mg tablet", "500mg/5mL", "0.5%". Optional.
  dosage String?

  /// Frequency / schedule — e.g. "twice daily", "PRN", "q6h", "once weekly".
  /// Free-text; medication regimens don't fit a closed enum well.
  frequency String?

  /// Whether the patient is currently taking this. false = past medication
  /// kept for chart history. The UI defaults to showing only isActive=true
  /// with a toggle to reveal stopped meds.
  isActive Boolean @default(true)

  /// Free-text clinician notes (indication, prescriber, response, etc.).
  notes String? @db.Text

  // === Tenant ===
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  // Audit trail
  createdById String?
  createdBy   User?   @relation("MedicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("MedicationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete — never hard-delete clinical safety data.
  deletedAt DateTime? @db.Timestamptz(6)

  /// M6 provenance — when this medication was created from a Scribe
  /// visit's Rx draft push, this points at the ScribeOutput.id. NULL for
  /// manually-entered meds. Application-level dedup compares
  /// (patientId, sourceScribeOutputId, lower(trim(name))) before insert.
  sourceScribeOutputId String?

  @@index([patientId])
  @@index([practiceId])
  @@index([isActive])
  @@index([sourceScribeOutputId])
  @@map("medications")
}

// ============================================================================
// TASK — CRM task/to-do items (M6 "CRM loop-closing")
// ----------------------------------------------------------------------------
// Created by Scribe's Sign flow for follow-up items extracted from the SOAP
// plan ("schedule follow-up in 3 months", "order A1c in 6 weeks"). Also
// open for manual creation via the CRM UI in later milestones.
//
// sourceScribeOutputId + sourceItemIndex together form the idempotency key
// so a sign-retry never double-creates. Each SOAP output can fan out to
// multiple Task rows (one per plan action item), each at its own index.
// ============================================================================

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Who's responsible. Defaults to the visit clinician when a Task is
  /// created from a Scribe sign; manual tasks pick their own assignee.
  /// Nullable so unassigned tasks are supported.
  assignedUserId String?
  assignedUser   User?   @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  /// Who created this task. Same user the sign API was called as, or the
  /// manually-creating clinician. Null if the creator was later deleted.
  createdByUserId String?
  createdByUser   User?   @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  title       String
  description String? @db.Text

  status TaskStatus @default(OPEN)
  dueAt  DateTime?  @db.Timestamptz(6)

  /// Source ScribeVisit this task came from, for provenance + cross-linking.
  /// Nullable because future manual-CRM tasks won't have one.
  sourceVisitId        String?
  /// Source ScribeOutput.id — the exact row whose content produced this task.
  sourceScribeOutputId String?
  /// Index within the source output when one output fans out to multiple
  /// tasks. Paired with sourceScribeOutputId for a composite unique.
  sourceItemIndex      Int?

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  completedAt   DateTime? @db.Timestamptz(6)
  completedById String?

  // Idempotency for M6 Scribe Sign → Task creation. Nullable pair, so
  // non-Scribe manual tasks are unconstrained.
  @@unique([sourceScribeOutputId, sourceItemIndex], name: "task_scribe_source_unique")
  @@index([practiceId, status, dueAt])
  @@index([patientId])
  @@index([assignedUserId])
  @@index([sourceVisitId])
  @@map("tasks")
}

// ============================================================================
// BILLING EVENT — ICD-10 + CPT bundle for one clinical encounter (M6)
// ----------------------------------------------------------------------------
// Created by Scribe's Sign flow from the ICD10_CPT ScribeOutput. Defaults
// to PENDING_REVIEW so billing ops can eyeball before external claim
// submission (which remains external to this system — we don't emit 837P).
// ============================================================================

enum BillingEventStatus {
  PENDING_REVIEW
  SUBMITTED
  PAID
  DENIED
}

model BillingEvent {
  id String @id @default(cuid())

  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Clinician this encounter is billed under (source of truth for the claim).
  clinicianUserId String?
  clinicianUser   User?   @relation("BillingClinician", fields: [clinicianUserId], references: [id], onDelete: SetNull)

  /// JSON array of { code, description, evidence_quote, confidence }. Mirrors
  /// CodingOutput.icd10 from @meddoc/types.
  icd10Items Json
  /// JSON array of the same shape for CPT/E&M + modifiers.
  cptItems   Json

  status BillingEventStatus @default(PENDING_REVIEW)

  sourceVisitId        String?
  /// One BillingEvent per Scribe coding output — hence @unique, not composite.
  sourceScribeOutputId String? @unique

  submittedAt   DateTime? @db.Timestamptz(6)
  submittedById String?
  submittedBy   User?     @relation("BillingSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([practiceId, status, createdAt])
  @@index([patientId])
  @@index([sourceVisitId])
  @@map("billing_events")
}

// ============================================================================
// SESSION LOG — tracks login activity for admin dashboard
// ============================================================================

model SessionLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  action    String  @default("LOGIN")

  // === Tenant ===
  // Always derivable from userId but denormalized for fast per-practice queries.
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([practiceId])
  @@index([userId])
  @@index([createdAt])
  @@map("session_logs")
}

// ============================================================================
// API USAGE LOG — tracks OpenAI token consumption & costs
// ============================================================================

model ApiUsageLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  model         String // e.g., 'gpt-4o-mini', 'whisper-1'
  tokensUsed    Int
  estimatedCost Float // USD
  action        String // e.g., 'DICTATION', 'CLINICAL_NOTE', 'DOCUMENT_GEN', 'AI_PREP'

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([createdAt])
  @@map("api_usage_logs")
}

// ============================================================================
// ApiUsage — feature-hit counter for admin monitoring
// ----------------------------------------------------------------------------
// One row per authenticated successful API call, tagged with a semantic
// feature name (e.g. "TRANSCRIBE", "DOC_EDITOR") rather than the raw route
// path — survives route renames and reads cleanly in the admin UI.
//
// Thinner than ApiUsageLog (which tracks AI model cost): this table just
// counts "user X used feature Y at time Z" so the Metrics page can show
// top consumers and per-feature traffic. `tokens` is optional — populated
// only when the caller knows the token count.
// ============================================================================

model ApiUsage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature String // e.g., "TRANSCRIBE", "DOC_EDITOR"

  // Cost-estimation inputs. Populated per-feature:
  //   TRANSCRIBE  → durationSeconds (from Whisper verbose_json.duration)
  //   DOC_EDITOR  → tokens (from OpenAI response.usage.total_tokens)
  // Either can be null if capture failed — the metrics page falls back
  // to a flat per-hit baseline rather than lying about the number.
  tokens          Int?
  durationSeconds Int?

  // === Tenant ===
  // Denormalized from user.practiceId so per-practice cost rollups
  // don't need a user join.
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([practiceId])
  @@index([userId])
  @@index([createdAt])
  @@map("api_usage")
}

// Per-model-call log for cost + latency observability. No PHI — promptHash
// stores a SHA-256 of the prompt content, not the prompt itself.
model AiCall {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  /// Optional — holds a TranscribeVisit.id (T-M4+) or historical
  /// ScribeVisit.id (pre-removal). No FK relation after the Scribe
  /// models were dropped; treat as a loose nullable pointer.
  visitId String?

  /// "cleanup" | "soap" | "coding" | "rx" | "referral" | "summary"
  purpose    String
  /// "openai" | "anthropic" | "deepgram"
  provider   String
  model      String
  /// SHA-256 of the prompt content. Lets us correlate retries without
  /// storing the (potentially PHI-laden) prompt text.
  promptHash String

  latencyMs                Int
  inputTokens              Int?
  outputTokens             Int?
  /// Anthropic prompt-caching: tokens read from the cache for this call.
  /// Billed at 0.10x the model's base input rate (90% discount). Default
  /// 0 so historical rows + non-Anthropic providers don't carry NULL
  /// surprise; columns added 2026-05-12 alongside the costUsdCents
  /// pricing refresh (Opus 4.7 $15/$75 → $5/$25 fix). Only populated
  /// when the call attached `cache_control`; everything else is 0.
  cacheReadInputTokens     Int  @default(0)
  /// Anthropic prompt-caching: tokens written into the cache for this call.
  /// Billed at 1.25x the model's base input rate (5-min ephemeral) or
  /// 2x (1-hour). The schema doesn't distinguish TTL because the SDK
  /// returns a single `cache_creation_input_tokens` and the multiplier
  /// is decided at billing time based on the request's `cache_control`
  /// type — currently always `ephemeral` in our code, so the 1.25x
  /// multiplier is applied. If we ever opt into 1-hour caches, the
  /// dispatcher reads `metadata.cacheTtl` to choose 2x instead.
  cacheCreationInputTokens Int  @default(0)
  /// Integer cents so we can sum without float drift.
  costUsdCents             Int?

  success      Boolean
  errorCode    String?
  /// T-M17.1: raw model response body on failed calls, capped at ~10 KB
  /// by the writer. NULL on success. May contain PHI (same envelope as
  /// transcribe_visits columns). Not surfaced in UI; psql-only.
  errorDetails String? @db.Text

  /// B1-a — THE VENDOR'S OWN CORRELATION ID for this call, verbatim.
  ///
  /// Anthropic: `response._request_id` (the `request-id` response header).
  /// Deepgram:  `metadata.request_id`.
  ///
  /// ⚠️ NULLABLE, AND IT WILL STAY NULLABLE. Three distinct reasons, none of
  /// which a backfill can remove:
  ///   1. the 1122 rows that predate the column have no id and never will;
  ///   2. Anthropic's value is `headers.get('request-id')`, which is `null`
  ///      when the header is absent — a call can genuinely succeed without one;
  ///   3. not every provider that writes here supplies an id at all.
  ///
  /// ⚠️ AND IT IS NEVER FABRICATED. NULL means "the vendor did not tell us",
  /// which is a fact worth storing; a `randomUUID()` here would be
  /// indistinguishable from a real vendor id one row later, which is the
  /// fail-open shape ruled against on 2026-08-08 ("A provenance column's
  /// DEFAULT must never be the TRUSTED value").
  ///
  /// Unambiguous BY CONSTRUCTION on this table specifically: `ai_calls` is a
  /// REAL-VENDOR-CALLS-ONLY table (B0 Q1, `log.ts` header), so a non-null value
  /// here is always a real vendor's id.
  ///
  /// ⚠️ `api_usage_events.requestId` NOW HAS THE SAME PROPERTY, by a different
  /// route — B1-b step 2 (`20260809100000_b1b_request_id_nullable`). It could
  /// not inherit this table's construction argument, because it DOES carry mock
  /// rows; instead a CHECK ties the id to the provenance
  /// (`requestId IS NOT NULL ⇒ unitsSource = 'vendor'`) and the builders no
  /// longer mint. Both tables now answer "is this a real vendor id?" with yes,
  /// and neither answers it by convention.
  requestId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([practiceId, purpose, createdAt])
  @@index([visitId])
  @@map("ai_calls")
}

// ============================================================================
// TRANSCRIBE-MD (T-M2)
// ----------------------------------------------------------------------------
// Standalone solo-doctor app. Visits here are owned by a User (not scoped to
// a Practice at the query layer); for solo users the Practice is a synthetic
// 1:1 container created at signup, so tenant scoping still works if we ever
// reuse Practice-aware code paths. Most of the fields stay nullable because
// T-M2 only ships the shell — the audio / SOAP / coding pipelines land in
// T-M4 onwards.
// ============================================================================

/// T-M4: the lifecycle states for a TranscribeVisit. QUEUED covers
/// "created, waiting for audio or a mode-specific input" (which is why
/// the T-M2 "draft" rows are migrated here in the same migration).
/// The pipeline walks through TRANSCRIBING → EXTRACTING → DRAFTING →
/// CRITIQUING → POLISHING → READY on the happy path. FAILED is terminal
/// until the user retries. SIGNED freezes the note (see signedSoap).
enum TranscribeVisitStatus {
  QUEUED
  TRANSCRIBING
  EXTRACTING
  DRAFTING
  CRITIQUING
  POLISHING
  /// T-M6: parallel automation layers (ICD/CPT/Rx/Referrals/Summary).
  /// Runs after POLISHING. Layer failures are isolated; the visit still
  /// reaches READY even if a subset of automation layers error.
  AUTOMATING
  READY
  FAILED
  SIGNED
}

// ============================================================================
// TRANSCRIBE-MD PATIENT — standalone patient record for TranscribeMD
// ----------------------------------------------------------------------------
// T-M17.2. Distinct from the CRM `Patient` model (schema.prisma above):
//   - Scoped to Practice (for solo-TranscribeMD users the Practice is
//     the 1:1 synthetic signup practice; forward-compatible with
//     multi-seat practices).
//   - Full DOB is OK here — TranscribeMD has no DrChrono sync that would
//     make Safe Harbor birthYear-only the right call, and full DOB is
//     the medical workflow standard doctors expect.
//   - Soft-deletable: `deletedAt IS NOT NULL` hides the patient from
//     search + lists; linked TranscribeVisit rows keep the FK intact.
// ============================================================================

/// ⚠️ Carries `@@unique([id, practiceId])` — see the note on that line. It is
/// the target of `TranscribeVisit`'s composite FK and is what makes a
/// cross-practice visit impossible at the storage layer.
model TranscribeMdPatient {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  /// Single-string display name. The UI renders as-is — there is no
  /// first/last split. Doctors dictate "John Smith" or "Patient MRN
  /// 4821" and that's the identifier carried through the pipeline.
  name String

  /// Full DOB. NULL for patients backfilled from legacy visits where
  /// the doctor never entered a DOB; new patients created through the
  /// T-M17.2 UI require this.
  dateOfBirth DateTime? @db.Date

  /// Optional external / practice-internal ID (EMR MRN, chart number,
  /// etc). No uniqueness constraint — doctors sometimes reuse or
  /// leave blank.
  externalId String?

  // === app-redesign-v1 — patient header + problem list ===
  /// Medical record number as shown on the patient header. Distinct
  /// from `externalId` (which is a generic EMR pointer) — MRN is the
  /// clinic-internal identifier doctors read back to patients. Kept
  /// nullable: older patients created before the header redesign do
  /// not have one.
  mrn         String?
  /// Free-text insurance descriptor rendered on the patient header
  /// ("Aetna PPO", "Self-pay"). No structured payer lookup yet; the
  /// redesign's "Edit patient" drawer writes whatever the doctor types.
  insurance   String?
  /// Running problem list rendered as chips on the patient header.
  /// Shape: [{ condition: string, status: 'active'|'resolved'|'chronic',
  /// icd10?: string }]. Phase 1 writes plain-text `icd10` from a free-
  /// text input; the ICD-10 lookup UI lands in a later pass.
  problemList Json?

  /// Round 3 PR-D — patient weight in kilograms. Required for peds
  /// mg/kg dose validation in the Rx safety floor (audit A06-P0-004).
  /// Nullable: legacy patients have no weight, and adult patients can
  /// skip weight without blocking the pipeline. Range guard at write
  /// time: 0.5 .. 200 kg (covers neonate → bariatric).
  weightKg Float?

  /// Round 3 PR-D — explicit allergy list for Rx safety class match
  /// (audit A06-P0-004). Free-text strings for now; structured RxNorm
  /// allergen-class lookup is Phase 7 scope. Empty array = "no known
  /// allergies"; null = "not asked yet" (distinct from "none").
  allergies String[] @default([])

  /// Soft-delete marker. Deleted patients are hidden from the
  /// dashboard + search, but their visits remain intact. Hard delete
  /// is not exposed in the UI.
  deletedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Visits linked to this patient. FK points here; delete is RESTRICT
  /// (hard-deleting a patient with visits requires deleting the visits
  /// first — soft-delete is the expected path).
  transcribeVisits TranscribeVisit[]

  /// ⚠️ T3 — THE TARGET OF TranscribeVisit's COMPOSITE FK. `id` alone is already
  /// unique (it is the PK), so this adds no uniqueness. It exists because
  /// Postgres will not accept a composite foreign key unless the referenced
  /// columns carry a UNIQUE together — and that FK is what makes a visit whose
  /// practice differs from its patient's UNREPRESENTABLE rather than merely
  /// discouraged. Removing this line silently removes that guarantee.
  @@unique([id, practiceId])
  @@index([practiceId, deletedAt])
  // Trigram GIN index for fuzzy name search is added by the migration
  // SQL directly (Prisma doesn't natively express `USING gin (LOWER(name)
  // gin_trgm_ops)`). See migration 20260420_*_add_transcribe_md_patients.
  @@map("transcribe_md_patients")
}

model TranscribeVisit {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// T-M17.2: link to the TranscribeMdPatient. Tightened to NOT NULL
  /// by migration 20260420192818 after the full patient-aware code
  /// path (backend + UI) was live and confirmed to write the FK on
  /// every insert.
  patientId String
  patient   TranscribeMdPatient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// T3 — the visit's tenant. DERIVED FROM THE PATIENT, never from the author.
  ///
  /// A note belongs to the practice that owns the CHART: a locum from practice
  /// B seeing a patient of practice A creates a note in A. Deriving from
  /// `user.practiceId` would file it in B and split that patient's history
  /// across tenants. Both paths agreed on all 26 rows at migration time and
  /// NOTHING kept them agreeing — hence the explicit choice, and the composite
  /// FK below that makes the alternative unrepresentable.
  practiceId String
  /// ⚠️ THIS RELATION IS A LIE THE DATABASE DOES NOT TELL, AND IT IS DELIBERATE.
  /// Prisma renders it as a SIMPLE FK on `practiceId`. Postgres holds a
  /// COMPOSITE one instead, and there is no Prisma syntax for a composite FK:
  ///
  ///   transcribe_visits_patientId_practiceId_fkey
  ///     FOREIGN KEY ("patientId", "practiceId")
  ///     REFERENCES transcribe_md_patients(id, "practiceId")
  ///     ON UPDATE CASCADE ON DELETE RESTRICT
  ///
  /// That composite is what makes a visit whose practice differs from its
  /// patient's UNREPRESENTABLE — not discouraged, unrepresentable. A simple
  /// `practiceId → practices(id)` FK checks only that the practice EXISTS, which
  /// every wrong value also satisfies.
  ///
  /// ⚠️ SO `prisma migrate diff` REPORTS A DIFFERENCE HERE, PERMANENTLY, AND
  /// APPLYING IT WOULD DELETE T3's ENTIRE GUARANTEE. Measured 2026-08-07 against
  /// a database with every migration applied, the generated script says:
  ///
  ///   ALTER TABLE "transcribe_visits" DROP CONSTRAINT "transcribe_visits_patientId_practiceId_fkey";
  ///   ALTER TABLE "transcribe_visits" ADD  CONSTRAINT "transcribe_visits_practiceId_fkey" …
  ///
  /// It reads like tidying drift. It is the removal of the only thing standing
  /// between a mis-derived write and a note filed under the wrong tenant.
  /// **NEVER apply that hunk.** This is the same class as the T4-b ruling, where
  /// the prescribed drift "fix" would have broken production: check what the
  /// constraint actually SAYS before declaring you are merely writing it down.
  practice   Practice @relation(fields: [practiceId], references: [id])
  /// T4 — who CREATED this visit. Same value as `userId` today; the separate
  /// column is what lets `userId` come to mean "owner" without rewriting the
  /// record of who made it.
  createdBy  String
  creator    User     @relation("VisitCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  /// T4 — who SIGNED it. NULL until signed, and NULL is honest: an unsigned
  /// visit has no signer and a sentinel would be a lie about attestation.
  ///
  /// ⚠️ A SIGNATURE WITHOUT A SIGNER IS UNREPRESENTABLE, not merely avoided:
  /// the migration adds CHECK ("signedAt" IS NULL OR "signedBy" IS NOT NULL).
  /// Stamped server-side from the session in the same statement as `signedAt`
  /// (`api/visits/[id]/sign/route.ts`) — never from a request body.
  signedBy String?
  signer   User?   @relation("VisitSignedBy", fields: [signedBy], references: [id], onDelete: Restrict)

  /// Legacy free-text patient name — kept nullable through T-M17.2
  /// because some older visits never set it. After the Phase 1
  /// backfill this is superseded by the `patient` relation, but we
  /// retain the column for one release as a safety net in case a
  /// visit ends up with `patientId = NULL` through some unexpected
  /// path. Remove in a follow-up once Phase 3 is battle-tested.
  patientName    String?
  specialty      String
  chiefComplaint String?

  /// "audio_upload" | "voice_dictation" | "text_notes" — chosen at /visits/new.
  inputMode String
  /// Drives the /visits/[id] UI + the worker pipeline dispatch. See the
  /// TranscribeVisitStatus comment above.
  status    TranscribeVisitStatus @default(QUEUED)

  audioKey              String?
  /// PR-L follow-up: which provider produced the transcript on the
  /// most-recent (re-)processing pass. Set by the transcribe()
  /// orchestrator in `worker/layers/01-transcribe.ts` (and 01b for
  /// dictation). Values:
  ///   - 'deepgram-batch'    — primary path (best clinical-domain
  ///                          quality + speaker diarization).
  ///   - 'whisper-fallback'  — Deepgram primary failed; Whisper
  ///                          saved the visit. Triggers a
  ///                          TRANSCRIPTION_PROVIDER_FALLBACK audit
  ///                          row + the visit is auto-flagged for
  ///                          review (no diarization on Whisper).
  ///   - null                — pre-orchestrator visits (legacy).
  transcriptionProvider String?
  /// 2026-05-12 interpreter-mode (Sylvia incident follow-up).
  /// True when the doctor checked "With interpreter?" on /visits/new
  /// for an audio/dictation visit. Drives L1 model choice (Nova-3
  /// multilingual instead of nova-3-medical English-only) +
  /// diarization-speaker-count hint (3 instead of 2) + L2/L4 prompt
  /// branches that consolidate the interpreter's English voice with
  /// the patient's intent in the SOAP narrative. Default false.
  interpreterMode       Boolean @default(false)
  /// IETF language tag returned by Deepgram's detect_language pass
  /// (e.g. 'en', 'es', 'multi'). Populated by L1 when interpreterMode
  /// is true. Null on visits where detection wasn't requested. Used
  /// by future surfaces (soft-banner offering reprocess in
  /// interpreter mode if a non-en language was detected on a
  /// non-interpreter visit) — but the column is added now so existing
  /// rows don't need a backfill later.
  detectedLanguage      String?
  transcriptText        String? @db.Text
  /// Line-level SOAP content (app-redesign-v1+). Each section's value
  /// is either a legacy string OR an array of line objects with the
  /// shape:
  ///   { text: string,
  ///     source: 'transcript'|'emr'|'template'|'doctor-edit',
  ///     transcriptTurnIds?: number[],
  ///     confidence?: number,    // 0..1 — drives low-confidence highlight
  ///     editedAt?: DateTime }
  /// The visit UI reads `soapNote` when populated and falls back to
  /// `soapFinal` (plain markdown) otherwise. Writers MUST treat both
  /// shapes as valid and never overwrite an array with a string.
  /// Repurposed from the original T-M2 placeholder — the ICD coding
  /// pass this was reserved for ultimately landed in `icdCodes`.
  soapNote              Json?
  icdCodes              Json?
  /// F8-S1 — the DOCTOR's accept/reject over the suggested ICD-10 codes.
  /// Shape: `{ "<CODE>": { state: "accepted"|"rejected", at: ISO, byUserId } }`.
  ///
  /// ⚠️ A SEPARATE COLUMN ON PURPOSE, AND `icdCodes` IS WHY.
  /// `worker/layers/07a-icd-coding.ts:570-573` REPLACES `icdCodes` wholesale
  /// (`data: { icdCodes: filtered }`, never a merge), so anything hung off that
  /// blob is whatever the last L7a run says it is. A separate column removes
  /// the coupling instead of relying on L7a never running again. The
  /// suggester's output and the physician's decision are also two different
  /// records, and a coding dispute needs them kept apart.
  /// (⚠️ L7a is in fact SKIPPED whenever `icdCodes` has content —
  /// `worker/layer-skip.ts:101` — so no shipped path rewrites it today. That is
  /// a property to preserve, not a reason to merge the columns.)
  ///
  /// NULL = the doctor has never decided anything on this visit. `{}` = they
  /// decided and then cleared, which is a different fact and stays legible.
  /// Nullable by design — no write-path sweep is owed (AGENTS.md's required-
  /// column rule is scoped to NOT NULL).
  ///
  /// Read/written ONLY through `lib/icd-decisions.ts`; a decision on a code the
  /// suggester did not propose is refused there, and a decision whose code later
  /// vanishes from `icdCodes` projects into the named `orphaned` bucket rather
  /// than into `accepted`.
  icdDecisions          Json?
  cptCodes              Json?
  rxDrafts              Json?
  referrals             Json?
  /// Hybrid anchored generation (2026-06-11, flag-gated): claims the
  /// fail-closed verifier demoted from the note body — rendered in the
  /// "Suggested by AI — not stated in this visit" lane for explicit doctor
  /// adoption. Shape: [{text, reason, section, anchor}]. NULL when the flag
  /// is off or nothing was demoted.
  suggestedClaims       Json?
  /// E/M recompute on adoption — visible-confirm gate (2026-06-12, prod
  /// smoke #311). Set by the adopt/dismiss suggestion actions when the
  /// action changed the computed E/M level. Shape: { from, to, cause, at,
  /// acknowledgedAt? } — CPT codes + cause class + ISO timestamps only,
  /// NEVER note text. An entry WITHOUT acknowledgedAt blocks
  /// POST /api/visits/[id]/sign until the doctor explicitly confirms the
  /// new level; the winning READY→SIGNED transition stamps acknowledgedAt.
  /// NULL when no suggestion action has changed the level.
  emPendingChange       Json?

  /// The note CHANGED since the E/M level was last validated.
  ///
  /// Every content mutation a doctor can make sets this — a draft save (the
  /// inline editor, tap-to-edit and the chat's section edit all funnel
  /// through it), adopting a suggestion, and applying E/M additions. The
  /// sign route refuses while it is true, so there is exactly ONE semantics
  /// for a changed note whether a human or a model changed it.
  ///
  /// Cleared by a re-score: the level either moved (and the existing confirm
  /// card asks for acknowledgement, unchanged) or it did not (and the flag
  /// simply clears). Fail-closed: the default for a note nobody has
  /// re-scored is "needs validation", not "fine".
  emStale Boolean @default(false)

  /// The E/M code the level was last VALIDATED at.
  ///
  /// The displayed level is recomputed on read and never persisted, so a
  /// re-score had nothing to compare against: it scored the current note,
  /// called that the baseline, and concluded nothing had moved — every time.
  /// The gate cleared itself. This is the missing "before".
  ///
  /// Null means never validated; the first re-score establishes it rather than
  /// inventing a movement it cannot substantiate.
  emScoredCode     String?
  patientSummary   String? @db.Text
  confidenceScores Json?

  // ── T-M4: audio metadata ──
  audioMimeType    String?
  audioSizeBytes   Int?
  /// Populated by Layer 1 (Deepgram) after parse. Used for cost math.
  audioDurationSec Int?
  audioUploadedAt  DateTime?

  /// Aggregated Deepgram per-utterance confidence — populated by Layer 1
  /// after batch transcribe. Null for non-audio modes (text_notes) and
  /// dictation runs that disabled utterance segmentation. Round 3 quality
  /// fix-pack Q0-5. Shape:
  ///   { mean: number,            // 0..1
  ///     median: number,          // 0..1
  ///     p10: number,             // 0..1 — bottom-decile utterance
  ///     lowConfPct: number,      // 0..100 — utterances < threshold
  ///     lowConfCount: number,
  ///     totalUtterances: number,
  ///     threshold: number }      // = LOW_CONFIDENCE_THRESHOLD (0.6)
  /// L4 + L5 read this through the worker; when median < 0.55 OR
  /// lowConfPct > 30, those layers expand their prompts to hedge
  /// language and the worker also flips needsReview so the doctor
  /// sees a banner before signing. Closes audit Findings 02.5 + 07.3.
  audioConfidenceStats Json?

  /// 2026-05-13 Issues #202 + #206 — keyterm composition that ran
  /// on this visit's L1 / L1b transcription. Populated by the
  /// layer after a successful Deepgram call. Shape (per
  /// `KeytermsAppliedMetadata` in deepgram-keyterm-builder.ts):
  ///   { specialty, rawSpecialty, layers: { core, specialty,
  ///     safetyFloor, patientContext }, totalTerms,
  ///     estimatedTokens, budgetEnforced, termsHash }
  /// Used for audit attribution — if a future transcription
  /// regression appears, the row says which keyterms ran.
  /// Null on interpreter-mode visits (model swap; no keyterm
  /// bias). Never includes PHI.
  keytermsApplied Json?

  // ── T-M5: dictation + text inputs ──
  /// MinIO object key for a voice dictation recording (inputMode
  /// voice_dictation). Separate column from audioKey so a future
  /// "dictate an addendum to an uploaded visit" flow can carry both.
  dictationAudioKey    String?
  dictationDurationSec Int?
  /// Raw bullet-point / prose text when inputMode = text_notes.
  /// 5000-char soft cap enforced at the action boundary; using
  /// @db.Text here so a doctor pasting a long clinical paragraph
  /// doesn't hit Postgres's default VARCHAR(255).
  rawTextInput         String? @db.Text

  // ── T-M4: pipeline artifacts (one field per layer) ──
  /// Full Deepgram response JSON. Used by Layers 2-5 + the Pipeline tab.
  transcriptRaw  Json?
  /// Layer 2 output — {"0":{"role":"doctor","confidence":0.9,"reasoning":"..."}, ...}
  speakerMap     Json?
  /// Layer 3 output — structured entities with evidence_quote + speaker + ts.
  entities       Json?
  /// Layer 4 output — markdown SOAP draft. Editable until signed.
  soapDraft      String? @db.Text
  /// Layer 5 output — {issues:[], overall_quality, safe_to_sign_without_review}
  critique       Json?
  /// Layer 6 output — the version the UI shows + the doctor edits.
  soapFinal      String? @db.Text
  /// T-M14.1: immutable snapshot of Layer 6 output, written once by
  /// runLayer6Polish alongside soapFinal. soapFinal gets overwritten
  /// when the doctor edits; soapL6Original does not. Used by the
  /// sign-time capture hook to record (original_ai, doctor_edited)
  /// pairs into DoctorEditPattern. Nullable for pre-T-M14 visits —
  /// the capture hook skips those.
  soapL6Original String? @db.Text

  /// Round 3 PR-E (A09-P0-003) — optimistic-concurrency token for
  /// soapFinal edits. Two doctors editing the same SOAP in parallel
  /// previously overwrote each other silently (last-write-wins).
  /// `saveSoapDraftAction()` now passes the loaded version as
  /// `expectedSoapVersion`; the update uses an atomic `updateMany`
  /// with `WHERE soapVersion = expected` and increments on success.
  /// A mismatch returns a 409-shaped result so the client can
  /// surface "another edit happened, reload to see".
  soapVersion Int @default(1)

  /// ⚠️ THE DOCUMENT THIS SIGNATURE FROZE — resolved by POINTER, never by lookup.
  ///
  /// Stamped INSIDE the CAS-guarded signature write, so the pointer and the
  /// signature are one write. NULL means the record was signed STYLED, and that
  /// is a deliberate recorded outcome rather than an absence of information.
  ///
  /// The SIGNED serve path reads ONLY this. A manifest that lands afterwards —
  /// an orphaned fill whose wait was abandoned — is therefore UNREACHABLE by
  /// construction, not merely refused: layer (a) makes the write impossible,
  /// this makes a write that slipped through inert.
  frozenFillManifestId String?
  frozenFillManifest   TemplateTwinFillManifest? @relation("VisitFrozenFill", fields: [frozenFillManifestId], references: [id], onDelete: SetNull)

  /// F24-S5. The clinician's own corrections to this visit's enumerated form
  /// controls. Read as an INPUT on every fill, and part of the manifest's bound
  /// identity, so a recompute re-applies them rather than reverting them.
  templateTwinFieldOverrides TemplateTwinFieldOverride[]

  // ── T-M4: review flag ──
  /// Layer 5/6 can set this when critical issues can't be auto-fixed,
  /// or Layer 2 can set it when any speaker's confidence < 0.7.
  needsReview  Boolean @default(false)
  /// Human-readable explanation surfaced in the UI banner.
  reviewReason String? @db.Text

  // ── voice-retry-robustness: failure categorization + manual-retry budget ──
  /// Classification of the most-recent terminal failure, written by the
  /// worker's catch block alongside reviewReason. Drives the
  /// VisitFailedView UI variant + admin-notify throttling. Null until
  /// the visit hits FAILED for the first time, and reset to null on
  /// the next successful run. One of: 'transient' | 'permanent' |
  /// 'provider_down'. Stored as text so we don't have to migrate an
  /// enum every time we add a category.
  failureCategory  String? @db.Text
  /// How many times the doctor has manually clicked "Try again" on
  /// this visit via /api/visits/[id]/retry. Hard-capped at
  /// MANUAL_RETRY_BUDGET in the route handler so a stuck-button
  /// loop can't drive runaway Anthropic / Deepgram spend.
  manualRetryCount Int     @default(0)

  // ── T-M4: pipeline telemetry ──
  processingStartedAt  DateTime?
  processingFinishedAt DateTime?
  /// Sum of AiCall.costUsdCents rows for this visit. Tracked per visit
  /// for unit-economics + per-user "notes remaining on plan" later.
  processingCostCents  Int?

  // ── T-M4: signing ──
  /// Frozen copy of the note at sign time. Immutable; doctor's edits
  /// after signing are rejected at the action layer.
  signedSoap String?   @db.Text
  signedAt   DateTime?

  // ── T-M7: delivery audit trail ──
  /// One row per export (clipboard paste, PDF download, DOCX download,
  /// email). Doesn't affect the pipeline — exists so the doctor +
  /// support can trace "where did this note go?" weeks later.
  deliveries VisitDelivery[]

  // ── rx-warning-card: override audit ──
  /// One row per critical Rx warning the doctor overrode with a
  /// typed reason. Critical warnings block signing by default;
  /// overriding is the explicit "sign anyway" escape hatch.
  rxWarningOverrides RxWarningOverride[]

  // ── T-M14.1: per-doctor edit tracking ──
  /// At most one row per visit, written at sign time when
  /// soapL6Original is populated. Optional so legacy visits (no
  /// original snapshot) and signed-with-capture-failure visits
  /// don't violate the relation.
  editPattern DoctorEditPattern?

  // ── T-M17.3: visit management ──
  /// Soft-delete marker for non-SIGNED visits. Rows with a non-null
  /// deletedAt are hidden from every default-view query and scheduled
  /// for hard delete 15 days later by the daily cleanup cron. A visit
  /// can be restored (deletedAt → NULL) up until that cron fires.
  /// SIGNED visits use `archivedAt` instead — clinical records never
  /// get soft-deleted per HIPAA retention.
  deletedAt  DateTime? @db.Timestamptz(6)
  /// Archive marker for SIGNED visits. Archived visits are hidden
  /// from the default dashboard but kept forever. Never nulled out
  /// via UI (an "Unarchive" action can clear it; has no retention
  /// consequence).
  archivedAt DateTime? @db.Timestamptz(6)

  // ── app-redesign-v1: recording + telemetry surfaces ──
  /// Seconds from `processingStartedAt` to `processingFinishedAt`,
  /// persisted for fast dashboard aggregates ("avg drafted-in" stat
  /// card) and for the Processing screen's ETA estimator. Redundant
  /// with the two timestamps above but cheaper than SUM/AVG over
  /// difference-of-timestamps on every dashboard render.
  draftedInSeconds Int?
  /// Doctor-tagged moments from the Live Recording screen. Shape:
  ///   [{ timestampMs: number, label?: string }]
  /// timestampMs is the offset from recording start, matching the
  /// transcript turn timeline so the Transcript tab can render a mark
  /// glyph at the right spot. `label` is optional free-text.
  markedMoments    Json?

  // ── Note-format customization provenance (Phase 0 foundation) ──
  /// Which NoteTemplate (and which version of it) L4 used to generate
  /// this visit's note. BOTH stay NULL in Phase 0 — the resolve-logic is
  /// dormant and L4 is untouched. Phase 1 populates them when L4 runs
  /// (resolveActiveTemplate → template id + version). Nullable + onDelete
  /// SetNull so removing a template never blocks; noteTemplateVersion
  /// independently preserves which lineage version ran even if the
  /// NoteTemplate row is later deleted. NO behavior depends on these in
  /// Phase 0.
  noteTemplateId      String?
  /// ⚠️ R1: `onDelete: Restrict`, NEVER SetNull. This is a PROVENANCE link from a
  /// clinical note to the template it was written against. Under SetNull, deleting a
  /// template silently erased that link on every bound visit — 29 of 52 production
  /// visits, 18 of them SIGNED — with no warning and no audit row. Restrict refuses
  /// the delete instead; the application refuses first with a readable message and
  /// offers archival. Cascade would be worse still: it would delete the records.
  noteTemplate        NoteTemplate? @relation(fields: [noteTemplateId], references: [id], onDelete: Restrict)
  noteTemplateVersion Int?

  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  /// Template Twin native-DOCX fill manifest for this visit (additive, VIRTUAL
  /// back-relation; no column on transcribe_visits).
  templateTwinFill TemplateTwinFillManifest?

  @@index([frozenFillManifestId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([patientId])
  /// T-M17.3: supports the default-view filter across every surface —
  /// patient timeline, dashboard visits tab, per-patient aggregates
  /// — which always pairs patientId with (deletedAt IS NULL AND
  /// archivedAt IS NULL). Adding it here rather than splitting into
  /// two single-column indexes keeps the planner honest.
  @@index([patientId, deletedAt, archivedAt])
  /// T-M18.3 A23: mirror of the per-patient index above, for the
  /// per-user selector used on /dashboard where patientId isn't
  /// narrowed. At ≥1000 visits/user the existing (userId, createdAt)
  /// index forces a post-filter on the IS-NULL predicates; this
  /// composite lets the planner use the index directly.
  @@index([userId, deletedAt, archivedAt])
  /// T-M18.3 A24: supports the 15-day stale-trash sweep's scan
  /// `WHERE deletedAt < cutoff`. Plain btree (vs a partial index)
  /// because Prisma's schema DSL doesn't expose partial indexes; at
  /// current scale the cost of indexing NULL values is negligible
  /// and the sweep's single-scan cost dominates the index tradeoff.
  @@index([deletedAt])
  /// Phase 0 note-format provenance FK. Indexed for the eventual
  /// "which visits used template X" lookup; unused in Phase 0.
  @@index([noteTemplateId])
  /// ⚠️ DECLARED 2026-08-06 — these existed in the DATABASE ONLY, created by the
  /// T3 and T4 migrations' raw `CREATE INDEX` and never added here. I introduced
  /// schema drift in the same programme that was fixing it. They are plain
  /// single-column indexes, so unlike the partial uniques on `note_templates`
  /// they ARE expressible, and there is no reason for them to live outside the
  /// schema. Names already match Prisma's convention, so this declaration
  /// produces no migration.
  @@index([practiceId])
  @@index([signedBy])
  @@map("transcribe_visits")
}

// ============================================================================
// VISIT DELIVERY — T-M7 export audit
// ----------------------------------------------------------------------------
// Every time the doctor exports a signed (or ready-but-not-signed) visit
// via a clipboard-format copy, a PDF/DOCX download, or an email send, we
// log one row here. Keeps the ops + support surface debuggable without
// needing to grep container logs.
// ============================================================================

model VisitDelivery {
  id String @id @default(cuid())

  visitId String
  visit   TranscribeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  /// "clipboard_epic" | "clipboard_athena" | "clipboard_cerner" |
  /// "clipboard_eclinicalworks" | "clipboard_generic" | "pdf" | "docx" |
  /// "email".
  channel     String
  /// Email address for channel="email"; null otherwise.
  destination String?
  /// Size in bytes for pdf/docx deliveries; null otherwise.
  sizeBytes   Int?

  createdAt DateTime @default(now())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  @@index([visitId])
  @@index([practiceId])
  @@map("visit_deliveries")
}

// ============================================================================
// DOCTOR EDIT PATTERN — per-doctor style tracking (T-M14.1)
// ----------------------------------------------------------------------------
// One row per signed TranscribeVisit that had an original L6 snapshot.
// Invisible to the doctor; the sign-time capture hook writes it
// asynchronously (catch+log, never blocks sign).
//
// Why both originalSoap + editedSoap are stored here (vs pointing at
// visit.soapL6Original / visit.signedSoap):
//   - Analysis stability: future retention / export logic on
//     TranscribeVisit should not silently invalidate the training
//     corpus. Storing copies makes this table self-contained.
//   - Simple diff queries: JOINless "find visits where the doctor
//     rewrote > 30% of the draft" ranks tuning candidates cheaply.
//
// The embedding is on originalSoap (the AI's work), not the edit —
// future few-shot retrieval is "given a new draft, find past drafts
// that looked similar to this doctor, and use their edits as
// style examples". Similarity is computed on the AI input side.
// ============================================================================

model DoctorEditPattern {
  id String @id @default(cuid())

  /// 1:1 with TranscribeVisit — one capture per signed visit.
  visitId String          @unique
  visit   TranscribeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  /// The user who signed — the "doctor" for retrieval purposes. STAFF
  /// users don't sign in transcribe-md, but denormalizing here future-
  /// proofs against role changes on the User row.
  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// Frozen copy of soapL6Original at sign time. Never updated.
  originalSoap String @db.Text
  /// Frozen copy of signedSoap at sign time (== soapFinal at that
  /// instant). Equals originalSoap when the doctor signed without
  /// editing — still captured so "doctor rarely edits" is a visible
  /// signal in the distribution, not a missing row.
  editedSoap   String @db.Text

  /// Character-level Levenshtein distance between originalSoap and
  /// editedSoap. 0 when the doctor didn't edit. Indexed so "highly
  /// edited notes for this doctor" is a cheap ORDER BY DESC query.
  editDistance Int

  /// pgvector embedding of originalSoap (OpenAI text-embedding-3-small,
  /// 1536 dims). Nullable so capture still succeeds if the embed call
  /// fails — a follow-up batch job can backfill. Unsupported() because
  /// Prisma's type system doesn't model pgvector natively.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())

  /// T7 — derives from the VISIT, not the doctor: the chart owns the note.
  /// This table stores originalSoap/editedSoap as full text.
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  @@index([doctorId, createdAt])
  @@index([doctorId, editDistance])
  @@index([practiceId])
  @@map("doctor_edit_patterns")
}

// ============================================================================
// NOTE TEMPLATE — doctor-customizable note format (Phase 0 foundation)
// ----------------------------------------------------------------------------
// The data-model spine of the note-format customization feature. PURELY
// ADDITIVE + opt-in. Today's fixed SOAP format is seeded as ONE system-
// default row (doctorId = NULL, isSystemDefault = true) that encodes the
// exact Layer-4 (04-generate-soap.ts) format as data. resolveActiveTemplate()
// falls back to it for any doctor without a custom template, so a non-
// customizing doctor's note is byte-identical to today's. Doctors get their
// own row only when they customize (Phase 2+) — no per-doctor backfill.
//
// Phase 0 ships this DORMANT: nothing in the L4 pipeline reads it yet, and
// the two TranscribeVisit provenance columns stay NULL. Phase 1 wires
// resolveActiveTemplate() into L4 and populates the provenance.
//
// NO PHI EVER lives in this table — templates are format/style scaffolding,
// never patient content. (Hard constraint; load-bearing for Phase 2 parsing.)
//
// `sections` / `styleProfile` are JSONB — same posture as soapNote / entities
// on TranscribeVisit. The shape contracts (NoteTemplateSection /
// NoteTemplateStyleProfile) + the seeded system-default content live in
// apps/transcribe-md/src/worker/note-templates/system-default-template.ts.
//
// Prior art: T-M24 `transcribe_templates` (file-upload approach) was dropped
// 2026-04-22; this is a clean structured-data redesign with distinct naming.
// ============================================================================

model NoteTemplate {
  id String @id @default(cuid())

  /// Owning doctor (User.id). NULL = system-level template. Exactly one row
  /// is the system default (isSystemDefault = true, doctorId = NULL),
  /// enforced by a PARTIAL UNIQUE INDEX added in the migration — Prisma's
  /// schema DSL can't express partial uniqueness (same constraint noted on
  /// TranscribeVisit's partial-index comments). Cascade so a doctor's
  /// templates vanish with the doctor.
  doctorId String?
  doctor   User?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// Human label — "System Default — SOAP", or a doctor's "My ortho note".
  name String

  /// Encounter type this template applies to (specialty / visit-type slug).
  /// NULL = applies to ALL encounter types (a doctor's catch-all default).
  /// Stored as TEXT (not an enum) per the codebase's extensible-categorical
  /// convention and because the encounter taxonomy is open-ended. Modeled
  /// now though Phase-0 resolve-logic uses it minimally — cheap now,
  /// expensive to retrofit.
  encounterType String?

  /// Optional specialty-baseline this template builds on. A slug into the
  /// CODE-based specialty catalog (apps/transcribe-md/src/lib/specialty-
  /// keys.ts), NOT a FK: the relational M5 `scribe_specialty_templates`
  /// table was dropped 2026-04-19 and the live specialty system is
  /// code/config. A full relational tie-in is DEFERRED to if/when M5 is
  /// rebuilt as a table.
  specialtyBaseline String?

  /// Ordered section definitions. JSONB array; each element is a
  /// NoteTemplateSection: { key, label, order, formatHint, styleInstructions,
  /// defaultText, defaultTextMode }. `key` is a canonical section slug
  /// (subjective/objective/ros/pe/assessment/plan/patient_education/…). The
  /// seeded system default uses the 4 SOAP sections L4 emits today, in order.
  sections Json

  /// Optional doctor-level global style (tense/tone/abbreviations) plus the
  /// global generation guardrails. JSONB NoteTemplateStyleProfile | null.
  styleProfile Json?

  /// Monotonic version for this template lineage; bumped on doctor edits
  /// (Phase 2+). The system default starts at 1. Copied to
  /// TranscribeVisit.noteTemplateVersion at generation time (Phase 1).
  version Int @default(1)

  /// Lifecycle: "draft" | "active" | "inactive". TEXT (not enum) per
  /// convention; resolveActiveTemplate() only considers "active" rows.
  /// Phase 2b: a partial-unique index (note_templates_one_active_per_doctor_
  /// encounter, NULLS NOT DISTINCT) enforces at most one "active" row per
  /// (doctorId, encounterType) for doctor-owned rows — the DB backstop for the
  /// transactional activation supersede. "inactive" = a superseded prior
  /// version, kept for history (ignored by resolve + the active index).
  /// Expressed in raw SQL since Prisma's DSL can't model partial uniqueness.
  status String @default("active")

  /// Exactly one row is the system default (doctorId = NULL). The resolve
  /// fallback chain terminates here.
  isSystemDefault Boolean @default(false)

  /// Phase-1 provenance back-reference — visits generated with this template.
  visits TranscribeVisit[]

  /// Template Twin native-DOCX 1:1 binding (additive, VIRTUAL — no column on
  /// note_templates). Present iff this template is an exact-source DOCX twin;
  /// the native-export path keys off its existence, not a note_templates column,
  /// so note_templates stays byte-identical. Version-forking lineage lives in
  /// the twin tables (template_twin_source_artifacts.lineageId), never here.
  templateTwinCompiledVersion TemplateTwinCompiledVersion?

  /// RC-2, ruling #106(b) — THE UPLOADED FILE IS A KEPT ARTIFACT.
  ///
  /// ⚠️ THIS SUPERSEDES THE "no column on note_templates" STANCE STATED
  /// DIRECTLY ABOVE, AND THE TWO ARE LEFT SIDE BY SIDE ON PURPOSE. That stance
  /// was right about the TWIN BINDING, which is a lineage the twin tables own.
  /// It was never a claim that the doctor's ORIGINAL FILE should be discarded —
  /// and discarded is what happened: every `.docx` uploaded through
  /// Settings → My Note Format had its text extracted and its bytes dropped, so
  /// one customer's logo and letterhead stopped existing at upload and are
  /// recoverable from nothing we hold.
  ///
  /// Object key in the private template-artifact bucket, written BEFORE
  /// extraction so a failed parse can no longer destroy the only copy. NULL for
  /// every template created before RC-2, and for any created by paste rather
  /// than upload — absence means "we do not have the file", never "the file is
  /// somewhere else".
  sourceObjectKey String?

  /// SHA-256 of those bytes, lowercase hex. Stored beside the key because a key
  /// alone cannot prove the object still holds what was uploaded; the read path
  /// verifies against this and refuses a mismatch.
  sourceSha256 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ T7 — NULLABLE, and the database enforces a BICONDITIONAL:
  /// `note_templates_practice_iff_doctor` — a template has a practice IFF it has
  /// a doctor. Prisma cannot express that; see the migration header. Ruled
  /// 2026-08-07: the sentinel-practice alternative was rejected.
  practiceId String?

  @@index([doctorId, status])
  @@index([isSystemDefault])
  @@index([practiceId])
  /// ⚠️ TWO UNIQUE INDEXES ON THIS TABLE EXIST IN POSTGRES AND CANNOT BE
  /// DECLARED HERE. Prisma has no syntax for PARTIAL indexes, and both are
  /// partial:
  ///
  ///   note_templates_one_system_default
  ///     UNIQUE ("isSystemDefault") WHERE "isSystemDefault" = true
  ///   note_templates_one_active_per_doctor_encounter
  ///     UNIQUE ("doctorId","encounterType") NULLS NOT DISTINCT
  ///     WHERE status = 'active' AND "doctorId" IS NOT NULL
  ///
  /// ⚠️ DO NOT "FIX" THIS WITH `@@unique([doctorId, encounterType])`. That would
  /// be a FULL unique, not a partial one, and it is strictly STRONGER than what
  /// the database enforces: production currently holds 1 doctor+encounterType
  /// group with more than one row across all statuses (0 among ACTIVE ones), so
  /// the declaration would either fail to apply or start rejecting legitimate
  /// inactive history. It would also silently drop NULLS NOT DISTINCT.
  ///
  /// Same convention as the trigram index on `transcribe_md_patients`: the
  /// index lives in migration SQL and is documented here so nobody mistakes its
  /// absence for an oversight.
  ///
  /// CONSEQUENCE, worth knowing before you reach for it: there is no compound
  /// unique Prisma can see, so `noteTemplate.upsert` on (doctorId,
  /// encounterType) is IMPOSSIBLE. Seeds use find-then-create. That is not a
  /// workaround anyone forgot to clean up — it is the only shape available.
  @@map("note_templates")
}

// ============================================================================
// USER SESSION — anti-account-sharing tracking (T-M2)
// ----------------------------------------------------------------------------
// A separate table from the NextAuth `Session` model (which is adapter-
// managed and currently unused under JWT strategy). Writing one row per
// sign-in lets us:
//   - enforce a single concurrent session per user (new login deletes the
//     prior rows, which the jwt callback checks on next request)
//   - surface "active session" info to the user on /settings
//   - log the IP + UA + device fingerprint for after-the-fact investigation
// Unlike the JWT itself, rows here are long-lived and queryable.
// ============================================================================

model UserSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Opaque token we generate at login and embed in the JWT's `sessionId`
  /// claim. Matching this row to the JWT is what makes "single session"
  /// enforceable — a new login deletes the old row, so the old JWT's
  /// sessionId no longer resolves and the next auth() call signs them out.
  sessionToken String @unique

  ipAddress         String?
  userAgent         String? @db.Text
  /// Hash of UA + Accept-Language today; richer signals (canvas, font list,
  /// etc.) can be folded in later without a schema change.
  deviceFingerprint String?

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ============================================================================
// RX WARNING OVERRIDE — audit log for "sign anyway" on critical Rx warnings
// ----------------------------------------------------------------------------
// Critical Rx warnings block signing by default (AI-confidence dips,
// clinical-rules flags). The doctor can override via the <OverrideConfirmModal>
// with a typed reason (10–500 chars). One row per override so support +
// compliance can trace which warnings were bypassed and why.
//
// `warningId` is an opaque identifier the worker emits alongside the
// warning — a stable hash of (severity + headline + rxLineNumber). No FK
// because the warning itself lives inside TranscribeVisit JSON payloads,
// not a relational table.
// ============================================================================

model RxWarningOverride {
  id String @id @default(cuid())

  visitId String
  visit   TranscribeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  /// Which Rx line in the SOAP note this warning attached to. Useful
  /// for joining back to the line in replay without parsing JSON.
  rxLineNumber Int

  /// Canonical warning identity — the positional id `rx-warning-<index>`
  /// of the warning in TranscribeVisit.rxDrafts.warnings[]. Derived by
  /// `warningIdForIndex` in apps/transcribe-md/src/lib/rx-warnings.ts (the
  /// single source of truth shared by the rail client, recordOverride, and
  /// the sign gate). recordOverride VALIDATES a submitted warningId against
  /// the persisted warnings before insert, so fabricated/guessed ids are
  /// never written. (NB: not a worker-emitted hash — the worker emits no id.)
  warningId String

  /// Frozen rail severity ('critical' | 'serious' | 'moderate' | 'info') at
  /// override time. Kept as a raw string so schema changes to the client-side
  /// enum don't invalidate historical rows. Only 'critical' rows are counted
  /// by the sign gate. recordOverride validates this against the warning's
  /// server-derived severity (mapWorkerSeverity), so it can't be spoofed.
  severity String

  /// Frozen copy of the warning's headline — compliance view doesn't
  /// want to re-parse the original worker payload.
  headline String

  /// The doctor's typed reason. Required; client enforces 10–500 chars
  /// but the server also validates before insert.
  reason String @db.Text

  overriddenBy String?
  user         User?   @relation(fields: [overriddenBy], references: [id], onDelete: SetNull)

  overriddenAt DateTime @default(now()) @db.Timestamptz(6)

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  /// Round 3 PR-E (A09-P0-001) — same (visit, warning) pair can be
  /// re-clicked by an anxious doctor or a flaky network retry; this
  /// constraint keeps that idempotent (one row per real warning). The
  /// sign gate now requires a matching override for EACH critical
  /// warning's real id (apps/transcribe-md/.../sign/route.ts), so the
  /// uniqueness here also stops duplicate rows from inflating coverage.
  /// recordOverride() does NOT upsert — it catches P2002 and returns the
  /// original row, preserving the first overriddenAt/reason for the audit
  /// trail (lib/rx-warning-audit.ts).
  @@unique([visitId, warningId], name: "rx_warning_overrides_visit_warning_unique", map: "rx_warning_overrides_visitId_warningId_key")
  @@index([visitId])
  @@index([overriddenBy])
  @@index([practiceId])
  @@map("rx_warning_overrides")
}

// ============================================================================
// API USAGE EVENT — per-call cost record (Phase 6)
// ----------------------------------------------------------------------------
// One row per external-API call (Deepgram / Anthropic / Whisper / OpenAI /
// Resend). Distinct from `ai_calls` (which is the older liveness/error-rate
// table the system-health endpoint queries) — this one is purpose-built for
// per-user / per-practice cost rollups in the admin dashboard.
//
// Cost is computed at log time using `PRICING` constants in the app code so
// historical rows preserve the rate that was charged at the time of the
// call. Update PRICING when providers change pricing — never back-rewrite
// these rows.
//
// userId/practiceId are nullable + ON DELETE SET NULL. We never want a
// real DELETE on a user (HIPAA 7-yr retention applies) so this should
// effectively never fire, but the SetNull keeps the cost record alive for
// historical billing rollups even if a row is hard-deleted by a future
// cleanup sweep.
// ============================================================================

model ApiUsageEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now()) @db.Timestamptz(6)

  userId     String?
  practiceId String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)

  /// Provider identifier — kept as text (not enum) so we can add new
  /// providers without a migration. Allowed values today:
  /// "deepgram" | "anthropic" | "whisper" | "openai" | "resend"
  provider String

  /// Operation within the provider — e.g. "transcribe_realtime",
  /// "transcribe_batch", "soap_generate", "embed", "email_send".
  operation String

  // ── Per-modality metrics (all nullable; populated based on provider) ──
  audioSeconds             Int?
  inputTokens              Int?
  outputTokens             Int?
  emailCount               Int?
  /// Anthropic prompt-caching: tokens read from cache (billed 0.10x).
  /// Added 2026-05-12 to mirror AiCall.cacheReadInputTokens and close
  /// the dashboard-vs-actual cost gap. Default 0 so historical rows +
  /// non-Anthropic events don't carry NULL.
  cacheReadInputTokens     Int  @default(0)
  /// Anthropic prompt-caching: tokens written to cache (billed 1.25x
  /// or 2x — see AiCall comment).
  cacheCreationInputTokens Int  @default(0)

  // ── Cost ──
  /// Generic count for cost calculation (minutes / tokens / emails).
  unitCount    Float
  /// "minutes" | "tokens_in" | "tokens_out" | "emails"
  unitType     String
  /// Cost per unit at time of call (snapshot of PRICING).
  unitCostUsd  Float
  /// unitCount * unitCostUsd. Pre-computed so the rollups are a SUM,
  /// not a product, and historical billing-tier changes don't move
  /// historical numbers.
  totalCostUsd Float

  // ── Context ──
  visitId   String?
  /// THE VENDOR'S OWN CORRELATION ID for this call, verbatim — or NULL.
  ///
  /// ⚠️ NULLABLE SINCE B1-b STEP 2 (`20260809100000_b1b_request_id_nullable`),
  /// and it was NOT NULL for the wrong reason. The column's original brief was
  /// "correlation id — matches X-Request-Id headers / job IDs", and every
  /// builder honoured NOT NULL with `ctx.requestId ?? randomUUID()`. So the
  /// column was 100% populated and 0% trustworthy: a minted UUID and a real
  /// vendor id are the same shape, so one row later nothing could tell them
  /// apart. That is not merely lost information — it is manufactured
  /// information, and it is the fail-open shape ruled against on 2026-08-08
  /// ("A provenance column's DEFAULT must never be the TRUSTED value").
  ///
  /// NULL now means "the vendor did not tell us", which is a fact worth
  /// storing. Nothing in the write path invents a substitute.
  ///
  /// ⚠️ A CHECK CONSTRAINT PRISMA CANNOT EXPRESS TIES IT TO THE PROVENANCE.
  /// Declared here because a raw `ADD CONSTRAINT` the schema does not mention
  /// is drift, and drift is invisible until something trips over it:
  ///
  ///     api_usage_events_request_id_requires_vendor
  ///       CHECK ("requestId" IS NULL OR "unitsSource" = 'vendor')
  ///
  /// Read as an implication: `requestId IS NOT NULL ⇒ unitsSource = 'vendor'`.
  /// AN ID PRESENT MEANS A REAL VENDOR GAVE US ONE. Mock rows carry NULL.
  ///
  /// ⚠️ THE CONVERSE IS NOT ASSERTED, DELIBERATELY. Whether `vendor ⇒ id` can
  /// be strict is step (b) of the 2026-08-09 ruling and depends on MEASURING
  /// how often a real call yields no id. Tightening later is always available —
  /// a gate only ever gains requirements — so the unmeasured half stays open
  /// rather than being guessed in the one direction that cannot be walked back.
  /// A naive "fix" that completes the biconditional to make the constraint look
  /// symmetrical would ship exactly that guess.
  requestId String?

  // ── Provider metadata ──
  /// Concrete model name — "claude-sonnet-4-6", "nova-3-medical",
  /// "whisper-1", "text-embedding-3-small", etc.
  modelName String?
  /// Free-form provider response details (latency, request size,
  /// stop reason). Kept as JSON so we don't grow columns for every
  /// new field a provider exposes.
  metadata  Json?

  /// B0 — WHERE THIS ROW'S UNITS CAME FROM. `vendor` | `mock`.
  ///
  /// `vendor` — a real vendor was called and reported these numbers.
  /// `mock`   — a mocked run. No vendor was called; units are fixture-derived
  ///            and the money columns are ZERO, because zero is the true cost.
  ///
  /// ⚠️ REQUIRED SINCE STEP 2 — `20260808230000_b0_units_source_not_null`.
  /// It was nullable for exactly one deploy, and deliberately so:
  /// `deploy-prod.sh` applies migrations at step 3 and recreates the app and
  /// worker at step 6, so a NOT NULL column with no default would, in that
  /// window, forbid a row the STILL-RUNNING previous image was writing —
  /// breaking the meter during the deploy meant to fix it. Step 1 added it
  /// nullable and backfilled; step 2 landed once the writing code was live
  /// everywhere (B0-a, production 2026-08-08T18:40Z).
  ///
  /// ⚠️ AND IT WILL NEVER TAKE A DEFAULT. A provenance column whose default is
  /// the TRUSTED value is fail-open: any writer that has not heard of it
  /// silently claims a real vendor reported these numbers. The TypeScript side
  /// already makes it required (`UsageEvent.unitsSource`), so a new writer
  /// fails to compile rather than lying quietly — and now also fails to insert.
  ///
  /// ⚠️ A CHECK CONSTRAINT PRISMA CANNOT EXPRESS GUARDS THE DOMAIN.
  /// Declared here because a raw `ADD CONSTRAINT` that the schema does not
  /// mention is drift, and drift is invisible until something trips over it:
  ///
  ///     api_usage_events_units_source_domain
  ///       CHECK ("unitsSource" IN ('vendor', 'mock'))
  ///
  /// NOT NULL alone still permits any TEXT, and the rollups filter
  /// `WHERE "unitsSource" = 'vendor'`. A row carrying 'Vendor' or 'real' would
  /// land in NEITHER bucket — counted as neither vendor nor mock, erroring
  /// nowhere, and simply absent from the money. A naive "fix" that widens this
  /// to free text to make some future writer compile would restore exactly that
  /// silence; widening the DOMAIN is a migration and a ruling, not a schema tidy.
  unitsSource String

  @@index([userId, timestamp])
  @@index([practiceId, timestamp])
  @@index([provider, timestamp])
  @@index([timestamp])
  /// Every reconciliation and rollup filters on this, so it is indexed WITH
  /// time — the queries are always "vendor rows in a period".
  @@index([unitsSource, timestamp])
  @@map("api_usage_events")
}

// ============================================================================
// THREAT RESOLUTION — admin disposition for live-detected threats (Phase 6H)
// ----------------------------------------------------------------------------
// Threats themselves stay LIVE-COMPUTED in `getThreats()` from audit_logs —
// no materialized threat table. This overlay records the admin disposition
// (acknowledged / dismissed-as-false-positive) keyed on the deterministic
// threat id `getThreats()` already emits (e.g. "grant-admin:<auditLogId>",
// "xdom:<userId>:<domain>"). The active list LEFT-JOINs this table and
// excludes any threat with a row here.
//
// `silencePattern` is the false-positive learning hook: when an admin
// dismisses "Admin privileges granted to ash@meddoc.com" as a false
// positive, we can store `{ "kind": "grant_admin_target", "value":
// "ash@meddoc.com" }` and future grants to that email get auto-suppressed.
// JSON instead of a structured column because the silence shape varies by
// detector and this is plumbing-level, not a query target.
// ============================================================================

model ThreatResolution {
  id String @id @default(cuid())

  /// The deterministic threat id from getThreats(). Unique because a
  /// single threat can only be resolved once; subsequent resolve calls
  /// 409 at the API layer.
  threatId String @unique

  /// "RESOLVED" | "FALSE_POSITIVE". String not enum because the set
  /// can grow without a migration.
  resolutionKind String

  resolvedAt      DateTime @default(now()) @db.Timestamptz(6)
  resolvedById    String?
  resolvedBy      User?    @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  /// Snapshot — survives soft-delete of the resolving admin.
  resolvedByEmail String?

  note String? @db.Text

  silencePattern Json?

  @@index([resolvedAt])
  @@index([resolvedById])
  @@index([resolutionKind])
  @@map("threat_resolutions")
}

// ============================================================================
// HIPAA FINDING — manual checklist surfaced on /admin/hipaa (Phase 7B)
// ----------------------------------------------------------------------------
// Phase 6Z's getHipaaState() returned a hardcoded "4 high · 1 resolved · 3
// pending" array. Kasra hit the natural follow-up: the card promised "3
// open" with no click-through. This table is the click-through.
//
// Findings here are SHAPE 1 (manual checklist items — H3 disk encryption,
// H4 non-root containers, etc) created by the audit team and resolved
// when the team fixes the underlying issue. The threat detectors keep
// being SHAPE 2 (live-derived from audit_logs); both surfaces coexist.
//
// Lifecycle:
//   open                                  - default, needs work
//   in_progress                           - someone's actively on it
//                                           (UI doesn't surface this yet
//                                           but the column lets us extend
//                                           without a schema change)
//   resolved                              - closed; resolvedAt +
//                                           resolvedById +
//                                           resolutionNote populated
//
// Reopen reverses a resolution by clearing those fields and writing
// HIPAA_FINDING_REOPENED to audit_logs. The original resolution audit
// row remains as the trail of "we thought this was closed".
// ============================================================================

model HipaaFinding {
  id String @id @default(cuid())

  /// HIPAA control reference — e.g. "§164.312(b)" for audit controls,
  /// "H3" for the project's internal launch-prep tags. Free-form so
  /// custom internal-policy tags ("internal-policy-1") slot in too.
  control String

  /// 'critical' | 'high' | 'medium' | 'low'. Kept as text not enum so
  /// future severity additions don't need a migration.
  severity String

  /// Short, specific headline — e.g. "Disk encryption at rest".
  title String

  /// Longer explanation — what the gap is + why it matters. Markdown
  /// allowed; the page renders as plain text for now.
  detail String? @db.Text

  /// Workflow state. 'open' | 'in_progress' | 'resolved'.
  status String @default("open")

  resolvedAt      DateTime? @db.Timestamptz(6)
  resolvedById    String?
  resolvedBy      User?     @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  /// Snapshot of the resolver's email at resolve time — survives a
  /// later soft-delete of that admin. Same pattern as ThreatResolution.
  resolvedByEmail String?
  resolutionNote  String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, severity])
  @@index([resolvedAt])
  @@map("hipaa_findings")
}

// ============================================================================
// TEMPLATE TWIN native-DOCX — enums (additive)
// ============================================================================
enum TemplateTwinCertificationStatus {
  RECOGNIZED
  NEEDS_CONFIRMATION
  UNSUPPORTED
  CERTIFIED
  QUARANTINED
}

enum TemplateTwinDetectionStatus {
  RECOGNIZED
  NEEDS_CONFIRMATION
  UNSUPPORTED
  CERTIFIED
}

enum TemplateTwinResolutionStatus {
  SUPPORTED
  EXPLICITLY_DENIED
  NOT_MENTIONED
  AMBIGUOUS
  CONFLICT
  NEEDS_CLINICIAN_INPUT
  APPROVED_PRACTICE_DEFAULT
}

enum TemplateTwinFillStatus {
  RESOLVING
  NEEDS_REVIEW
  VERIFIED
  SIGNED
  FAILED
}

// TEMPLATE TWIN — structure-preserving DOCX v1
// ----------------------------------------------------------------------------
// The original OOXML package is immutable in object storage. Compilation,
// mapping, certification, encounter resolution, rendering, and review are
// separate records so a signed visit can always be reproduced from the exact
// source/template/compiler/resolver/renderer versions it used.
// ============================================================================

model TemplateTwinSourceArtifact {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("TemplateTwinSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  lineageId        String
  lineageVersion   Int
  objectKey        String?  @unique
  sha256           String   @db.Char(64)
  mimeType         String
  sizeBytes        Int
  validationStatus String   @default("accepted")
  rejectionCodes   String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  compiledVersions TemplateTwinCompiledVersion[]

  @@index([practiceId, createdAt])
  @@index([lineageId, lineageVersion])
  @@index([sha256])
  @@map("template_twin_source_artifacts")
}

model TemplateTwinCompiledVersion {
  id String @id @default(cuid())

  sourceArtifactId String
  sourceArtifact   TemplateTwinSourceArtifact @relation(fields: [sourceArtifactId], references: [id], onDelete: Cascade)

  noteTemplateId String       @unique
  noteTemplate   NoteTemplate @relation(fields: [noteTemplateId], references: [id], onDelete: Cascade)

  compilerVersion          String
  irSchemaVersion          Int
  compiledAt               DateTime                        @default(now()) @db.Timestamptz(6)
  compiledDocumentIr       Json
  unsupportedElements      Json
  structureSha256          String                          @db.Char(64)
  staticContentSha256      String                          @db.Char(64)
  certificationStatus      TemplateTwinCertificationStatus @default(NEEDS_CONFIRMATION)
  blockingUnsupportedCount Int                             @default(0)

  /// Latest verified synthetic run for this mutable draft. Certification
  /// copies this evidence into its append-only record and requires the saved
  /// mapping hash to still match, preventing test-then-edit activation.
  latestSyntheticTestManifest   Json?
  latestTestMappingsSha256      String?   @db.Char(64)
  latestTestOutputObjectKey     String?   @unique
  latestTestOutputSha256        String?   @db.Char(64)
  latestTestStaticContentSha256 String?   @db.Char(64)
  latestTestRoundTrip           Json?
  latestTestVerifiedAt          DateTime? @db.Timestamptz(6)

  /// PINNED SYNTHETIC NOTE — certification determinism. Generated once through
  /// the real ephemeral-visit path, then reused so the proof is not re-sampled
  /// on every attempt. Certification still runs the pinned note through the
  /// whole production machinery; only the stochastic input is fixed.
  pinnedSyntheticNote        String?
  /// sha256 of the encounter text the pin was generated from — a changed
  /// encounter invalidates the pin.
  pinnedNoteEncounterSha256  String?   @db.Char(64)
  /// sha256 of the template structure the pin was generated against.
  pinnedNoteTemplateSha256   String?   @db.Char(64)
  pinnedNoteModelVersion     String?
  pinnedNoteGeneratedAt      DateTime? @db.Timestamptz(6)
  /// The Layer-3 extraction pinned alongside the note. L3 is a model too: an
  /// unpinned certification re-extracted every run and blocked on a different
  /// set of fields each time. Keyed by the same encounter hash as the note.
  pinnedSyntheticEntities    Json?
  pinnedSyntheticContextText String?

  fields        TemplateTwinFieldDefinition[]
  certification TemplateTwinCertification?
  fills         TemplateTwinFillManifest[]

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], map: "twin_compiled_versions_practiceId_fkey")

  /// Multiple immutable NoteTemplate versions may reuse the same immutable
  /// source package when a physician explicitly forks only the semantic
  /// mapping. noteTemplateId remains the one-to-one version boundary.
  @@index([sourceArtifactId, compilerVersion])
  @@index([certificationStatus, compiledAt])
  @@index([practiceId], map: "twin_compiled_versions_practiceId_idx")
  @@map("template_twin_compiled_versions")
}

model TemplateTwinFieldDefinition {
  id String @id @default(cuid())

  compiledVersionId String
  compiledVersion   TemplateTwinCompiledVersion @relation(fields: [compiledVersionId], references: [id], onDelete: Cascade)

  fieldId            String
  displayOrder       Int
  originalLabel      String
  fieldKind          String
  allowedOptions     Json?
  rendererBinding    Json
  detectionStatus    TemplateTwinDetectionStatus
  clinicallyMaterial Boolean                     @default(true)
  criticality        String                      @default("routine")
  required           Boolean                     @default(false)

  mapping TemplateTwinSemanticMapping?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], map: "twin_field_definitions_practiceId_fkey")

  @@unique([compiledVersionId, fieldId])
  @@index([compiledVersionId, displayOrder])
  @@index([compiledVersionId, detectionStatus])
  @@index([practiceId], map: "twin_field_definitions_practiceId_idx")
  @@map("template_twin_field_definitions")
}

model TemplateTwinSemanticMapping {
  id String @id @default(cuid())

  fieldDefinitionId String                      @unique
  fieldDefinition   TemplateTwinFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  /// Where this field's value legitimately comes from: extraction (cited
  /// EncounterFact) | manual (per-visit human value, renders blank, attested) |
  /// context_default / visit_metadata (RESERVED, unimplemented until the
  /// flagged review-before-sign lane exists).
  sourceType        String                      @default("extraction")
  clinicalConcept   String?
  expectedDataType  String
  polarityBehavior  String
  temporality       String?
  laterality        String?
  unitPolicy        String?
  approvedSynonyms  Json
  required          Boolean                     @default(false)
  blankPolicy       String
  unknownPolicy     String
  /// #194 — what happens when NO fact matches. NULL is the bounded clear,
  /// COUNTED as still blank so the doctor is told; 'omit' is the bounded clear,
  /// NOT counted and with no prompt — a control the doctor RULED blank, such as
  /// a telehealth consent line on an in-person visit.
  ///
  /// ⚠️ NULLABLE WITH NO DEFAULT, AND NULL IS A MEANING. Any default would opt
  /// every existing mapping into a policy nobody chose. It is also what holds
  /// every certified sha still: pre-existing rows are NULL and contribute
  /// nothing to the attestation hash.
  ///
  /// ⚠️ THERE IS NO 'keep'. That half was built, adversarially tested across
  /// three rounds and DELETED — its premise was refuted, not merely its
  /// mechanism. This text is emitted into the generated client, so it is the
  /// hover a future developer gets; it said the opposite until #194.
  unmentionedPolicy String?
  /// #217 — which clinical concepts a SCAFFOLDED CLAUSE covers, as a JSON array
  /// of registered concept ids. A clause reading "The patient denies heartburn,
  /// odynophagia, dysphagia" answers for three symptoms, and `clinicalConcept`
  /// can only name one of them.
  ///
  /// ⚠️ IT IS A MAPPING, NOT A RENDER POLICY — #208. The model PROPOSES it
  /// exactly as it proposes `clinicalConcept`; unknown tokens are REFUSED AT
  /// PARSE; it is SURFACED on the confirm list and CONFIRMED by the doctor or by
  /// auto-confirm under the same confidence rule. It is never silently accepted.
  ///
  /// ⚠️ THIS COLUMN EXISTS BECAUSE THE FIELD HAD FOUR READERS AND NO WRITER.
  /// `conceptScope` was parsed, validated, read by the matcher, the resolver,
  /// the value deriver and the auto-confirm gate, and rendered by the confirm
  /// surface — and then DROPPED ON WRITE, because nothing persisted it. Measured
  /// on production: absent from the schema, absent from the table, and 0 of 185
  /// mappings carried it in any form. Every guard that read it was dead code.
  ///
  /// ⚠️ NULLABLE WITH NO DEFAULT, AND THE REASON IS THE ATTESTATION HASH. An
  /// empty array is NOT the same as absent: `canonicalSha256` refuses
  /// `undefined` outright and hashes `[]` as a value, so defaulting would move
  /// every existing mapping's sha and DE-CERTIFY all 185 production rows. Absent
  /// stays absent, the key is OMITTED rather than set, and pre-existing rows
  /// hash exactly as they did before this column existed.
  conceptScope      Json?
  practiceDefault   String?
  mappingStatus     TemplateTwinDetectionStatus @default(NEEDS_CONFIRMATION)
  proposedByModel   String?

  approvedById String?
  approvedBy   User?     @relation("TemplateTwinMappingApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], map: "twin_semantic_mappings_practiceId_fkey")

  @@index([mappingStatus, updatedAt])
  @@index([practiceId], map: "twin_semantic_mappings_practiceId_idx")
  @@map("template_twin_semantic_mappings")
}

model TemplateTwinCertification {
  id String @id @default(cuid())

  compiledVersionId String                      @unique
  compiledVersion   TemplateTwinCompiledVersion @relation(fields: [compiledVersionId], references: [id], onDelete: Cascade)

  certifiedById String?
  certifiedBy   User?   @relation("TemplateTwinCertifier", fields: [certifiedById], references: [id], onDelete: SetNull)

  compiledStructureSha256 String   @db.Char(64)
  approvedMappingsSha256  String   @db.Char(64)
  syntheticTestManifest   Json
  testOutputObjectKey     String   @unique
  testOutputSha256        String   @db.Char(64)
  certifiedAt             DateTime @default(now()) @db.Timestamptz(6)

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], map: "twin_certifications_practiceId_fkey")

  @@index([certifiedById, certifiedAt])
  @@index([practiceId], map: "twin_certifications_practiceId_idx")
  @@map("template_twin_certifications")
}

model TemplateTwinFillManifest {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  visitId String          @unique
  visit   TranscribeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  compiledVersionId String
  compiledVersion   TemplateTwinCompiledVersion @relation(fields: [compiledVersionId], references: [id], onDelete: Cascade)

  noteTemplateId       String
  noteTemplateVersion  Int
  compilerVersion      String
  resolverVersion      String
  resolverModelVersion String?
  rendererVersion      String
  status               TemplateTwinFillStatus @default(RESOLVING)

  fillManifest            Json
  manifestVersion         Int    @default(1)
  manifestSha256          String @db.Char(64)
  factSetSha256           String @db.Char(64)
  validationResult        Json
  filledCount             Int    @default(0)
  needsReviewCount        Int    @default(0)
  notMentionedCount       Int    @default(0)
  conflictCount           Int    @default(0)
  criticalUnresolvedCount Int    @default(0)

  outputObjectKey     String? @unique
  outputSha256        String? @db.Char(64)
  outputMimeType      String?
  outputSizeBytes     Int?
  staticContentSha256 String? @db.Char(64)

  /// ⚠️ THE NOTE THIS FILL ACTUALLY RAN AGAINST — sha256 of `soapFinal`.
  ///
  /// The serve path declines a manifest whose note-identity does not match the
  /// visit's CURRENT note. Without it a VERIFIED manifest was served forever:
  /// the worker filled from note v1, the doctor edited to v2, and the download
  /// was still v1 with nothing on any surface saying so.
  ///
  /// A HASH rather than `soapVersion` on purpose: it hashes exactly the text
  /// that was filled, so it cannot drift from a counter somebody forgot to
  /// thread. NULLABLE because manifests written before this column exist and
  /// must be treated as UNPROVABLE — declined, not trusted.
  noteSha256 String? @db.Char(64)

  /// ⚠️ F24-S5 — THE OTHER HALF OF THE BOUND IDENTITY: the OVERRIDE SET this
  /// fill ran against, as `overridesIdentity()` in `note-identity.ts`.
  ///
  /// `noteSha256` alone could not see a clinician's form-control correction,
  /// because an override deliberately never touches `soapFinal`. Every gate
  /// keyed on the note alone therefore read `match` while the stored artifact
  /// was already out of date — the pre-sign preview showed the correction and
  /// the download did not, and signing pinned the pre-override manifest
  /// forever.
  ///
  /// ⚠️ NULLABLE, AND NULL HAS EXACTLY ONE MEANING — unlike `noteSha256`'s.
  /// A null here can only mean the manifest predates the migration that created
  /// `template_twin_field_overrides`, and no override row can exist before its
  /// own table. So null is read as the identity of the EMPTY set — true by
  /// construction, never inferred, and NEVER backfilled: a backfilled identity
  /// asserts a correspondence nobody verified.
  overridesSha256 String? @db.Char(64)

  /// Back-relation for the visit's frozen pointer. A manifest may be the frozen
  /// document of at most one visit; the FK lives on the visit.
  frozenForVisits TranscribeVisit[] @relation("VisitFrozenFill")

  roundTripVerified     Boolean @default(false)
  roundTripVerification Json?

  reviewedAt       DateTime? @db.Timestamptz(6)
  signedDecisionAt DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  @@index([practiceId, status, updatedAt])
  @@index([compiledVersionId, status])
  @@index([status, criticalUnresolvedCount])
  @@map("template_twin_fill_manifests")
}

/// F24-S5 — A CLINICIAN'S CORRECTION TO ONE ENUMERATED FORM CONTROL.
///
/// ⚠️ WHY THIS IS A TABLE AND NOT A FIELD ON THE FILL MANIFEST. The manifest was
/// measured and REFUTED as the home for an override, fatally in BOTH
/// configurations (recon 2026-08-23, `RELAY.md` F24-S5):
///
///   • override written INTO the manifest, `reviewedAt` NULL — the export's
///     recompute fires on an identity mismatch and SILENTLY REVERTS it;
///   • override + `reviewedAt` set — `fill-engine.ts` throws MANIFEST_CONFLICT,
///     native-export catches, and the doctor's own form stops coming back AT
///     ALL. An accepted-capability loss manufactured by the fix itself.
///
/// So the override is not part of the fill's OUTPUT. It is an INPUT the fill
/// reads on every single run, which makes a recompute re-apply it.
///
/// ⚠️ AND THE INPUT ALONE WAS NOT ENOUGH — that was the refuted slice's whole
/// defect. The two surfaces that decide whether a fill runs AT ALL never reached
/// the engine. `TemplateTwinFillManifest.overridesSha256` is the other half:
/// these rows move the bound identity, so a new correction reads STALE and the
/// recompute actually happens.
///
/// ONE LIVE OVERRIDE PER (visit, field) — `@@unique`. A correction replaces a
/// correction; there is no stack to unwind and no ordering to get wrong.
///
/// ⚠️ UNSIGNED ONLY is enforced in the WRITE path, not here. The sign-freeze
/// governs signed records unchanged: a signed visit serves its frozen document
/// by pointer, so a row landing afterwards is inert rather than merely refused.
model TemplateTwinFieldOverride {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  visitId String
  visit   TranscribeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  /// The twin's OWN addressing. Never a label — 18 of this form's 28 content
  /// controls share a label with at least one other, so a label cannot identify
  /// a control and never could.
  fieldId String

  /// The chosen option's ordinal within the compiled field's `allowedOptions`.
  /// THE ORDINAL IS THE VALUE — the renderer resolves the option by ordinal and
  /// validation raises DROPDOWN_ORDINAL_MISMATCH on a disagreement.
  ///
  /// ⚠️ AN ORDINAL NAMES THE SAME OPTION ACROSS RECOMPILES, BY DESIGN. The
  /// compiler excludes Word's `Choose an item.` placeholder from
  /// `allowedOptions` while LEAVING EVERY SURVIVING ORDINAL AT ITS ORIGINAL
  /// VALUE (so the set starts at 1, not 0). Renumbering would silently
  /// re-point every stored ordinal at its neighbour — the wrong-cell write this
  /// arc has already paid for twice — and would also corrupt legacy `w:ddList`
  /// renders, where the ordinal is written as `w:result val` and indexes the
  /// DOCUMENT's own untouched list.
  /// ⚠️ NULLABLE SINCE REVIEW-DEFAULTS ITEM 1 — a scaffold-default insert has no
  /// ordinal to name. It stays REQUIRED for the `option` kind, enforced by the
  /// CHECK declared at the bottom of this model rather than by the column type.
  selectedOptionOrdinal Int?

  /// The option's text, verbatim, as it stood when the doctor chose it.
  /// DENORMALISED FOR AUDIT ONLY — never read back into a fill. If the template
  /// is recompiled and the ordinal no longer resolves, the override is DROPPED
  /// fail-closed rather than matched by this text.
  ///
  /// ⚠️ NULLABLE FOR THE SAME REASON, AND ITS AUDIT-ONLY STATUS IS UNCHANGED.
  /// Do not reach for this column to carry a scaffold default — `insertedText`
  /// exists precisely so that "the value the renderer reads" and "the text we
  /// kept for the audit trail" are different columns with different rules.
  optionValue String?

  /// ⚠️ WHICH KIND OF CORRECTION THIS ROW IS, AND IT IS A DISCRIMINATOR, NOT A
  /// LABEL. `option` is F24-S5's dropdown correction: the ordinal IS the value.
  /// `scaffold_default` is REVIEW-DEFAULTS item 1: the doctor asserted their own
  /// compiled `scaffoldText` into a blank narrative field, and `insertedText` is
  /// what the renderer writes.
  ///
  /// Kept as a string rather than a Prisma enum deliberately: an enum add is an
  /// irreversible `ALTER TYPE` (Postgres has no DROP VALUE), and this axis is
  /// young enough that it may still gain or lose an arm.
  overrideKind String @default("option")

  /// ⚠️ THE ONLY COLUMN ON THIS TABLE THAT IS READ BACK INTO A FILL, and it is
  /// only read for `overrideKind = 'scaffold_default'`.
  ///
  /// This is the doctor's OWN default text, asserted by a click at review. It is
  /// NOT a machine default: ruling #194 deleted that, and the whole point of
  /// REVIEW-DEFAULTS is that the click is the assertion. A row here means a
  /// human looked at a blank field, saw their own scaffold text, and said yes.
  insertedText String?

  /// Who made the correction. A clinical write is attributable or it is not made.
  overriddenBy String
  clinician    User   @relation(fields: [overriddenBy], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// ⚠️ DRIFT, DECLARED IN PLACE — Prisma cannot express a CHECK constraint.
  /// The migration also adds:
  ///
  ///   ALTER TABLE template_twin_field_overrides
  ///     ADD CONSTRAINT template_twin_field_overrides_ordinal_nonnegative
  ///     CHECK ("selectedOptionOrdinal" >= 0);
  ///
  /// A negative ordinal cannot address an option in `allowedOptions`. Do not
  /// "close" this drift by deleting the constraint — the schema is the weaker
  /// statement here, and `Int` admits negatives that the database refuses.
  ///
  /// ⚠️ THAT CONSTRAINT SURVIVES THE NULLABILITY CHANGE UNTOUCHED, and the
  /// reason is a SQL property worth stating rather than rediscovering:
  /// `CHECK (x >= 0)` evaluates to NULL — not false — when x IS NULL, and a
  /// CHECK passes on NULL. So a `scaffold_default` row with no ordinal does not
  /// violate it. Nothing had to be relaxed.
  ///
  /// ⚠️ AND REVIEW-DEFAULTS ITEM 1 ADDS THE ONE THAT REPLACES THE COLUMN TYPE'S
  /// LOST GUARANTEE. Making `selectedOptionOrdinal` nullable would otherwise let
  /// an `option` row exist with no ordinal — a correction that names nothing:
  ///
  ///   ALTER TABLE template_twin_field_overrides
  ///     ADD CONSTRAINT template_twin_field_overrides_kind_shape
  ///     CHECK (
  ///       ("overrideKind" = 'option'
  ///          AND "selectedOptionOrdinal" IS NOT NULL
  ///          AND "optionValue" IS NOT NULL
  ///          AND "insertedText" IS NULL)
  ///       OR
  ///       ("overrideKind" = 'scaffold_default'
  ///          AND "insertedText" IS NOT NULL
  ///          AND "selectedOptionOrdinal" IS NULL)
  ///     );
  ///
  /// It is written as a total partition on purpose: an unrecognised
  /// `overrideKind` satisfies NEITHER arm and is REFUSED by the database. A
  /// third kind added to the application without touching this constraint fails
  /// loudly at the write instead of storing a row nothing knows how to read.

  @@unique([visitId, fieldId])
  @@index([visitId])
  @@index([practiceId])
  @@map("template_twin_field_overrides")
}

// ---------------------------------------------------------------------------
// Invite-only signup (2026-07-28)
// ---------------------------------------------------------------------------
// Registration was open, rate-limited at 5/hour/IP and nothing else. The data
// showed what that buys: 195 accounts of which 172 had never logged in and only
// 43 had verified an email, accruing at a steady 1–3/day — a cadence that sits
// comfortably under the limit. No PHI was exposed (those accounts hold nothing)
// but it is an unbounded account-creation surface on a system about to hold
// patient records.
//
// Existing accounts are deliberately UNTOUCHED. They become inert behind the
// gate rather than deleted: a deletion is irreversible and these cost nothing
// to leave in place.
// ---------------------------------------------------------------------------

/// A code that permits exactly one class of signup. Codes are seeded by hand
/// for the pilot — there is no self-service issuance, by design.
model InviteCode {
  id String @id @default(cuid())

  /// SHA-256 hex of the raw code. The raw code is only ever in memory, in the
  /// invite email, and in the operator's hands — same discipline as AuthToken.
  /// Storing it hashed means a database read cannot mint signups.
  codeHash String @unique

  /// Free-text, for the operator. Who this was issued to and why. NEVER PHI —
  /// it is an operational label, not a clinical record.
  label String?

  /// How many signups this code may create. 1 for a personal invite; higher for
  /// a shared pilot-cohort code.
  maxUses Int @default(1)

  /// Incremented inside the signup transaction, so two concurrent signups
  /// cannot both consume the last use.
  usedCount Int @default(0)

  /// Null = no expiry. An expired code fails closed.
  expiresAt DateTime?

  /// Set to revoke immediately, without deleting the audit trail of its use.
  revokedAt DateTime?

  // === TEAMS T8 — an invite mints a MEMBER, not just a user ===
  /// The practice a redeemer JOINS. **NULL = the legacy behaviour**: signup mints
  /// a fresh solo practice, exactly as it did before T8. Nullable because every
  /// existing row predates this and none of them can be given a practice
  /// retroactively without inventing one.
  practiceId   String?
  practice     Practice?     @relation(fields: [practiceId], references: [id])
  /// The role the redeemer joins WITH. Paired with `practiceId` by a CHECK: both
  /// or neither. A practice without a role would fall to the schema default and
  /// silently mint an OWNER of somebody else's clinic.
  practiceRole PracticeRole?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([revokedAt, expiresAt])
  /// T8 — the admin surface lists a practice's outstanding invites.
  @@index([practiceId])
  @@map("invite_codes")
}

/// Someone who asked to be told when there is room. This is NOT an account:
/// no password, no practice, no products, no ability to sign in. The marketing
/// CTA writes here and nowhere else.
model WaitlistEntry {
  id String @id @default(cuid())

  email String  @unique
  name  String?

  /// Free-text context the person volunteered (specialty, practice size).
  /// NEVER PHI — this is a prospect, not a patient, and the form says so.
  note String?

  /// Where the capture came from, e.g. "marketing-home", "pricing".
  source String?

  /// Set when an invite is actually sent, so the operator can see who is still
  /// waiting without keeping a second list.
  invitedAt DateTime?

  createdAt DateTime @default(now())

  @@index([invitedAt, createdAt])
  @@map("waitlist_entries")
}

// ============================================================================
// BILLING — the versioned price table (FOUNDATION B3)
// ============================================================================

/// ONE VENDOR RATE, FOR ONE PERIOD, WITH THE SOURCE IT CAME FROM.
///
/// This table is the answer to SPEC §2.2's *"a versioned price-table snapshot —
/// the row records which price table priced it, so a later rate change never
/// re-prices history."* A rate is never edited: a change CLOSES the current row
/// (`effectiveTo`) and INSERTS a new one. That is what makes the history stable,
/// and it is the property B3's gate proves.
///
/// ⚠️ **NOTHING IS BILLED FROM THIS TABLE YET.** B3 lands the table, its seed and
/// its lookup. The meter still prices rows from `packages/ai/src/pricing.ts` and
/// `api-usage.ts`'s `PRICING` constant; repointing it is B4/B6. Both in-code
/// surfaces are left ALONE deliberately — SPEC §4.5: changing them now would
/// silently re-base a year of historical `ai_calls` comparisons for no benefit.
///
/// ⚠️ **A MISSING RATE IS A REFUSAL, NEVER A ZERO.** `claudeCostCents` returns 0
/// for an unknown model (`pricing.ts:131`), which is why an unpriced model bills
/// nothing instead of erroring — DISCOVERY §D.3 names it. The lookup over this
/// table returns `null` and its callers must handle it; see `price-table.ts`.
/// THE PLATFORM MARGIN — ADMIN-4, ruling #178.
///
/// ⚠️ THIS EXISTS BECAUSE THE MARGIN WAS ALREADY SHIPPED AS A CONSTANT, AND
/// #178 WAS RULED TO FORECLOSE EXACTLY THAT. `price-table.ts` computed
/// `costMicro * 3n / 2n` and `billing-charge.ts` stamped the literal string
/// `'3/2'` onto every ledger row — both landed 2026-08-11, three weeks BEFORE
/// the ruling that forbids "a rate nobody can change without a deploy, and —
/// worse — a rate with no audit row saying who changed it".
///
/// ⚠️ AN EXACT RATIO IN INTEGERS, NEVER A FLOAT. `price-table.ts` states the
/// reason and it is not pedantry: `1.5` is exactly representable in binary64,
/// but `cost * 1.5` is a Number, so any cost above 2^53 micro-dollars silently
/// loses precision. The margin is therefore a numerator and a denominator, and
/// the arithmetic stays `bigint` end to end.
///
/// FORWARD-ONLY, INSERT-NEVER-UPDATE, effective-dated — the shape `PriceRate`
/// already uses one layer down. A change is a NEW ROW; the previous value is
/// carried on it so the history reads without a self-join, and so a reader can
/// see what changed without reconstructing it.
model PlatformRate {
  id String @id @default(cuid())

  /// The margin as `numerator / denominator`. The shipped constant was 3/2.
  marginNumerator   Int
  marginDenominator Int

  /// The instant this rate begins to apply. **NULL on the way in means
  /// "immediately"** — the BEFORE INSERT trigger fills it with the server's own
  /// `clock_timestamp()`, so it is never null at rest and can never be in the
  /// past. ⚠️ Round 3 stamped `createdAt` with `clock_timestamp()` and thereby
  /// made every honest spelling of "now" refusable BY MICROSECONDS; NULL is the
  /// one spelling that cannot lose that race.
  ///
  /// ⚠️ FORWARD-ONLY BY **CONSTRAINT**,
  /// not by policy: `platform_rates_forward_only` refuses `effectiveFrom <
  /// createdAt`. Anchoring the READ to the usage instant stops a backlog being
  /// re-priced by the run clock; it does NOT stop a backdated row, and the
  /// first version of this file claimed otherwise — #178.
  effectiveFrom DateTime? @db.Timestamptz(6)

  /// ⚠️ WHO CHANGED IT — AND THE LINK IS NULLABLE WHILE THE FACT IS NOT.
  ///
  /// The FK detaches on user deletion, which is this codebase's rule for audit
  /// rows. Detaching a rate change would erase who changed the price — the half
  /// of #178 that is not about the rate at all — so the ACTOR IS SNAPSHOTTED
  /// beside the link, `NOT NULL`, and survives the detach.
  ///
  /// ⚠️ AN EARLIER VERSION OF THIS COMMENT SAID "nullable ONLY for the seed row
  /// … and the gate asserts it". Both halves were false: the table ships EMPTY
  /// by design so there is no seed row to exempt, and no gate asserted anything
  /// — the writer does not exist yet.
  changedByUserId String?
  /// Immutable snapshot of the actor, e.g. their email at the time of the
  /// change. Survives user deletion.
  changedByLabel  String
  changedBy       User?   @relation("PlatformRateChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  /// What it was immediately before. NULL on the seed row only.
  previousNumerator   Int?
  previousDenominator Int?

  /// Why. Free text, shown beside the change in the money view.
  note String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([effectiveFrom])
  @@map("platform_rates")
}

model PriceRate {
  id String @id @default(cuid())

  /// Vendor, lowercase: "anthropic" | "deepgram" | "openai".
  /// Text rather than an enum so a new vendor is a row, not a migration —
  /// same reasoning as `ApiUsageEvent.provider`, which this must match.
  provider String

  /// THE VENDOR'S OWN MODEL ID, VERBATIM, exactly as the meter records it in
  /// `ApiUsageEvent.modelName` — "claude-opus-4-8", "nova-3-medical",
  /// "text-embedding-3-small". A rate keyed on a name the meter never emits is
  /// a rate nothing can ever find.
  modelName String

  /// Whether the vendor charges this rate for a pre-recorded or a live call.
  /// Closed vocabulary, NOT NULL: "pre_recorded" | "streaming" | "not_applicable".
  ///
  /// ⚠️ NOT NULLABLE ON PURPOSE, and the reason is the exclusion constraint
  /// below. `NULL = NULL` is UNKNOWN in SQL, so two Anthropic rows carrying a
  /// NULL here would NOT collide and the overlap guard would silently pass. A
  /// column that is part of a uniqueness key cannot be nullable and still guard.
  deliveryMode String

  /// What is being counted, closed vocabulary — see the CHECK in the migration:
  ///   tokens_input · tokens_output · cache_write_5m · cache_write_1h ·
  ///   cache_read · audio_minutes
  ///
  /// ⚠️ **TWO CACHE-WRITE CLASSES, NOT ONE.** The vendor publishes 1.25× (5
  /// minute) and 2× (1 hour) and the code collapses them into a single 1.25×
  /// (`pricing.ts:claudeCostCents`). That is correct only because the one
  /// caching call site uses ephemeral 5m (DISCOVERY §C.8). It is one config
  /// change away from being a 60% under-charge, so the table splits them.
  unitType String

  /// THE RATE, AS AN EXACT RATIONAL: `rateMicroUsd` micro-dollars per
  /// `unitQuantity` units of `unitType`. Both integers, so no float ever
  /// touches a price — GATE 0.4, integer micro-dollars ledger-wide.
  ///
  /// ⚠️ **WHY A DENOMINATOR COLUMN AND NOT ONE CANONICAL SCALE.** A single
  /// scale cannot hold both families exactly. Per-token in micro-dollars is
  /// fractional ($0.10/MTok = 0.1 µ$/token); a uniform per-1M denominator makes
  /// the audio rates unreadable ($0.0077/min = 7 700 000 000 µ$ per 1M minutes,
  /// where one misplaced zero is a 10× billing error). Per-second audio is not
  /// even exact — $0.0077/60 repeats. So the denominator is explicit and the
  /// row reads as the vendor states it: "5000000 µ$ per 1000000 tokens_input"
  /// is $5/MTok by inspection.
  ///
  /// ⚠️ It is redundant with `unitType` AND THE DATABASE KEEPS IT THAT WAY — a
  /// CHECK pins each `unitType` to its one legal `unitQuantity`. Redundancy that
  /// cannot drift is not the hazard AGENTS.md's derive-don't-thread rule warns
  /// about; a hand-passed value that CAN drift is.
  rateMicroUsd BigInt
  unitQuantity BigInt

  /// Inclusive start of the period this rate applies to.
  ///
  /// ⚠️ **THE SEED USES THE READ-DATE, NOT "FOREVER", AND THAT IS THE HONEST
  /// CLAIM.** We know these rates held on 2026-08-04 because we read them that
  /// day; we do NOT know when they took effect. A lookup before the earliest
  /// row therefore finds nothing and the caller refuses — which is correct, and
  /// costs nothing, because ruling 79 puts the meter's provenance regime at
  /// B0-a (2026-08-08) and B9's reconciliation scope with it.
  effectiveFrom DateTime @db.Timestamptz(6)

  /// Exclusive end, or NULL for "still in effect". A rate change CLOSES the old
  /// row here and inserts a new one — it never UPDATEs `rateMicroUsd`.
  effectiveTo DateTime? @db.Timestamptz(6)

  /// WHERE THE NUMBER CAME FROM — SPEC §4.5, a required column and not a
  /// comment: "published" | "invoice" | "console".
  ///
  /// ⚠️ **NO DEFAULT, DELIBERATELY.** Ruling 67: a provenance column's default
  /// must never be the trusted value. A writer that has never heard of this
  /// column must fail, not silently assert a source.
  provenance String

  /// Required when `provenance = 'published'`, by CHECK — a published rate
  /// without a URL and a read-date is a guess with a decimal point.
  sourceUrl    String?
  sourceReadAt DateTime? @db.Timestamptz(6)

  /// Anything a reader needs that the columns cannot carry — e.g. that the
  /// vendor published a DATE and the period boundary was taken at 00:00Z.
  note String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// The lookup's exact predicate: key + "in effect at this instant".
  @@index([provider, modelName, unitType, deliveryMode, effectiveFrom])
  /// ⚠️ THREE CONSTRAINTS ON THIS TABLE ARE INEXPRESSIBLE IN PRISMA and are
  /// declared here so the drift enumeration can see them (AGENTS.md rule 7).
  /// Their real DDL is in `20260810..._b3_price_table/migration.sql`:
  ///
  ///   price_rates_no_overlap        EXCLUDE USING gist (
  ///       provider WITH =, "modelName" WITH =, "unitType" WITH =,
  ///       "deliveryMode" WITH =,
  ///       tstzrange("effectiveFrom", "effectiveTo") WITH &&)
  ///     — an EXCLUDE constraint; Prisma has no syntax for one. THIS is what
  ///       makes "two rates in effect at the same instant" unrepresentable, the
  ///       way T3's composite FK makes a cross-tenant visit unrepresentable.
  ///       Needs the `btree_gist` extension, created by the same migration.
  ///
  ///   price_rates_published_needs_source  CHECK (
  ///       provenance <> 'published'
  ///       OR ("sourceUrl" IS NOT NULL AND "sourceReadAt" IS NOT NULL))
  ///
  ///   price_rates_unit_quantity_matches_type  CHECK (
  ///       ("unitType" IN ('tokens_input','tokens_output','cache_write_5m',
  ///                       'cache_write_1h','cache_read') AND "unitQuantity" = 1000000)
  ///       OR ("unitType" = 'audio_minutes' AND "unitQuantity" = 1))
  ///     — a naive "fix" that drops this to let a new unit type through would
  ///       not close drift, it would let a rate mean something nobody declared.
  ///       A new unit type is a migration, and that refusal is the feature.
  @@map("price_rates")
}

// ============================================================================
// LEDGER ENTRY — B5. The practice wallet, append-only, integer micro-dollars.
// ============================================================================
// SPEC §2.1: append-only `LedgerEntry` with kinds grant/topup/usage/refund/
// adjustment and a `balanceAfter` on every row; the balance is a property of
// the PRACTICE, not the user. GATE 0.4 / SPEC §4.4: integer micro-dollars
// ledger-wide, no float anywhere.
//
// ⚠️ NOTHING WRITES THIS TABLE YET, AND THAT IS DELIBERATE. The application
// writer is B6 (`charge = cost × 3 / 2`, prod-only), top-ups are B7, and the
// fail-closed balance block is B8. B5 ships the SHAPE and its guarantees so
// that the writer is built against a table that already refuses to be wrong.
//
// ⚠️ APPEND-ONLY IS ENFORCED BY TRIGGERS, NOT BY CONVENTION, AND TRIGGERS ARE
// INVISIBLE TO PRISMA. Everything below that matters is in
// `20260811070000_b5_ledger_entries/migration.sql`. Read it before changing
// anything here — `prisma migrate dev` will not recreate any of it.
// ============================================================================
model LedgerEntry {
  id String @id @default(cuid())

  /// NULLABLE + SetNull — the S4c financial-record rule, the same pair
  /// `AuditLog` uses. `delete-account/route.ts:184` states it: an audit trail
  /// and a financial record must OUTLIVE the account they describe.
  ///
  /// ⚠️ A RESTRICT here would make account deletion impossible, which is the
  /// bug S4c was created to fix and which `RxWarningOverride`'s RESTRICT
  /// repeated. On an APPEND-ONLY table it is strictly worse: there is no delete
  /// that could ever clear the blocker.
  ///
  /// ⚠️ NULL IS NOT A LEGAL INSERT VALUE. The insert trigger refuses it. The
  /// column is nullable solely so a later practice deletion can detach the row.
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)

  /// Tombstone carrying no FK — survives the practice row, so "whose money was
  /// this" stays answerable after a deletion. NOT NULL, unlike `AuditLog`'s,
  /// because this table has no legacy population to accommodate: a ledger row
  /// with no tenant is unreconcilable (B9), so it is unrepresentable.
  /// Derived by the trigger from `practiceId`; a caller cannot set it.
  practiceIdSnapshot String

  /// Which balance this row moves: "paid" | "promo". CHECK-pinned.
  ///
  /// ⚠️ TWO SEPARATE RUNNING BALANCES, NOT ONE NUMBER WITH A NOTE — SPEC §2.4.
  /// It is here in B5 rather than in B7 with the promo grant because an
  /// APPEND-ONLY TABLE CANNOT BE RETROFITTED: adding it later needs either a
  /// DEFAULT (the fail-open provenance shape ruling 67 forbids) or a backfill
  /// UPDATE (the one operation this table exists to refuse).
  bucket String

  /// "grant" | "topup" | "usage" | "refund" | "adjustment" — SPEC §2.1,
  /// CHECK-pinned. A new kind is a migration, and that refusal is the feature.
  kind String

  /// SIGNED micro-dollars. The balance is the running sum, so a debit is a
  /// negative amount rather than a positive number with a direction flag.
  ///
  /// Sign is CHECK-constrained for `usage` (<= 0), `topup` (> 0) and `grant`
  /// (> 0) only. `refund` and `adjustment` are deliberately unconstrained —
  /// nothing in SPEC settles whether a refund credits the wallet or debits it,
  /// and guessing would mean WEAKENING a shipped constraint if wrong. Adding a
  /// rule later is the allowed direction.
  amountMicroUsd BigInt

  /// THE RUNNING BALANCE AFTER THIS ROW, and THE SEQUENCE POSITION.
  ///
  /// ⚠️ BOTH ARE DATABASE-OWNED. `ledger_entries_derive()` computes them from
  /// the previous row and OVERWRITES whatever the caller sent — it does not
  /// validate a caller-supplied value, it ignores it. AGENTS.md: a hand-passed
  /// value can drift, a derived one cannot, and on an append-only table a wrong
  /// balance can never be corrected in place.
  ///
  /// The `@default(0)` exists only so a Prisma caller need not send a value it
  /// is not allowed to choose. It is never the value that lands.
  ///
  /// ⚠️ AND IF THE DERIVE TRIGGER IS EVER LOST, THE TABLE BECOMES UNWRITABLE
  /// RATHER THAN QUIETLY WRONG — measured, not reasoned. With the trigger
  /// dropped inside a rolled-back transaction, the insert was REFUSED:
  ///
  ///     ERROR: new row for relation "ledger_entries" violates check
  ///            constraint "ledger_entries_seq_positive"
  ///
  /// because `seq` defaults to 0 and the CHECK requires > 0. So a regenerated
  /// migration that drops the triggers does not produce a ledger of zeroes —
  /// it produces a ledger nothing can write to, which is the direction a
  /// money table should fail in. The migration's own header understates this;
  /// this is the measured behaviour.
  balanceAfter BigInt @default(0)
  seq          BigInt @default(0)

  /// Optional, GLOBALLY unique. Idempotency matters MORE on an append-only
  /// table than on a mutable one: a duplicate row can never be deleted.
  /// NULLs are distinct in a btree unique, so keyless rows never collide.
  idempotencyKey String? @unique

  note String?

  /// B6 / SPEC §2.2 — THE VERSIONED PRICE SNAPSHOT: which `price_rates` rows
  /// priced this charge, the pre-multiplier cost, and the per-component
  /// breakdown, "so a later rate change never re-prices history".
  ///
  /// NULL for the kinds that are not the output of a pricing computation —
  /// `grant` and `topup` are money arriving, not money computed. NOT NULL for
  /// `usage`, enforced by `ledger_entries_usage_has_pricing` because a charge
  /// that cannot say what priced it is unreconcilable by B9 and uncorrectable
  /// by anything, the table being append-only.
  ///
  /// ⚠️ IT LANDED IN B6 BECAUSE THE TABLE WAS STILL EMPTY. Ruling 89(e)'s
  /// argument for shipping `bucket` early applies here verbatim and was not
  /// made for this column in B5: an append-only table cannot be retrofitted,
  /// because the retrofit needs either a DEFAULT (fail-open) or a backfill
  /// UPDATE (the one operation this table refuses). Zero rows is what made it
  /// free. `20260811103000_b6_ledger_pricing_snapshot/migration.sql`.
  pricing Json?

  /// ⚠️ ORDER BY `seq`, NEVER BY `createdAt`. This defaults to
  /// CURRENT_TIMESTAMP, which is TRANSACTION START time — two rows written in
  /// one transaction share it exactly. `seq` is the ledger's order.
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// The (practice, bucket) sequence. Also the index the derive trigger reads
  /// and the one `ON DELETE SET NULL` needs when a practice is deleted.
  @@unique([practiceId, bucket, seq])
  /// ⚠️ FIVE CHECK CONSTRAINTS AND FOUR TRIGGERS ON THIS TABLE ARE INEXPRESSIBLE
  /// IN PRISMA and are declared here so the drift enumeration can see them
  /// (AGENTS.md rule 7). Their real DDL is in
  /// `20260811070000_b5_ledger_entries/migration.sql`:
  ///
  ///   ledger_entries_bucket_vocabulary   CHECK (bucket IN ('paid','promo'))
  ///   ledger_entries_kind_vocabulary     CHECK (kind IN ('grant','topup',
  ///                                        'usage','refund','adjustment'))
  ///   ledger_entries_kind_sign           CHECK — usage <= 0, topup > 0,
  ///                                        grant > 0; refund/adjustment free
  ///   ledger_entries_seq_positive        CHECK (seq > 0) — a 0 means the
  ///                                        derive trigger did not run
  ///   ledger_entries_snapshot_agrees     CHECK ("practiceId" IS NULL
  ///                                        OR "practiceId" = "practiceIdSnapshot")
  ///   ledger_entries_usage_has_pricing   CHECK ("kind" <> 'usage'
  ///                                        OR "pricing" IS NOT NULL) — B6
  ///
  ///   ledger_entries_derive_before_insert          derives seq + balanceAfter
  ///                                        + practiceIdSnapshot, under a
  ///                                        per-(practice,bucket) advisory lock
  ///   ledger_entries_append_only_before_update     refuses every UPDATE except
  ///                                        the S4c detach (practiceId NOT NULL
  ///                                        → NULL, every other column compared
  ///                                        wholesale as jsonb)
  ///   ledger_entries_append_only_before_delete     refuses DELETE
  ///   ledger_entries_append_only_before_truncate   refuses TRUNCATE — a
  ///                                        STATEMENT-level trigger, because
  ///                                        TRUNCATE fires neither row trigger
  ///
  /// ⚠️ A NAIVE "fix" that drops any of them to let a new bucket, kind or
  /// correction through does not close drift — it removes the guarantee. A new
  /// value is a migration. And `prisma migrate dev` will never regenerate the
  /// triggers: they exist only in that migration file.
  @@map("ledger_entries")
}
