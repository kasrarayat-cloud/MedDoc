#!/usr/bin/env bash
# ============================================================================
# Refuse a push that would cancel somebody's in-flight required runs.
# ----------------------------------------------------------------------------
# WHY THIS EXISTS
#
# GitHub cancels in-flight runs when a new commit lands on the same ref — every
# workflow here groups per-ref with `cancel-in-progress: true`. That is the
# mechanic, not a bug, so a push is a decision about somebody's evidence.
#
# AGENTS.md has carried the two-view rule since 2026-08-09 and the class kept
# recurring anyway — five times, the last on 2026-08-12 when a session amended
# and force-pushed three minutes into its own run and cancelled `CI`, `e2e` and
# `a11y-ci`. A rule that does not reach behaviour becomes mechanism. This is
# that move, the same one the §2.5 gate made.
#
# WHAT IT DOES: for every ref being pushed, takes BOTH views of the runs on the
# ref's CURRENT remote head — `--commit` and `--branch` — and refuses if either
# shows a run that is not `completed`.
#
# ⚠️ IT MECHANIZES THE **PUSH** SIDE ONLY, AND THAT IS SAID HERE SO THE NAME DOES
# NOT READ WIDER THAN THE WATCHED SET. `gh pr merge` merges SERVER-SIDE and never
# invokes a client hook, so the MERGE-side class — AGENTS.md's "A MERGE IS A PUSH"
# — is guarded by `scripts/merge-pr.sh`, not by this file. Two doors, two guards,
# one shared check in `scripts/lib/inflight.sh`.
#
# ⚠️ BOTH VIEWS, DELIBERATELY, AND NEITHER IS REDUNDANT. `--commit` under-reports
# in the propagation window right after a push (measured: `[]` from --commit while
# --branch showed three runs pending on that very SHA, seconds apart) — and that
# window is exactly when this hook runs. `--branch` is the view that is right
# first. A zero is believed only when both agree.
#
# ⚠️ A ZERO IS POSITIVE-CONTROLLED. A broken or unauthenticated `gh` returns the
# same empty list as a quiet branch, so the hook first confirms the runs API
# answers for this repo at all. If it cannot tell, it REFUSES — "cannot tell" is
# not "clear", and this repo's posture is fail-closed.
#
# Install: automatic. `npm install` runs the root `prepare` script, which sets
# core.hooksPath. Hooks do not travel with a clone, so FOUNDATION STEP 0 asserts
# this file is live rather than assuming it:
#     bash scripts/check-hooks-installed.sh
#
# ⚠️ THE LEGITIMATE OVERRIDE IS A DECLARATION, NOT A BYPASS. The batching rule
# allows a deliberate cancellation when it is DECLARED in the log first:
#
#     DECLARE_CANCELLATION="merging #618 and #619 as one batch; #618's e2e is
#     mine and I am discarding it knowingly" git push …
#
# The reason is echoed to stderr — which IS the log for an unattended session,
# whose output the loop captures — and it must be prose. A bare `1`/`true`/`yes`
# is refused: a declaration wearing a token's clothes is a bypass, and an audit
# trail's "why" is somebody's words or nothing.
# ============================================================================

set -uo pipefail

ZERO=0000000000000000000000000000000000000000
REMOTE="${1:-origin}"

# ⚠️ THE SHARED CHECK IS SOURCED, AND ITS ABSENCE IS FAIL-CLOSED. A hook that
# silently skipped its own logic because a file moved would be worse than no hook.
# ⚠️ ANCHORED TO THIS SCRIPT, NOT TO `git rev-parse --show-toplevel` AND NOT TO
# cwd. The first version used --show-toplevel and resolved against whatever repo
# the CALLER was standing in — in a worktree that is a different tree, so the lib
# was never found and the hook refused every push while looking like it worked.
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" 2>/dev/null && pwd)/inflight.sh"
if [ ! -r "$LIB" ]; then
  echo "pre-push: REFUSED — cannot tell: $LIB is missing or unreadable." >&2
  exit 1
fi
# shellcheck source=../lib/inflight.sh
. "$LIB"

DECL="${DECLARE_CANCELLATION:-}"
inflight_declaration_ok "$DECL" || { echo "pre-push: (DECLARE_CANCELLATION)" >&2; exit 1; }
inflight_require_gh       || { echo "pre-push: refusing. Declare with DECLARE_CANCELLATION=\"<reason>\"." >&2; exit 1; }
inflight_positive_control || { echo "pre-push: refusing." >&2; exit 1; }

busy_total=0
report=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # branches only
  [ "$remote_sha" = "$ZERO" ] && continue                      # new branch: nothing to cancel

  branch="${remote_ref#refs/heads/}"

  inflight_count "$branch" "$remote_sha" || { echo "pre-push: refusing." >&2; exit 1; }
  by_commit=$INFLIGHT_BY_COMMIT
  by_branch=$INFLIGHT_BY_BRANCH

  # ⚠️ A DEGRADED TRANSPORT IS ANNOUNCED EVEN WHEN THE ANSWER IS "CLEAR" — in
  # fact ESPECIALLY then. Since F14-b a repo-wide outage no longer blinds this
  # hook: `lib/runs-api.sh` falls back to the per-workflow route. But the BRANCH
  # half of the count has no coverage control in that mode, so a zero there is a
  # FLOOR rather than a measurement, and a push allowed on a floor is a push
  # nobody can audit afterwards. Printing it costs one line; not printing it
  # turns a known limit into an invisible one.
  if [ "${INFLIGHT_DEGRADED:-0}" = "1" ]; then
    echo "pre-push: ${INFLIGHT_NOTE}" >&2
    echo "          ${branch} @ ${remote_sha:0:8} — --commit ${by_commit}, --branch ${by_branch}" >&2
  fi

  if [ "$by_commit" -gt 0 ] || [ "$by_branch" -gt 0 ]; then
    busy_total=$(( busy_total + by_commit + by_branch ))
    report="${report}    · ${branch} @ ${remote_sha:0:8} — in flight: --commit ${by_commit}, --branch ${by_branch}"$'\n'
  fi
done

if [ "$busy_total" -eq 0 ]; then
  exit 0
fi

if [ -n "$DECL" ]; then
  {
    echo "═══════════════════════════════════════════════════════════════════"
    echo "DECLARED CANCELLATION — $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "  remote : $REMOTE"
    echo "  runs this push will cancel:"
    printf '%s' "$report"
    echo "  declared reason:"
    echo "    $DECL"
    echo "═══════════════════════════════════════════════════════════════════"
  } >&2
  exit 0
fi

{
  echo ""
  echo "🔴 pre-push REFUSED — this push would cancel runs that are in flight."
  echo ""
  printf '%s' "$report"
  echo ""
  echo "  GitHub cancels in-flight runs on a new push to the same ref. Those runs"
  echo "  are somebody's evidence — possibly a citation being waited on."
  echo ""
  echo "  Either WAIT for them, or BATCH this commit with the next one (the cheap"
  echo "  habit that avoids nearly all of these), or declare the cancellation:"
  echo ""
  echo "      DECLARE_CANCELLATION=\"why this is deliberate\" git push …"
  echo ""
} >&2
exit 1
