# ============================================================================
# MedDoc Pro — Production Environment Variables
# ----------------------------------------------------------------------------
# INSTRUCTIONS:
#   1. Copy this file to /opt/meddoc-pro/.env on the VPS.
#   2. Replace every REPLACE_ME / CHANGE_ME placeholder with a real value.
#   3. NEVER commit the real .env — it's gitignored, but double-check.
#   4. After changing any value, recreate the affected containers:
#        docker compose up -d --force-recreate <service>
#      (env_file is read at container start; live edits don't propagate.)
#
# Each variable is tagged:
#   [REQUIRED]  — deploy fails without it.
#   [RECOMMENDED] — deploy works but a feature is broken / unsafe without it.
#   [OPTIONAL]  — has a safe default; override only for tuning.
# ============================================================================


# ============================================================================
# DATABASE — PostgreSQL 16 + pgvector (inside Docker)
# ============================================================================

# [REQUIRED] Master DB password. The compose file substitutes this into
# POSTGRES_PASSWORD, DATABASE_URL for every service, and the pgvector
# container's init. Minimum 16 chars recommended.
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# [REQUIRED] Full DSN. Keep the shape — only the password portion comes
# from DB_PASSWORD above. Used by Prisma client + migration runner.
DATABASE_URL=postgresql://meddoc:CHANGE_ME_DB_PASSWORD@postgres:5432/meddoc?schema=public


# ============================================================================
# AUTHENTICATION — NextAuth / Auth.js v5
# ============================================================================

# [REQUIRED] JWT signing secret. Generate with: openssl rand -base64 32
# If unset, the code falls back to a literal dev string — treat as CRITICAL.
AUTH_SECRET=CHANGE_ME_RANDOM_32_CHAR_STRING

# [REQUIRED] Public URL of the deployment. Used by NextAuth for callback
# URLs and by the marketing site for cross-app links. IP is OK pre-DNS.
PUBLIC_URL=http://YOUR_VPS_IP_OR_DOMAIN

# [REQUIRED] Explicit AUTH_URL for the meddoc-pro app. Defaults to
# PUBLIC_URL in compose; override only for split-domain setups.
AUTH_URL=${PUBLIC_URL}

# [REQUIRED] Same AUTH_URL but for the transcribe-md app (different port).
TRANSCRIBE_MD_AUTH_URL=http://YOUR_VPS_IP_OR_DOMAIN:9020

# [REQUIRED] Public URL of the marketing site (port 9010). Used by
# transcribe-md to link back to /terms, /privacy, /hipaa, etc.
MARKETING_URL=http://YOUR_VPS_IP_OR_DOMAIN:9010

# [OPTIONAL] Cookie domain override. Leave blank for host-only cookies
# (default). Set to e.g. ".example.com" once DNS is in place and you want
# shared sessions across subdomains.
AUTH_COOKIE_DOMAIN=

# [OPTIONAL] Testing shortcut: set true to bypass auth middleware. NEVER
# set to "true" in production.
AUTH_USE_MOCK=false


# ============================================================================
# PUBLIC URLs — bundled into client code (NEXT_PUBLIC_ prefix)
# ============================================================================
# These are embedded at BUILD TIME into the client JS bundle. Changing them
# requires a docker rebuild, not just a container restart.

# [REQUIRED] Same as MARKETING_URL above but visible to the browser.
NEXT_PUBLIC_MARKETING_URL=http://YOUR_VPS_IP_OR_DOMAIN:9010

# [REQUIRED] Public URL of the transcribe-md app. Used by the marketing
# site's "Sign up" button and by cross-app redirects.
NEXT_PUBLIC_TRANSCRIBE_MD_APP_URL=http://YOUR_VPS_IP_OR_DOMAIN:9020


# ============================================================================
# AI PROVIDERS
# ============================================================================

# [REQUIRED] Anthropic Claude — used by all 6 TranscribeMD pipeline layers
# and by meddoc-pro Doc Editor. BAA with Anthropic REQUIRED before
# sending real patient data.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# [REQUIRED] OpenAI — used for:
#   - meddoc-pro: Whisper transcription, GPT-4o-mini Doc Editor, Realtime
#   - transcribe-md (T-M14.1): text-embedding-3-small for edit capture
# BAA with OpenAI REQUIRED before sending real patient data.
OPENAI_API_KEY=sk-proj-REPLACE_ME

# [OPTIONAL] Embedding model override. Default: text-embedding-3-small.
# Any swap to a different-dimension model requires a schema change
# (doctor_edit_patterns.embedding is vector(1536)).
OPENAI_EMBED_MODEL=text-embedding-3-small

# [REQUIRED] Deepgram — batch transcription for TranscribeMD audio mode.
# BAA with Deepgram REQUIRED before sending real patient audio.
DEEPGRAM_API_KEY=REPLACE_ME_DEEPGRAM_KEY

# [OPTIONAL] Deepgram model. Default: nova-3-medical (HIPAA-eligible).
DEEPGRAM_MODEL=nova-3-medical

# [OPTIONAL] Cross-provider transcription fallback kill-switch (audit 4.2).
# On a transient Deepgram failure the pipeline CAN fall back to OpenAI
# Whisper — which ships raw patient AUDIO to OpenAI, requiring a
# countersigned OpenAI BAA. FAIL-CLOSED: the fallback is DISABLED unless
# this is set to exactly "true". When disabled, a Deepgram failure fails the
# visit into the retryable DLQ (surfaced on /admin/queues) and emits a
# TRANSCRIPTION_PROVIDER_FALLBACK audit row — it NEVER silently calls OpenAI.
# DO NOT enable until an OpenAI BAA is on file (see docs/BAA_CHECKLIST.md).
# TRANSCRIBE_MD_WHISPER_FALLBACK_ENABLED=true

# ============================================================================
# AI PRICING OVERRIDES — integer cents per million tokens
# ============================================================================
# All four default to published rates. Override only if your BAA or
# enterprise plan changes the rate card.

# [OPTIONAL] Claude Sonnet 4.6 input token rate. Default 300 (= $3/M).
# CLAUDE_SONNET_46_INPUT_CENTS_PER_M=300

# [OPTIONAL] Claude Sonnet 4.6 output token rate. Default 1500 (= $15/M).
# CLAUDE_SONNET_46_OUTPUT_CENTS_PER_M=1500

# [OPTIONAL] OpenAI text-embedding-3-small rate. Default 2 (= $0.02/M).
# OPENAI_EMBED_SMALL_CENTS_PER_M=2

# [OPTIONAL] Deepgram Nova-3 Medical per-minute rate. Default 1.45 cents.
# DEEPGRAM_COST_PER_MIN_CENTS=1.45


# ============================================================================
# STORAGE — MinIO (audio + artifacts) + Redis (BullMQ broker)
# ============================================================================

# [REQUIRED] MinIO root credentials. Used both by the minio container
# itself and by app code as MINIO_ACCESS_KEY/SECRET_KEY via compose
# substitution. Minimum 8 chars.
MINIO_ROOT_USER=meddoc
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# The following three are set in docker-compose.yml (referenced here for
# documentation only — do not duplicate in .env):
#   MINIO_ENDPOINT=minio:9000
#   MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
#   MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
#   MINIO_USE_SSL=false

# [OPTIONAL] Bucket name for TranscribeMD audio uploads. Default:
# transcribe-md-audio. The bucket is created at worker boot if absent.
TRANSCRIBE_MD_MINIO_BUCKET=transcribe-md-audio

# [REQUIRED] Redis connection string — BullMQ broker. Set in compose
# default to redis://redis:6379, but included here for overrides (e.g.
# Upstash Redis for multi-VPS deploys).
# REDIS_URL=redis://redis:6379


# ============================================================================
# EMAIL — Resend (signed-note delivery)
# ============================================================================

# [RECOMMENDED] Resend API key. Leave blank to DISABLE the email-export
# feature end-to-end — the UI checkbox hides automatically.
RESEND_API_KEY=

# [RECOMMENDED] From address. Must be on a domain you have verified at
# resend.com/domains.
RESEND_FROM=noreply@YOUR_DOMAIN

# [REQUIRED if RESEND_API_KEY is set] Flip to "true" only AFTER domain
# verification is complete. Acts as a belt-and-braces kill-switch — the
# UI checks this before showing the "Email to me" option.
RESEND_FROM_VERIFIED=false


# ============================================================================
# TRANSCRIBE-MD WORKER — tuning
# ============================================================================

# [OPTIONAL] BullMQ concurrency — how many visits the worker processes
# in parallel. Default: 2. Tune with docker stats + host RAM headroom.
TRANSCRIBE_MD_WORKER_CONCURRENCY=2

# [OPTIONAL] Per-job timeout in ms. Default: 900000 (15 min). Raise for
# large audio files; lower to surface stuck jobs faster.
# TRANSCRIBE_MD_JOB_TIMEOUT_MS=900000

# [OPTIONAL] MIME type for dictation audio. Default: audio/webm
# (MediaRecorder on Chrome/Edge/Firefox). Override if the frontend
# MediaRecorder is configured differently.
# TRANSCRIBE_MD_DICTATION_MIME=audio/webm


# ============================================================================
# FEATURE FLAGS — T-M6 automation layers
# ============================================================================
# All default to "true" (enabled). Flip to "false" to disable per layer —
# useful for rolling a single automation back if it misbehaves in prod.

# [OPTIONAL] Layer 7a — ICD/CPT coding suggestions.
TM_ENABLE_ICD_CPT=true

# [OPTIONAL] Layer 7c — prescription drafting.
TM_ENABLE_RX=true

# [OPTIONAL] Layer 7d — referral drafting.
TM_ENABLE_REFERRALS=true

# [OPTIONAL] Layer 7e — plain-language patient summary.
TM_ENABLE_PATIENT_SUMMARY=true


# ============================================================================
# MinIO ORPHAN CLEANUP — T-M12 scheduled task
# ============================================================================

# [OPTIONAL] Master switch for the cron. Default: false. Flip to "true"
# to enable weekly orphan cleanup.
MINIO_ORPHAN_CLEANUP_ENABLED=false

# [OPTIONAL] Dry-run mode. Default: true (logs what WOULD be deleted,
# doesn't touch anything). Set to "false" for real deletions.
MINIO_ORPHAN_CLEANUP_DRY_RUN=true

# [OPTIONAL] How many days an object must be older than to be a deletion
# candidate. Default: 30. Shorter = more aggressive reclamation, longer =
# more safety margin against the "race with in-flight upload" case.
MINIO_ORPHAN_CLEANUP_RETENTION_DAYS=30

# [OPTIONAL] Cron schedule. Default: "0 3 * * 0" (Sunday 03:00 UTC).
MINIO_ORPHAN_CLEANUP_CRON=0 3 * * 0


# ============================================================================
# MEDDOC-PRO VOICE FEATURES (not used by TranscribeMD)
# ============================================================================
# These drive the Realtime-voice-assistant in meddoc-pro. If you're
# deploying TranscribeMD only, you can ignore this block.

# [OPTIONAL] Realtime model. Default: gpt-realtime.
REALTIME_MODEL=gpt-realtime

# [OPTIONAL] Voice profile. Default: coral.
REALTIME_VOICE=coral

# [OPTIONAL] Daily cap on realtime minutes per user. Default: 120.
# Prevents runaway spend if a session is left open.
VOICE_MINUTES_PER_USER_DAILY_CAP=120


# ============================================================================
# OBSERVABILITY — Sentry (T-M16.3: both apps + worker)
# ============================================================================
# Sentry runs in three surfaces per app (browser / server / edge) plus
# an extra @sentry/node init in the transcribe-md worker. All share the
# same PHI-scrubbed beforeSend so nothing that looks like email/phone/
# SSN or a multi-word free-text blob ever leaves the host.

# [OPTIONAL] Server-side Sentry DSN for apps/meddoc-pro. Empty = no-op.
SENTRY_DSN_MEDDOC_PRO=
# Legacy alias read by Sentry's SDK when a scoped DSN is unset.
SENTRY_DSN=

# [OPTIONAL] Server-side Sentry DSN for apps/transcribe-md + its worker.
# Landing on a DIFFERENT Sentry project than meddoc-pro lets ops filter
# alerts per-product.
SENTRY_DSN_TRANSCRIBE_MD=

# [OPTIONAL] Browser-side DSNs. Must start with NEXT_PUBLIC_ so the
# Next bundler embeds them in the client JS. Mirror their server-side
# counterparts.
NEXT_PUBLIC_SENTRY_DSN_MEDDOC_PRO=
NEXT_PUBLIC_SENTRY_DSN_TRANSCRIBE_MD=

# [OPTIONAL] Environment tag — partitions events in the Sentry UI.
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# [OPTIONAL] Release tag. Use the git SHA (short form) so rollbacks
# land cleanly under the prior release's alerts.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=


# ============================================================================
# TESTING
# ============================================================================

# [OPTIONAL] E2E/unit test hook — when "true", modelClient.complete(),
# modelClient.completeText(), deepgramBatchTranscribe(), and embedText()
# all short-circuit to deterministic fixtures (packages/ai/src/mock.ts).
# NEVER set "true" in production.
MOCK_AI_CALLS=false


# ============================================================================
# FEATURE FLAGS + UI TOGGLES
# ============================================================================

# [OPTIONAL] Expose the clinical-rules version string in UI hints.
# Bumped when the SOAP / critique prompts are materially changed so
# ops can correlate a regression to a prompt revision. Falls back to
# "unknown" if unset.
NEXT_PUBLIC_CLINICAL_RULES_VERSION=

# [OPTIONAL] Show the Pipeline tab (Layer 1-7 debug view with raw
# entities JSON, wall-time, cost). "true" to show. Default hidden in
# production — the tab is for devs, not doctors.
NEXT_PUBLIC_SHOW_PIPELINE_TAB=false

# [OPTIONAL] Human-readable app version shown in the footer / client
# error reports. Suggest: short git SHA + tag.
APP_VERSION=

# [OPTIONAL] Whether the "Export my data" flow is live. Default false
# until the downstream email/queue pathway is finalised.
ENABLE_DATA_EXPORT=false

# [OPTIONAL] Directory that ships the PDF fonts used by the SOAP-note
# renderer in the worker. Container-relative path. Defaults to the
# bundled fonts under the transcribe-md image.
PDF_FONTS_DIR=

# [OPTIONAL] MIME type the live-record flow sends dictation as. Falls
# back to audio/webm if unset. Only override if you've swapped the
# MediaRecorder codec on the client.
TRANSCRIBE_MD_DICTATION_MIME=audio/webm


# ============================================================================
# RETENTION + CLEANUP (worker crons)
# ============================================================================

# [OPTIONAL] Days after which an audio file in MinIO is purged. Per-
# practice override lives in Practice.audioRetentionDays; this is the
# global fallback. Default 180.
AUDIO_RETENTION_DAYS=180

# [OPTIONAL] Master switch for the retention sweep cron. Default true.
RETENTION_SWEEP_ENABLED=true

# [OPTIONAL] Cron expression for the retention sweep (node-cron
# syntax). Default "0 3 * * *" (daily at 03:00 UTC).
RETENTION_SWEEP_CRON=0 3 * * *

# [OPTIONAL] Master switch for the stale-visit cleanup cron — marks
# visits that have been QUEUED / PROCESSING too long as FAILED so
# they don't hang the UI forever. Default true.
STALE_VISIT_CLEANUP_ENABLED=true

# [OPTIONAL] Cron expression for stale-visit cleanup. Default
# "*/15 * * * *" (every 15 minutes).
STALE_VISIT_CLEANUP_CRON=*/15 * * * *


# ============================================================================
# WORKER + DB TUNING
# ============================================================================

# [OPTIONAL] BullMQ job timeout in ms — any pipeline job that runs
# longer is aborted. Default 300000 (5 min). Bump for cohort-cardio
# cases that routinely hit the layer-3 retry path.
TRANSCRIBE_MD_JOB_TIMEOUT_MS=300000

# [OPTIONAL] Prisma PG driver-adapter pool cap. Default 10. Sum
# across all app containers should stay under Postgres'
# max_connections (100 by default).
PRISMA_POOL_MAX=10

# [OPTIONAL] How long a caller waits for a free connection before
# giving up (ms). Default 20000.
PRISMA_POOL_TIMEOUT_MS=20000

# [OPTIONAL] Postgres-side statement timeout (ms). Injected via
# `options=-c statement_timeout=...` on the connection string so a
# slow query can't hold a pool slot forever. Default 30000.
PRISMA_STATEMENT_TIMEOUT_MS=30000


# ============================================================================
# RUNTIME
# ============================================================================
# These are set by the compose file or Docker directly; listed here for
# visibility. You typically don't need to override them in .env.
#
#   NODE_ENV=production              # set by compose `environment:`
#   NEXT_TELEMETRY_DISABLED=1        # set by compose
#   NEXT_PHASE=(set by Next)         # phase-production-build / -runtime
#   PORT=(service default)           # set by each Dockerfile
