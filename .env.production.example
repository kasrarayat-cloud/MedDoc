# ============================================================================
# MedDoc Pro — Production Environment Variables
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to your VPS as .env (NOT .env.production)
# 2. Replace ALL placeholder values below with real credentials
# 3. NEVER commit this file to git with real values
# ============================================================================

# ── Database (Postgres inside Docker) ──
DATABASE_URL=postgresql://meddoc:CHANGE_THIS_DB_PASSWORD@postgres:5432/meddoc?schema=public

# ── NextAuth / Auth.js ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
AUTH_USE_MOCK=false
NEXTAUTH_URL=http://YOUR_VPS_IP:3000

# ── OpenAI (Whisper + GPT-4o-mini) ──
OPENAI_API_KEY=sk-proj-YOUR_REAL_KEY_HERE

# ── OpenAI Realtime (voice assistant) ──
# Override the default realtime model / voice if desired.
# Defaults in code: model=gpt-realtime, voice=coral.
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=coral

# Daily cap on realtime voice minutes per user. Prevents runaway spend if
# a session is left open. Default in code is 120.
VOICE_MINUTES_PER_USER_DAILY_CAP=120

# ── Scribe subdomain (M1+) ──
SCRIBE_PUBLIC_URL=http://scribe.YOUR_DOMAIN_OR_IP
# Must cover both subdomains so the JWT cookie is shared. Dev uses .localhost.
AUTH_COOKIE_DOMAIN=.YOUR_DOMAIN
MEDDOC_PRO_PUBLIC_URL=http://YOUR_DOMAIN_OR_IP

# ── Scribe batch pipeline (M2) ──
# Anthropic for transcript cleanup + SOAP generation. Never use an alias
# like `claude-sonnet-4`; always pin a specific version.
ANTHROPIC_API_KEY=sk-ant-YOUR_REAL_KEY_HERE
MODEL_FOR_CLEANUP=claude-sonnet-4-6
MODEL_FOR_SOAP=claude-sonnet-4-6
# OpenAI model for batch transcription. Swap to whisper-1 if cost/quality
# trade-offs shift.
TRANSCRIPTION_MODEL=gpt-4o-transcribe

# MinIO (S3-compatible object storage for uploaded audio).
MINIO_ROOT_USER=meddoc
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_PASSWORD
MINIO_BUCKET=scribe-audio

# BullMQ / Redis worker concurrency.
SCRIBE_WORKER_CONCURRENCY=2

# ── Scribe full output bundle (M4) ──
# Models for the 4 parallel extractions. All default to Claude Sonnet 4.6.
# Spec §5 suggests GPT-4o for referral / patient_summary but the OpenAI
# complete() path is deferred to M7 — only Anthropic works today.
MODEL_FOR_CODING=claude-sonnet-4-6
MODEL_FOR_RX=claude-sonnet-4-6
MODEL_FOR_REFERRAL=claude-sonnet-4-6
MODEL_FOR_PATIENT_SUMMARY=claude-sonnet-4-6
# Per-output feature flags (M4 D10). Set to "false" to disable an
# extraction for all new visits without redeploying code. Skipped outputs
# still get a ScribeOutput row with an OutputError sentinel +
# OUTPUT_SKIPPED_FLAG_OFF audit so the review UI can surface "Disabled".
SCRIBE_EXTRACT_CODING=true
SCRIBE_EXTRACT_RX=true
SCRIBE_EXTRACT_REFERRALS=true
SCRIBE_EXTRACT_PATIENT_SUMMARY=true

# ── Scribe real-time (M3) ──
# Deepgram Nova-3 Medical is the streaming ASR for live visits (spec §5/§9).
# BAA REQUIRED with Deepgram before sending real patient audio — flag in
# README before any production traffic.
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_KEY_HERE
DEEPGRAM_MODEL=nova-3-medical
# Port the scribe-ws sidecar listens on internally (Caddy proxies
# scribe.<domain>/api/ws/* → here). Change only if 3003 collides.
SCRIBE_WS_PORT=3003

# Service token used by apps/scribe → apps/meddoc-pro /api/internal/*.
# Generate with: openssl rand -base64 48
# Must be ≥32 chars. Rotate with a restart of both scribe and meddoc-pro.
SCRIBE_SERVICE_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# ── Harden & ship (M7) ──
# File-based rotation: if this path exists, the service token is read
# from the file instead of the env var. Lets a secret-mount + restart
# rotate the token without editing .env. See docs/ROTATION_RUNBOOK.md.
# SCRIBE_SERVICE_TOKEN_FILE=/run/secrets/scribe_service_token

# Sentry DSNs — one project per app so alert routing stays separable.
# Leave empty (or unset) in dev; Sentry no-ops with no DSN.
SENTRY_DSN_MEDDOC_PRO=
SENTRY_DSN_SCRIBE=
# Client-bundled — must start with NEXT_PUBLIC_ for Next.js to embed it.
NEXT_PUBLIC_SENTRY_DSN_MEDDOC_PRO=
NEXT_PUBLIC_SENTRY_DSN_SCRIBE=
# Set to "production" so Sentry partitions events by environment.
SENTRY_ENVIRONMENT=production
# Optional release tag (commit hash or semver). Sentry dedupes by this
# so a rollback lands under the prior release's alerts.
SENTRY_RELEASE=

# Retention (spec §13). Never set RETENTION_PURGE_LIVE=true until a
# clinical advisor has signed off on the dry-run numbers for a week.
# Defaults (90 days audio / 2555 days transcripts) live on the Practice
# row; override here only for whole-system guardrails.
RETENTION_PURGE_LIVE=false

# ── Node Environment ──
NODE_ENV=production
