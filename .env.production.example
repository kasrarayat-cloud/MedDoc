# ============================================================================
# MedDoc Pro — Production Environment Variables
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to your VPS as .env (NOT .env.production)
# 2. Replace ALL placeholder values below with real credentials
# 3. NEVER commit this file to git with real values
# ============================================================================

# ── Database (Postgres inside Docker) ──
DATABASE_URL=postgresql://meddoc:CHANGE_THIS_DB_PASSWORD@postgres:5432/meddoc?schema=public

# ── NextAuth / Auth.js ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
AUTH_USE_MOCK=false
NEXTAUTH_URL=http://YOUR_VPS_IP:3000

# Cookie domain — leave blank for host-only cookies (IP-based deploy).
# Set to e.g. `.example.com` once DNS is in place and you run multiple
# subdomains under the same apex.
AUTH_COOKIE_DOMAIN=

# ── OpenAI (Whisper + GPT-4o-mini for MedDoc Pro Doc Editor / Clinical Notes) ──
OPENAI_API_KEY=sk-proj-YOUR_REAL_KEY_HERE

# ── OpenAI Realtime (voice assistant) ──
# Override the default realtime model / voice if desired.
# Defaults in code: model=gpt-realtime, voice=coral.
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=coral

# Daily cap on realtime voice minutes per user. Prevents runaway spend if
# a session is left open. Default in code is 120.
VOICE_MINUTES_PER_USER_DAILY_CAP=120

# ── Anthropic (TranscribeMD worker pipeline) ──
# Never use an alias like `claude-sonnet-4`; always pin a specific version.
ANTHROPIC_API_KEY=sk-ant-YOUR_REAL_KEY_HERE

# ── MinIO (S3-compatible object storage for uploaded audio) ──
MINIO_ROOT_USER=meddoc
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_PASSWORD

# ── Deepgram (TranscribeMD worker batch transcription) ──
# BAA REQUIRED with Deepgram before sending real patient audio.
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_KEY_HERE
DEEPGRAM_MODEL=nova-3-medical

# ── Sentry ──
# Leave empty (or unset) in dev; Sentry no-ops with no DSN.
SENTRY_DSN_MEDDOC_PRO=
# Client-bundled — must start with NEXT_PUBLIC_ for Next.js to embed it.
NEXT_PUBLIC_SENTRY_DSN_MEDDOC_PRO=
# Set to "production" so Sentry partitions events by environment.
SENTRY_ENVIRONMENT=production
# Optional release tag (commit hash or semver). Sentry dedupes by this
# so a rollback lands under the prior release's alerts.
SENTRY_RELEASE=

# ── Node Environment ──
NODE_ENV=production
