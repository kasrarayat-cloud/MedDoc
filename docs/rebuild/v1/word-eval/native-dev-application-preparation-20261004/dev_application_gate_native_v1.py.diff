+def native_answer_readbacks(raw, export, fields, values):
+    """Independent complete-value reads from each native destination."""
+    old=w.SlotIndex(w.open_package(raw));new=w.SlotIndex(w.open_package(export));result={}
+    for field in fields:
+        key=field['key'];value=values.get(key)
+        if value is None:continue
+        loc=field['locator'];actual=None
+        if 'sdt_id' in loc:
+            matches=[slot for slot in new.slots if slot.kind=='sdt' and slot.part==loc['part']
+                and slot.el.find(w.q('w:sdtPr')+'/'+w.q('w:id')) is not None
+                and slot.el.find(w.q('w:sdtPr')+'/'+w.q('w:id')).get(w.q('w:val'))==loc['sdt_id']]
+            if len(matches)==1:actual=''.join(t.text or '' for t in matches[0].el.find(w.q('w:sdtContent')).iter(w.q('w:t')))
+            matched=actual==str(value)
+        elif 'tab_form' in loc:
+            paragraphs={part:list(new.package.tree(part).iter(w.q('w:p'))) for part in new.package.displayed_parts()}
+            actual='\n'.join(w.paragraph_text(paragraphs[a['part']][a['paragraph']])[0] for a in loc['tab_form']['anchors'])
+            matched=''.join(str(value).split()) in ''.join(actual.split())
+        elif 'body_paragraph' in loc:
+            original=old.package.tree('word/document.xml').find(w.q('w:body')).findall(w.q('w:p'))[loc['body_paragraph']]
+            current=new.package.tree('word/document.xml').find(w.q('w:body')).findall(w.q('w:p'))[loc['body_paragraph']]
+            caption=w.paragraph_text(original)[0];actual=w.paragraph_text(current)[0]
+            matched=actual.startswith(caption) and ''.join(str(value).split()) in ''.join(actual[len(caption):].split())
+        else:
+            table=new.package.tree('word/document.xml').find(w.q('w:body')).findall(w.q('w:tbl'))[loc['table']]
+            cell=w.row_cells_of(w.table_rows_of(table)[loc['row']])[loc['column']]
+            actual='\n'.join(w.paragraph_text(p)[0] for p in cell.findall(w.q('w:p')))
+            expected=str(value).removesuffix(' '+loc['unit']) if 'unit' in loc else str(value)
+            matched=''.join(expected.split()) in ''.join(actual.split())
+        result[key]={'expected':value,'actual':actual,'matched':matched}
+    return result
+
