# ============================================================================
# MedDoc Pro — .env.example template
# ----------------------------------------------------------------------------
# This is a SHORT placeholder template focused on values added by HIPAA
# remediation work. The full production template (with every required
# variable + tuning knob) lives at .env.production.example — copy that file
# to /opt/meddoc-pro/.env on first deploy.
#
# After populating real values, lock the file down:
#   chmod 600 .env
#
# NEVER commit a populated .env. The .gitignore covers .env* but double-check.
# ============================================================================


# ============================================================================
# h16-offsite-backup (encrypted variant) — Backblaze B2
# ----------------------------------------------------------------------------
# These three vars are read by infra/backup-offsite-sync.sh which runs as
# the postgres-backup sidecar's POST_BACKUP_COMMAND. The script encrypts
# each pg_dump with `age` (using a host-resident keypair under /etc/meddoc)
# before uploading.
#
# Population is GATED on signing a Business Associate Agreement (BAA) with
# Backblaze — DO NOT populate before then. See docs/RUNBOOK_OFFSITE_BACKUP.md
# section A for the BAA + bucket-creation flow.
#
# When unset, the sync script exits 78 (EX_CONFIG) and the local pg_dump
# path runs unaffected — safe state.
# ============================================================================

# [REQUIRED-AFTER-BAA] Application key ID from B2 console. Created with
# capabilities: writeFiles + readFiles + listBuckets. Scope to the bucket
# below, not "all buckets".
BACKBLAZE_KEY_ID=<populate-after-BAA-with-Backblaze>

# [REQUIRED-AFTER-BAA] Secret half of the application key. Visible only at
# creation time — record it in your secret store before clicking away.
BACKBLAZE_APPLICATION_KEY=<populate-after-BAA-with-Backblaze>

# [REQUIRED-AFTER-BAA] Bucket name. Must be unique across B2 globally.
# Recommended: meddoc-offsite-backups-prod (per account naming convention).
BACKBLAZE_BUCKET=meddoc-offsite-backups-prod
