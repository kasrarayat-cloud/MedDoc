# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but track the placeholder-only example file so new env vars travel
# with the repo (M7 — was on-VPS-only through M2-M6). Contents MUST stay
# placeholder; never commit real values.
!.env.production.example
# h16-offsite-backup template (placeholder values only — never real creds).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright / test artifacts
playwright-report/
test-results/

# local tool state
/venv/
.claude/settings.local.json

# QA Interaction Auditor — seeded test-user/patient ids are written here
# on each seed-qa-user.ts run. Per-environment, may contain dev DB ids;
# never committed.
.claude/agents/qa-interaction-auditor/fixtures/seeded-ids.json

# On-VPS snapshot copies kept next to the live config for quick rollback
# (Caddyfile.backup, docker-compose.yml.backup). Host-only — do not commit.
*.backup

# pg_dump snapshots taken before schema migrations. Contains live PHI
# and production user data — MUST NOT be committed under any circumstances.
backups/

# Deploy logs are RETAINED ON DISK deliberately (scripts/deploy-prod.sh writes
# the full transcript there, never piped through `tail`) but are not versioned:
# they are an operational record of one host, not source. See runbook §2.
docs/deploy-logs/
.design-preview-phase-6.html

# Phase 5 exploration dead-ends (kept on disk for reference, not in repo).
# v5 = abandoned dark explorations; v6 = abandoned cinematic studio with 100MB+
# of gpt-image-1 background renders. Only v7-dashboard and v8-linear were
# chosen to inform Phase 5 implementation.
docs/design-directions-v5/
docs/design-directions-v6/

# qa-bug-hunter audio fixtures — synthesized at skill-run time
# (~21 MB total, regenerated on demand from the skill spec).
tests/fixtures/audio/

# Phase 6.1 (h8) — host-only encryption-at-rest artifacts. Contains the
# LUKS-encrypted postgres data file (1+ GB sparse). MUST NOT be committed
# even though encrypted at rest — git history would balloon and the file
# is per-host anyway (each VPS has its own keyfile + sparse file).
secrets/

# Local rollback snapshots taken before risky compose changes.
docker-compose.yml.pre-*
qa-sweep-*/test-account.txt

# E2E smoke test session cookies (regenerable; sensitive — Auth.js JWT).
docs/smoke-test-*/test-data/session-storage.json

# Design-review preview assets — bulky binary snapshots stay host-side.
# The HTML mockups + tokens reference under _design-references/ ARE
# tracked (text, ~470KB total, cited by .claude/agents/code-quality-
# auditor/rules.md TOKEN-002 as the banned-value provenance source).
# The marketing snapshot zip is a one-shot capture; regenerate from
# Phase 5 source on demand instead of carrying the binary in git.
# processing-mockups.html is a Round-1 artifact still using the banned
# palette (#050607 + #9eb5a0 + Lora) — kept on disk for historical
# context, never committed.
_design-references/*.zip
_design-references/quillmd-processing-mockups.html

# Host-only third-party eval datasets — never committed even when not
# bound by a DUA. The PriMock57 corpus
# (github.com/babylonhealth/primock57) lives under
# `.local/datasets/primock57/` after the clone documented in
# `apps/transcribe-md/scripts/eval/primock57-run.ts`. Local-only; eval
# scripts read from this path but never write to it.
.local/

# ── Pre-pilot hygiene sweep (2026-06-11, chore/pre-pilot-hygiene) ──
# Playwright MCP page snapshots — transient per-run tool artifacts.
.playwright-mcp/

# Bulky design-exploration / landing render dirs: image-heavy (PNG renders),
# 0 tracked precedent, host-side reference only — same class as the
# already-ignored design-directions-v5/v6 above. Kept on disk, never committed.
docs/design-directions-v3-landing/
docs/design-directions-v4-landing/
docs/design-directions-v5-designer/
docs/design-directions-v9-note-format/
docs/landing-immersive-enhance/
docs/landing-v6-migration/screenshots/

# Authenticated QA sweeps — carry test-account credential traces
# (stage2-signup-trace.json / verify-bypass-trace.json) + bulky screenshots.
# Host-side only; the markdown audit trail lives under docs/qa-reports/.
docs/qa-sweep-2026-05-03/
docs/qa-sweep-authenticated-2026-05-03/

# Co-tenant Caddyfile backup snapshot (LeatherERP host config) — host-only.
Caddyfile.bak-T0.19-followup

# Synthetic prod-smoke credentials (generated by scripts/prod-smoke/provision.ts)
.smoke-account.env

# Clinical diagnostic artifacts from local investigation. These are FILLED
# documents and notes — they carry PHI, and version control is the one place
# from which it cannot be withdrawn. Never commit them.
/twin-*.docx
/diag-*.json
/diag-*.txt
/dom-flag-off.txt
/*.docx
apps/transcribe-md/dp-*.png
# Walk screenshots written into the app tree by ad-hoc specs.
apps/transcribe-md/s1-*.png
apps/transcribe-md/p2-*.png
apps/transcribe-md/chat-*.png
# Never a secret in a compose override. The QA stack already reads
# ANTHROPIC_API_KEY from the shell (docker-compose.qa.yml); there is no reason
# for a key to be written to a file in the repo at all.
docker-compose.*key*.yml
